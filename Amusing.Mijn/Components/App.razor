@using Amusing.Mijn.Services
@inject SiteLanguage SiteLanguage
<!DOCTYPE html>
<html lang="@language">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Amusing.Mijn.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["password-toggle.js"]"></script>
    <script src="@Assets["choir-file.js"]"></script>
    <script src="@Assets["support-grid.js"]"></script>
</body>

</html>

@code {
    private string language = "nl";
    protected override async Task OnInitializedAsync() => language = await SiteLanguage.GetAsync();
}
