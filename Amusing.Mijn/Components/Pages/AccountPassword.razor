@page "/account/wachtwoord-vergeten"
@page "/account/wachtwoord-instellen"
@page "/account/wachtwoord-wijzigen"
@using System.Security.Claims
@using Amusing.Mijn.Services
@inject NavigationManager Navigation
@inject IHttpContextAccessor Context
@inject IConfiguration Configuration
@inject SiteLanguage SiteLanguage
@using Amusing.Mijn.Components

<PageTitle>@Title — Mijn Amusing</PageTitle>
<section class="card sign-in-card account-page" lang="@language">
@if (Change) { <a href="/">← @T("MijnKoren")</a> }
<h1>@Title</h1>
@if (Status == "ontvangen")
{
    <p role="status">@T("AlsErEenAccountVoorDitAdres")</p>
}
else if (Reset && !AccountPasswords.ValidToken(Token ?? ""))
{
    <p role="alert">@T("DezeLinkIsOngeldigVerlopenOfAl")</p>
    <a href="@ForgotUrl">@T("NieuweLinkAanvragen")</a>
}
else if (Change && Context.HttpContext?.User.FindFirstValue("actor_type") != "choir_person")
{
    <p><a href="/account/login">@T("LogInMetJeKooraccount")</a>@T("OmJeWachtwoordTeWijzigen")</p>
}
else if (!Change && !Configuration.GetValue<bool>("AccountPasswords:ResetEnabled"))
{
    <p>@T("WachtwoordherstelIsMomenteelNietBeschikbaar")</p>
}
else
{
    @if (Status == "ongeldig")
    {
        <p role="alert">@T("ControleerDeIngevuldeGegevensEnProbeerOpnieuw")</p>
    }
    <form method="post" action="@Action" data-enhance="false">
        <AntiforgeryToken />
        @if (Beheer == "1")
        {
            <input type="hidden" name="beheer" value="1" />
            @if (!Reset)
            {
                <label for="username">@T("Gebruikersnaam")</label>
                <input id="username" name="username" maxlength="100" autocomplete="username" required />
            }
        }
        @if (!Change && !Reset)
        {
            <label for="email">@T("Emailadres")</label>
            <input id="email" name="email" type="email" maxlength="80" autocomplete="email" required />
            <button type="submit">@T("StuurEenHerstellink")</button>
        }
        else
        {
            @if (Reset) { <input type="hidden" name="token" value="@Token" /> }
            @if (Change)
            {
                <LoginPassword FieldName="current" Label="@T("HuidigWachtwoord")" ShowLabel="@ShowLabel" HideLabel="@HideLabel" />
            }
            <LoginPassword Label="@T("NieuwWachtwoord")" Autocomplete="new-password" MinLength="12" ShowLabel="@ShowLabel" HideLabel="@HideLabel" />
            <LoginPassword FieldName="repeat" Label="@T("HerhaalNieuwWachtwoord")" Autocomplete="new-password" MinLength="12" ShowLabel="@ShowLabel" HideLabel="@HideLabel" />
            <p>@T("KiesMinstens12Tekens")</p>
            <button type="submit">@T("WachtwoordOpslaan")</button>
        }
    </form>
}
@if (!Change) { <p><a href="@(Beheer == "1" ? "/account/beheer" : "/account/login")">@T("Terug")</a></p> }
</section>

@code {
    private string language = "nl";
    private string T(string key) => Amusing.Mijn.Services.UiText.Get(key, language);
    private string ShowLabel => T("WachtwoordTonen");
    private string HideLabel => T("WachtwoordVerbergen");

    protected override async Task OnParametersSetAsync() => language = await SiteLanguage.GetAsync();
    [SupplyParameterFromQuery] public string? Status { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    [SupplyParameterFromQuery] public string? Beheer { get; set; }
    private string ForgotUrl => "/account/wachtwoord-vergeten" + (Beheer == "1" ? "?beheer=1" : "");
    private string Path => Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.TrimEnd('/');
    private bool Change => Path == "/account/wachtwoord-wijzigen";
    private bool Reset => Path == "/account/wachtwoord-instellen";
    private string Title => Change ? T("WachtwoordWijzigen") : Reset ? T("NieuwWachtwoordInstellen") : T("WachtwoordVergeten");
    private string Action => "/account/wachtwoord/" + (Change ? "wijzigen" : Reset ? "instellen" : "aanvragen");
}
