@page "/account/login"
<PageTitle>Inloggen — Mijn Amusing</PageTitle>
<section class="card">
<p class="eyebrow">Welkom bij Mijn Amusing</p>
<h1>Alles voor jouw koor</h1>
<p>Log in met je bestaande kooraccount.</p>
@if (Failed is not null) { <p role="alert" class="error">Inloggen is niet gelukt. Controleer je e-mailadres en wachtwoord.</p> }
<form method="post" action="/account/sign-in" data-enhance="false">
    <AntiforgeryToken />
    <label for="email">E-mailadres</label><input id="email" name="email" type="email" autocomplete="username" maxlength="80" required />
    <label for="password">Wachtwoord</label><input id="password" name="password" type="password" autocomplete="current-password" required />
    <button type="submit">Inloggen</button>
</form>
</section>
@code { [SupplyParameterFromQuery(Name="failed")] public string? Failed { get; set; } }
