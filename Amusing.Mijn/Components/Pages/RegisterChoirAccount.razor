@page "/account/registreren"
@inject IConfiguration Configuration
<PageTitle>Account aanmaken — Mijn Amusing</PageTitle>
<h1>Account aanmaken</h1>
@if (!Configuration.GetValue<bool>("AccountRegistration:Enabled"))
{
    <p>Registreren is momenteel niet beschikbaar.</p>
}
else if (Status == "ontvangen")
{
    <p role="status">De activatielink is verstuurd. Controleer ook je ongewenste mail. De link is 24 uur geldig.</p>
}
else
{
    @if (Status == "ongeldig") { <p role="alert">Controleer je naam en e-mailadres.</p> }
    @if (Status == "mailfout") { <p role="alert">De activatielink kon niet worden verstuurd. Probeer het later opnieuw of neem contact op met de organisatie.</p> }
    @if (Status == "nietbeschikbaar") { <p role="alert">Voor dit e-mailadres kan geen nieuw account worden aangemaakt. Probeer in te loggen of kies <a href="/account/wachtwoord-vergeten">Wachtwoord vergeten</a>. Lukt dat niet, neem dan contact op met de organisatie.</p> }
    <form method="post" action="/account/registratie-aanvragen" data-enhance="false" class="profile-card">
        <AntiforgeryToken />
        <label for="first">Voornaam</label><input id="first" name="first" maxlength="40" autocomplete="given-name" required />
        <label for="last">Achternaam</label><input id="last" name="last" maxlength="50" autocomplete="family-name" required />
        <label for="email">E-mailadres</label><input id="email" name="email" type="email" maxlength="80" autocomplete="email" required />
        <button>Stuur een activatielink</button>
    </form>
}
<p><a href="/account/login">Terug naar inloggen</a></p>
@code {
    [SupplyParameterFromQuery] public string? Status { get; set; }
}
