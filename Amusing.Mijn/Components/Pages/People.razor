@page "/koor/{Id:long}/personen"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Security.Claims
@using Amusing.Mijn.Services
@inject ChoirPeople Service
@inject IHttpContextAccessor Context
@inject IConfiguration Configuration
<PageTitle>Personen en rollen — Mijn Amusing</PageTitle>
@if(roster is null){<h1>Koor niet beschikbaar</h1><p>Dit koor is niet aan je account gekoppeld.</p>}
else
{
    <a href="/koor/@Id">← Koorprofiel</a><h1>Personen bij @roster.Name</h1>
    @if(Status is not null)
    {
        <p role="status" class="@(Status is "invited" or "removed"?"success":"error")">@(Status switch {
            "invited"=>"Als dit e-mailadres een actief account heeft, staat er een uitnodiging klaar. De persoon moet de rol eerst zelf aannemen.",
            "removed"=>"De rol is verwijderd.",
            "last"=>"Er moet altijd een eerste contactpersoon blijven. Laat eerst iemand anders die rol aannemen.",
            _=>"Controleer het e-mailadres en kies een geldige rol."})</p>
    }
    @foreach(var person in roster.People)
    {
        <section class="profile-card person-card">
            <h2>@person.Name</h2>
            @if(person.Email is not null)
            {
                <dl><dt>E-mailadres</dt><dd>@person.Email</dd><dt>Telefoon</dt><dd>@(string.IsNullOrEmpty(person.Phone)?"Niet ingevuld":person.Phone)</dd><dt>Mobiel</dt><dd>@(string.IsNullOrEmpty(person.Mobile)?"Niet ingevuld":person.Mobile)</dd></dl>
            }
            <ul>@foreach(var role in person.Roles)
            {
                <li><span>@ChoirPeople.Roles.GetValueOrDefault(role,role)</span>
                @if(roster.CanManage)
                {
                    <form class="role-action" method="post" action="/koor/@Id/personen/verwijderen" data-enhance="false">
                        <AntiforgeryToken/><input type="hidden" name="person" value="@person.Id"/><input type="hidden" name="role" value="@role"/>
                        <button class="secondary" aria-label="@($"Rol {ChoirPeople.Roles.GetValueOrDefault(role,role)} verwijderen bij {person.Name}")">Rol verwijderen</button>
                    </form>
                }
                </li>
            }</ul>
        </section>
    }
    @if(roster.CanManage && Configuration.GetValue<bool>("Mijn:IsTestEnvironment"))
    {
        <section class="profile-card person-card"><h2>Persoon uitnodigen</h2>
        <p>Gebruik het e-mailadres van een bestaand actief account. In deze testomgeving ontvangt de persoon de uitnodiging op de pagina <strong>Mijn uitnodigingen</strong>. Er wordt geen e-mail verstuurd.</p>
        <form method="post" action="/koor/@Id/personen/uitnodigen" data-enhance="false">
            <AntiforgeryToken/>
            <label for="invite-email">E-mailadres</label><input id="invite-email" name="email" type="email" maxlength="80" required/>
            <label for="invite-role">Rol</label><select id="invite-role" name="role" required><option value="">Kies een rol</option>@foreach(var role in ChoirPeople.Roles){<option value="@role.Key">@role.Value</option>}</select>
            <button>Uitnodiging klaarzetten</button>
        </form></section>
    }
    else if(!roster.CanManage){<p>Alleen een eerste contactpersoon kan personen uitnodigen en rollen verwijderen.</p>}
}
@code{
    [Parameter] public long Id{get;set;}
    [SupplyParameterFromQuery(Name="status")] public string? Status{get;set;}
    private ChoirRoster? roster;
    protected override async Task OnParametersSetAsync()=>roster=await Service.RosterAsync(uint.Parse(Context.HttpContext!.User.FindFirstValue(ClaimTypes.NameIdentifier)!),Id>0 && Id<=uint.MaxValue?(uint)Id:0,Context.HttpContext.RequestAborted);
}
