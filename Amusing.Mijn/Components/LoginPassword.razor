<label for="@FieldName">@Label</label>
<div class="login-password">
    <input id="@FieldName" name="@FieldName" type="password" autocomplete="@Autocomplete" minlength="@MinLength" required />
    <button type="button" class="secondary" data-password-toggle aria-controls="@FieldName" aria-pressed="false" aria-label="@ShowLabel" data-show-label="@ShowLabel" data-hide-label="@HideLabel">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z" />
            <circle cx="12" cy="12" r="3" />
        </svg>
    </button>
</div>


@code {
    [Parameter] public string FieldName { get; set; } = "password";
    [Parameter] public string Label { get; set; } = "Wachtwoord";
    [Parameter] public string Autocomplete { get; set; } = "current-password";
    [Parameter] public int? MinLength { get; set; }
    [Parameter] public string ShowLabel { get; set; } = "Wachtwoord tonen";
    [Parameter] public string HideLabel { get; set; } = "Wachtwoord verbergen";
}
