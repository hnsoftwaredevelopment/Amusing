@using Amusing.Services
@inject BeheerPasswordRecoveryService Recovery
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!doctype html>
<html lang="nl"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="referrer" content="no-referrer" /><title>@ViewData["Title"] — Beheer Amusing</title><link rel="stylesheet" href="/bootstrap/bootstrap.min.css" /><link rel="stylesheet" href="/css/password-recovery.css" asp-append-version="true" /></head>
<body><header class="recovery-header @(Recovery.IsTest?"recovery-header-test":"")"><a href="/login">Beheer Amusing Hengelo</a>@if(Recovery.IsTest){<strong>TESTOMGEVING</strong>}</header><main class="recovery-card">@RenderBody()</main><script src="/js/password-recovery.js" asp-append-version="true"></script></body></html>
