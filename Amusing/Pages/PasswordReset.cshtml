@page "/wachtwoord-instellen"
@model Amusing.Pages.PasswordResetModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{Layout="_RecoveryLayout";ViewData["Title"]="Nieuw wachtwoord instellen";}
<h1>Nieuw wachtwoord instellen</h1>
@if(!Model.Enabled){<p>Wachtwoordherstel is momenteel niet beschikbaar.</p>}
else
{
 @if(Model.Error is not null){<p role="alert" class="recovery-error">@Model.Error</p>}
 <p data-recovery-missing hidden="@Model.ShowForm">Open de volledige herstellink uit uw mail om een nieuw wachtwoord in te stellen.</p>
 <div data-recovery-form hidden="@(!Model.ShowForm)">
  <form method="post" asp-antiforgery="true">
   <input type="hidden" name="Token" value="@Model.Token" data-recovery-token />
   <label for="Password">Nieuw wachtwoord</label>
   <div class="recovery-password"><input id="Password" name="Password" type="password" autocomplete="new-password" minlength="12" maxlength="72" required /><button type="button" data-recovery-toggle aria-controls="Password" aria-pressed="false" aria-label="Wachtwoord tonen"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button></div>
   <label for="Repeat">Herhaal het nieuwe wachtwoord</label>
   <div class="recovery-password"><input id="Repeat" name="Repeat" type="password" autocomplete="new-password" minlength="12" maxlength="72" required /><button type="button" data-recovery-toggle aria-controls="Repeat" aria-pressed="false" aria-label="Wachtwoord tonen"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button></div>
   <p>Kies minstens 12 tekens.</p><button type="submit">Wachtwoord opslaan</button>
  </form>
 </div>
 <p><a href="/wachtwoord-vergeten">Nieuwe herstellink aanvragen</a></p>
}
<p><a href="/login">Terug naar inloggen</a></p>
