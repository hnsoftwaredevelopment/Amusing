@page "/wachtwoord-vergeten"
@model Amusing.Pages.PasswordForgotModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ Layout="_RecoveryLayout";ViewData["Title"]="Wachtwoord vergeten"; }
<h1>Wachtwoord vergeten</h1>
@if(!Model.Enabled){<p>Wachtwoordherstel is momenteel niet beschikbaar. Neem contact op met de beheerder.</p>}
else if(Model.Sent){<p role="status">Als de combinatie van gebruikersnaam en hersteladres klopt, ontvangt u een herstellink. Geen mail ontvangen? Controleer uw spammap en probeer opnieuw. Gebruik het hersteladres dat bij uw Beheeraccount is vastgelegd. Neem bij twijfel contact op met de beheerder.</p>}
else
{
 <p>Vul uw gebruikersnaam en het privéhersteladres van uw Beheeraccount in.</p>
 @if(Model.Error is not null){<p role="alert" class="recovery-error">@Model.Error</p>}
 <form method="post" asp-antiforgery="true" novalidate>
  <label for="Username">Gebruikersnaam</label><input asp-for="Username" maxlength="100" autocomplete="username" required />
  <label for="Email">Privéhersteladres</label><input asp-for="Email" type="email" maxlength="80" autocomplete="email" required />
  <button type="submit">Stuur een herstellink</button>
 </form>
}
<p><a href="/login">Terug naar inloggen</a></p>
