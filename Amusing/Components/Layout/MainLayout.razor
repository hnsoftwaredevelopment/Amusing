@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Amusing.Components.Shared

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="main-content">
        <article class="content px-4">
            @Body
