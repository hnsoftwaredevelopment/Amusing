@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@using Amusing.Components.Shared

<div class="page">
    <div class="@SidebarCssClass">
        @if ( ShowEnvironmentMarker )
        {
            <div class="environment-badge" aria-label="@EnvironmentBadgeLabel">
                @EnvironmentBadgeLabel
            </div>
        }
        <NavMenu />
    </div>

    <main class="main-content">
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
<ToastHost />
<div id="blazor-error-ui">
    Er is een onverwachte fout opgetreden.
    <a href="" class="reload">Opnieuw laden</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private string? EnvironmentName => Configuration["Amusing:EnvironmentName"];

    private bool ShowEnvironmentMarker =>
        !string.IsNullOrWhiteSpace( EnvironmentName )
        && !string.Equals( EnvironmentName, "Production", StringComparison.OrdinalIgnoreCase );

    private string SidebarCssClass => ShowEnvironmentMarker
        ? "sidebar sidebar-test"
        : "sidebar";

    private string EnvironmentBadgeLabel => string.Equals( EnvironmentName, "Test", StringComparison.OrdinalIgnoreCase )
        ? "TESTOMGEVING"
        : EnvironmentName?.ToUpperInvariant() ?? string.Empty;
}
