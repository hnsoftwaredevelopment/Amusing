@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
    private Dictionary<string, bool> subMenuStates = new();

    private void ToggleSubMenu( string key )
    {
        subMenuStates [ key ] = !subMenuStates.GetValueOrDefault( key );
    }

    private bool IsSubMenuOpen( string key ) => subMenuStates.GetValueOrDefault( key );
}