@page "/Maintenance-Groups"
@using Amusing.Models
@using Amusing.Services
@using Bit.BlazorUI
@using Bit.BlazorUI.Extras
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@using System.ComponentModel.DataAnnotations
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.RichTextEditor
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.SplitButtons

@inject NavigationManager NavManager
@inject IJSRuntime JS

@if (IsLoading)
{
    <div class="text-center p-2">
        <SfSpinner CssClass="e-spin-center" />
        <p>@FileName worden geladen...</p>
    </div>
}
else
{
    <div class="page-container maintenance-page">
        <div class="fixed-header maintenance-page__header">
            <h3>Onderhoud @FileName</h3>
            <SfTab @ref="GroupTab" @bind-SelectedItem="currentTabIndex">
                <TabEvents Selected="OnTabSelected"/>
                <TabItems>
                    <!-- Group detail -->
                    <TabItem>
                        <ChildContent>
                            <TabHeader Text="Groep"></TabHeader>
                        </ChildContent>
                        <ContentTemplate>
                            <div class="koor-details-container">
                                <!-- Left column: form fields -->
                                <div class="form-row">
                                    <SfTextBox Placeholder="Naam" FloatLabelType="FloatLabelType.Always" Width="45%" @bind-Value="SelectedGroupName" />
                                    <SfTextBox Placeholder="Standplaats" FloatLabelType="FloatLabelType.Always" Width="25%" @bind-Value="SelectedGroupCity"/>
                                    <SfComboBox TValue="string" TItem="CountryModel" FloatLabelType="FloatLabelType.Always"
                                                Placeholder="Land" DataSource="@Countries" Width="20%" @bind-Value="SelectedGroupCountry" >
                                        <ComboBoxFieldSettings Value="CountryId" Text="Country"></ComboBoxFieldSettings>
                                    </SfComboBox>
                                </div>

                                <div class="form-row">
                                    <div class="sf-float-group">
                                        <label class="sf-float-label" for="rteBeschrijving">Beschrijving</label>
                                        <SfRichTextEditor ID="rteBeschrijving" Width="100%" Placeholder="Beschrijving" Height="180px" @bind-Value="SelectedGroupDescription">
                                            <RichTextEditorToolbarSettings Items="@Tools" />
                                        </SfRichTextEditor>
                                    </div>
                                </div>

                                <div class="form-row">
                                    <SfComboBox TValue="uint" TItem="GenreModel" FloatLabelType="FloatLabelType.Always"
                                                Placeholder="Genre" DataSource="@Genres" Width="45%" @bind-Value="SelectedGroupGenreId" >
                                        <ComboBoxFieldSettings Value="GenreId" Text="Nl"></ComboBoxFieldSettings>
                                    </SfComboBox>
                                    <SfTextBox Placeholder="Rekeningnummer" FloatLabelType="FloatLabelType.Always" Width="25%" @bind-Value="SelectedGroupBankAccount" />
                                </div>

                                <div class="form-row">
                                    <SfTextBox Placeholder="Website" FloatLabelType="FloatLabelType.Always" Width="45%" @bind-Value="SelectedGroupWebsite" />
                                    <SfTextBox Placeholder="E-Mail" FloatLabelType="FloatLabelType.Always" Width="45%" @bind-Value="SelectedGroupEmail" />
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>
                    
                    <!-- Images -->
                    <TabItem>
                        <ChildContent>
                            <TabHeader Text="Logo/foto"></TabHeader>
                        </ChildContent>
                        <ContentTemplate>
                            <div class="dropzone-grid">
                                <div class="drop-zone" Width="150px">
                                    <h4>Logo</h4>
                                    @if ( !string.IsNullOrEmpty( LogoUploadErrorMessage ) )
                                    {
                                        <div class="text-danger">@LogoUploadErrorMessage</div>
                                    }

                                    @if ( !string.IsNullOrEmpty( LogoPreview ) )
                                    {
                                        <img src="@LogoPreview" style="max-height:80px;" />
                                    }

                                    <InputFile class="drop-input"
                                               OnChange="@(e => OnImageSelected(e, true))"
                                               accept=".png,.jpg,.jpeg" />

                                    <div class="custom-upload-btn">📁 Selecteer afbeelding</div>

                                    <div class="drop-hint">Klik of sleep het logo hierheen</div>
                                </div>

                                <div class="drop-zone" Width="200px">
                                    <h4>Koorfoto</h4>
                                    @if (!string.IsNullOrEmpty(PhotoUploadErrorMessage))
                                    {
                                        <div class="text-danger">@PhotoUploadErrorMessage</div>
                                    }

                                    @if ( !string.IsNullOrEmpty( PhotoPreview ) )
                                    {
                                        <img src="@PhotoPreview" alt="Preview" class="preview-img" />
                                    }

                                    <InputFile class="drop-input"
                                               OnChange="@(e => OnImageSelected(e, false))"
                                               accept=".png,.jpg,.jpeg" />

                                    <div class="custom-upload-btn">📁 Selecteer afbeelding</div>

                                    <div class="drop-hint">Klik of sleep de foto hierheen</div>
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <!-- People -->
                    <TabItem Disabled="@(!IsPersonsTabEnabled)">
                        <ChildContent>
                            <TabHeader Text="Personen"></TabHeader>
                        </ChildContent>
                        <ContentTemplate>
                            <div class="persons-layout">
                                <!-- Active persons for the selected choir -->
                                <div class="persons-col">
                                    <label class="persons-grid-label">Actieve personen</label>
                                    <SfGrid @ref="ActivePersonGridRef" 
                                            DataSource="@ActivePersonsList" 
                                            ContextMenuItems="@ActivePersonsContextMenuItems" 
                                            AllowSorting="true" 
                                            AllowSelection="true"
                                            Height="250px">
                                        <GridEvents TValue="PersonModel"
                                                    DataBound="OnActivePersonsDataBound"
                                                    ContextMenuItemClicked="OnContextMenuClickActivePerson" />
                                        <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Single" 
                                                               Mode="Syncfusion.Blazor.Grids.SelectionMode.Row" />
                                        <GridColumns>
                                            <GridColumn Field="Name" HeaderText="Naam" Width="60px"/>
                                            <GridColumn Field="Email" HeaderText="E-Mail" Width="80px" />
                                            <GridColumn Field="Role" HeaderText="Rol" Width="60px" />
                                        </GridColumns>
                                    </SfGrid>
                                </div>

                                <!-- Available persons to perform a role for the selected choir -->
                                <div class="persons-col">
                                    <label class="persons-grid-label">Beschikbare personen</label>
                                    <SfGrid ID="UnrelatedPersonsGrid" 
                                            @ref="UnrelatedPersonGridRef" 
                                            DataSource="@UnrelatedPersonsList" 
                                            ContextMenuItems="@UnrelatedPersonsContextMenuItems" 
                                            AllowSorting="true" 
                                            AllowSelection="true"
                                            Height="250px">
                                        <GridEvents TValue="PersonModel"
                                                    DataBound="OnUnrelatedPersonsDataBound"
                                                    ContextMenuItemClicked="OnContextMenuClickUnrelatedPerson" />
                                        <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Single"
                                                               Mode="Syncfusion.Blazor.Grids.SelectionMode.Row" />
                                        <GridColumns>
                                            <GridColumn Field="Name" HeaderText="Naam" Width="150px" />
                                            <GridColumn Field="Email" HeaderText="E-Mail" Width="150px" />
                                            <GridColumn Field="GroupName" HeaderText="Koor" Width="250px" />
                                        </GridColumns>
                                    </SfGrid>
                                </div>

                                <div class="persons-col">
                                    <label class="persons-grid-label">Zoek persoon</label>
                                    <SfToolbar Width="175px">
                                        <ToolbarItems>
                                            <ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
                                                <Template>
                                                    <SfTextBox Placeholder="Zoek persoon" Input="OnPersonInput"></SfTextBox>
                                                </Template>
                                            </ToolbarItem>
                                        </ToolbarItems>
                                    </SfToolbar>
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>
                </TabItems>
            </SfTab>

            <div class="spacer-small" />

            <!-- Toolbar -->
            <div class="maintenance-toolbar-shell">
                <SfToolbar Width="800px">
                    <ToolbarItems>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn"
                                        @onclick="SaveGroup"
                                        title="Sla het podium op">
                                    <img src="icons/button-save.svg" class="icon" alt="SAVE" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn" @onclick="AddNewGroup" title="Voeg een nieuw podium toe">
                                    <img src="icons/button-add.svg" class="icon" alt="ADD" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn @(!IsPersonsTabEnabled ? "disabled" : "")"
                                        @onclick="DeleteGroup"
                                        title="Verwijder geselecteerde podium"
                                        disabled="@(!IsPersonsTabEnabled)">
                                    <img src="icons/button-del.svg" class="icon" alt="DEL" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
                            <Template>
                                <span class="toolbar-count">@FileName: @VisibleRowCount</span>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
                            <Template>
                                <SfTextBox Placeholder="Zoek" Input="OnInput"></SfTextBox>
                            </Template>
                        </ToolbarItem>
                    </ToolbarItems>
                </SfToolbar>
            </div>
        </div>

        <div class="scrollable-content maintenance-page__content">
            <div class="spacer-small"></div>
            <div class="maintenance-grid-shell maintenance-grid-shell--fit">
                <SfGrid @ref="GridRef"
                    TValue="GroupModel"
                    DataSource="@Groups" 
                    EnableStickyHeader="true"
                    CssClass="maintenance-grid"
                    AllowResizing="true" 
                    Height="100%"
                    Width="800px" 
                    AllowSorting="true" 
                    AllowMultiSorting="true"
                    AllowSelection="true">
                    <GridEvents TValue="GroupModel" DataBound="OnGridDataBound" RowSelected="OnRowSelected" />
                    <GridEditSettings AllowAdding="true" NewRowPosition="NewRowPosition.Top"></GridEditSettings>
                    <GridColumns>
                        <GridColumn Field="GroupId" IsPrimaryKey="true" Visible="false"/>
                        <GridColumn Field="Name" HeaderText="Naam" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="350px" />
                        <GridColumn Field="City" HeaderText="Standplaats" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="100px" />
                        <GridColumn Field="Country" HeaderText="Land" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="90px" />
                        <GridColumn Field="Genre" HeaderText="Genre" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="100px" />
                    </GridColumns>
                </SfGrid>
            </div>
        </div>
    </div>
}
