@page "/Planning-Overview"
@using Amusing.Models
@using Amusing.Services
@using Blazorise
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@using System.ComponentModel.DataAnnotations
@using Syncfusion.Blazor.Notifications
@using Syncfusion.Blazor.PivotView

<AuthorizeView>
	<Authorized>
		<div class="overview-grid">
			<div class="row row1">
				<h3>
					Podiumplanning
					@if ( !string.IsNullOrWhiteSpace( SelectedEditionId ) )
					{
						<span class="edition-label">@SelectedEditionText</span>
					}
				</h3>
			</div>

			<div class="row row2">
				<div class="col left toolbar">

					<SfComboBox class="sf-combobox" TValue="string"
								TItem="Edition"
								Placeholder="Kies een editie"
								ValueChanged="OnEditionChanged"
								DataSource="@Editions"
								Width="175px">
						<ComboBoxFieldSettings Value="ID" Text="Text"></ComboBoxFieldSettings>
					</SfComboBox>

					<button class="xml-btn @(string.IsNullOrWhiteSpace(SelectedEdition) ? "hidden" : "")"
							@onclick="ExportToExcelAsync"
							title="Excel Export">
						<img src="icons/excel.svg" class="icon" alt="Excel" />
					</button>

					<button class="xml-btn @(string.IsNullOrWhiteSpace(SelectedEdition) ? "hidden" : "")"
							@onclick="ExportToXmlAsync"
							title="XML Export">
						<img src="icons/xml.svg" class="icon" alt="XML" />
					</button>
				</div>
			</div>
			<SfToast @ref="ToastObj"
					 TimeOut="3000"
					 ShowCloseButton="true"
					 NewestOnTop="true">
				<ToastPosition X="Center" Y="Top" />
				<ToastEvents Closed="@OnToastClose"></ToastEvents>
			</SfToast>


			<div class="row row3">
				<div class="col left">
					@if ( SelectedEditionId != null )
					{
						<div class="conditions-container">
							<div class="title">Voorwaarden</div>
							<div class="conditions-wrapper">
								<button class="btn-edit"
										@onclick="ToggleEditConditions"
										title="@(IsEditingConditions
											? "Gewijzigde voorwaarden bewaren"
											: "Voorwaarden bewerken")">

									<img src="@(IsEditingConditions ? "icons/button-save.svg" : "icons/button-edit.svg")"
										 class="edit-icon" />
								</button>

								<div class="conditions-editor">
									<div class="row">
										<label>Gewenste tijd tussen optredens</label>
										<input type="number" width="50"
												@bind="WishTimeBetweenPerformances"
												disabled="@( !IsEditingConditions )" />
									</div>

									<div class="row">
										<label>Maximale tijd tussen optredens</label>
										<input type="number" width="50"
												@bind="MaxTimeBetweenPerformances"
												disabled="@( !IsEditingConditions )" />
									</div>

									<div class="row">
											<label>Maximale lengte vrijwilligers dienst</label>
											<input type="number"
												   @bind="MaxLentgVolunteersShift"
												   disabled="@( !IsEditingConditions )" />
										</div>

									<div class="row">
										<label>Boete bij onderbreking</label>
										<input type="number"
											   @bind="PenaltyInteruptionPerformances"
											   disabled="@( !IsEditingConditions )" />
									</div>

									<div class="row">
										<label>Taken zonder wisseltijd</label>
										<input type="text"
											   @bind="TasknamesWithoutSwitchTime"
											   disabled = "disabled" />
									</div>

									<div class="row">
										<label>Reserve taaknaam</label>
										<input type="text"
												   @bind="SubstitudeTaskName"
												   disabled="disabled" />
									</div>

									<div class="row">
										<label>Duur optreden (min)</label>
										<input type="number"
											   @bind="PerformanceTime"
											   disabled="@( !IsEditingConditions )" />
									</div>
								</div>
							</div>
						</div>
					}
				</div>
			</div>

			<div class="row row4">
				@if ( !string.IsNullOrWhiteSpace( SelectedEditionId ) )
				{
					<div class="schedule-grid scroll-container">
						<div class="title">Podiumplanning</div>
						<SfGrid
							DataSource="@StageRows"
							AllowSorting="false"
							AllowFiltering="false"
							AllowPaging="false"
							GridLines="GridLine.Both"
							Width="100%">
							<GridColumns>
								<GridColumn Field="SortOrder"
											HeaderText="Nr"
											Width="50"
											TextAlign="TextAlign.Right"
											IsFrozen="true">

									<Template Context="rowObj">
										@{
											var row = rowObj as StageScheduleRow;
										}
										<div style="font-weight:bold;" title="@row?.SortOrder">
											@row?.SortOrder
										</div>
									</Template>

									<HeaderTemplate Context="headerRow">
										<div style="font-weight:bold;">Nr</div>
									</HeaderTemplate>
								</GridColumn>

								<GridColumn
									Field="StageName"
									HeaderText="Podium"
									Width="350"
									IsFrozen="true">
									<Template Context="rowObj">
										@{
											var row = rowObj as StageScheduleRow;
										}
										<div style="font-weight:bold;"
											 title="@row?.StageName">
											@row?.StageName
										</div>
									</Template>

									<HeaderTemplate Context="headerRow">
										<div style="font-weight:bold;">Podium</div>
									</HeaderTemplate>
								</GridColumn>

								@foreach ( var slot in TimeSlots )
								{
									<GridColumn Field="@slot" HeaderText="@slot" Width="120">
										<Template Context="rowObj">
											@{
												var row = rowObj as StageScheduleRow;
												var value = row?[slot];
												var cssClass = string.IsNullOrEmpty(value) ? "empty-slot" : "filled-slot";
											}
											<div class="@cssClass"
												 title="@value">
												@value
											</div>
										</Template>
									</GridColumn>
								}
							</GridColumns>
						</SfGrid>
					</div>
				}
			</div>

			<div class="row row5">
				<div class="col left">
					@if ( SelectedEditionId != null )
					{
						<div Class="titles-container">
							<div class="title">Podiumdienst</div>
							<SfGrid DataSource="@StageDuty"
							AllowSorting="false"
							AllowSelection="false"
							AllowResizing="true"
							AllowPaging="false"
							CssClass="amusing-grid"
							@ref="StageDutyGridRef">

						<GridColumns>
							<GridColumn HeaderText="Nr" Width="45" TextAlign="TextAlign.Right">
								<Template Context="item">
									@if ( item is PlanningStageVolunteersModel row )
									{
										var previous = GetPreviousItem(row);
										bool showPodium = previous == null || previous.StageNumber != row.StageNumber;

										var css = showPodium ? "podium-name podium-start" : "";

										if ( showPodium )
										{
											<div class="@css">@row.StageNumber</div>
										}
									}
								</Template>
							</GridColumn>

							<GridColumn HeaderText="Podium" Width="390">
								<Template Context="item">
									@if ( item is PlanningStageVolunteersModel row )
									{
										var previous = GetPreviousItem(row);
										bool showPodium = previous == null || previous.StageName != row.StageName;

										var css = showPodium ? "podium-name podium-start" : "";

										if ( showPodium )
										{
											<div class="@css">@row.StageName</div>
										}
									}
								</Template>
							</GridColumn>

							<GridColumn Field="Volunteer" HeaderText="Vrijwilliger" Width="200"></GridColumn>
							<GridColumn Field="StartTime" HeaderText="Van" Width="60" Format="t"></GridColumn>
							<GridColumn Field="EndTime" HeaderText="Tot" Width="60" Format="t"></GridColumn>

						</GridColumns>
					</SfGrid>
						</div>
					}
				</div>
				<div class="col right">
					@if ( SelectedEditionId != null )
					{
						<div Class="titles-container">
							<div class="title">Overige taken</div>
							<SfGrid DataSource="@OtherTasks"
									AllowResizing="true"
									CssClass="amusing-grid"
									@ref="OtherTasksGridRef">
								<GridColumns>
									<GridColumn HeaderText="Taak" Width="300">
										<Template Context="item">
											@if ( item is PlanningOtherVolunteerTasksModel row )
											{
												var previous = GetPreviousTaskItem(row);
												bool showPodium = previous == null || previous.TaskName != row.TaskName;

												var css = showPodium ? "podium-name podium-start" : "";

												if ( showPodium )
												{
													<div class="@css">@row.TaskName</div>
												}
											}
										</Template>
									</GridColumn>
									<GridColumn Field="Volunteer" HeaderText="Vrijwilliger" Width="200"></GridColumn>
									<GridColumn Field="StartTime" HeaderText="Van" Width="60" Format="t"></GridColumn>
									<GridColumn Field="EndTime" HeaderText="Tot" Width="60" Format="t"></GridColumn>
								</GridColumns>
							</SfGrid>
						</div>
					}

				</div>
			</div>


		</div>

	</Authorized>
	<NotAuthorized>
		<p class="text-danger">Je hebt alleen toegang tot deze pagina wanneer je bent ingelogt</p>
	</NotAuthorized>
</AuthorizeView>