@page "/List-Persons"
@using Amusing.Models
@using Amusing.Services
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations

@inject PersonService PersonService;

@inherits ListPersons

<h3>Personen</h3>
@if ( IsLoading )
{
    <div class="text-center p-2">
        <SfSpinner CssClass="e-spin-center" />
        <p>Gegevens worden geladen...</p>
    </div>
}
else
{
    <div class="spacer-large"></div>
    <div style="overflow-x:auto; min-width: 800px; padding-right: 10px; margin-top: 10px;">
	    <SfGrid 
            @ref="GridRef" 
            TValue="PersonOverviewModel"
            DataSource="@Personen" 
            AllowExcelExport="true"  Width="100%"
            AllowResizing="true"
            AllowPdfExport="true"
            AllowMultiSorting="true" 
            AllowSorting="true" 
            AllowTextWrap="true" >

            <GridEvents TValue="PersonOverviewModel"
                        DataBound="OnGridDataBound" />

            <GridSortSettings>
                <GridSortColumns>
                    <GridSortColumn Field="Naam" Direction="SortDirection.Ascending"></GridSortColumn>
                    <GridSortColumn Field="Email" Direction="SortDirection.Ascending"></GridSortColumn>
                </GridSortColumns>
            </GridSortSettings>

            <GridTextWrapSettings WrapMode=WrapMode.Content></GridTextWrapSettings>

            <SfToolbar>
                <ToolbarItems>
                    <ToolbarItem Type="ItemType.Button">
                        <Template>
                            <button class="custom-toolbar-btn" @onclick="ExportToExcel" title="Exporteer naar een Excel bestand">
                                <img src="icons/excel.svg" class="icon" alt="Excel" />
                            </button>
                        </Template>
                    </ToolbarItem>

                    <ToolbarItem Type="ItemType.Button">
                        <Template>
                            <button class="custom-toolbar-btn" @onclick="ExportToCsv" title="Exporteer naar een CSV bestand">
                                <img src="icons/csv.svg" class="icon" alt="CSV" />
                            </button>
                        </Template>
                    </ToolbarItem>

                    <ToolbarItem Type="ItemType.Button">
                        <Template>
                            <button class="custom-toolbar-btn" @onclick="ExportToPdf" title="Maak een PDF bestand">
                                <img src="icons/pdf.svg" class="icon" alt="PDF" />
                            </button>
                        </Template>
                    </ToolbarItem>


                    <ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
                        <Template>
                            <span class="toolbar-count">@FileName: @VisibleRowCount</span>
                        </Template>
                    </ToolbarItem>

                    <ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
                        <Template>
                            <SfTextBox Placeholder="Zoek" Input="OnInput"></SfTextBox>
                        </Template>
                    </ToolbarItem>
                </ToolbarItems>
            </SfToolbar>

            <GridColumns>
                <GridColumn Field="Naam" HeaderText="Naam" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="20%"/>
                <GridColumn Field="Email" HeaderText="E-Mail" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="30%"/>

                <GridColumn HeaderText="Rollen" TextAlign="TextAlign.Left" AllowSorting="false" Width="25%">
                    <Template Context="persoon">
                        @string.Join( ", ", ( ( PersonOverviewModel ) persoon ).Rollen )
                    </Template>
                </GridColumn>

                <GridColumn HeaderText="Vrijwilliger in" TextAlign="TextAlign.Left" AllowSorting="false" Width="25%">
                    <Template Context="persoon">
                        @string.Join( ", ", ( ( PersonOverviewModel ) persoon ).Vrijwilliger )
                    </Template>
                </GridColumn>

            </GridColumns>

        </SfGrid>
    </div>
}
