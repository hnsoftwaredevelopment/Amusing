@page "/Recipients"
@using Amusing.Models
@using Amusing.Services
@using Amusing.Helpers
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@using System.ComponentModel.DataAnnotations
@using Syncfusion.Blazor.Notifications
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.QueryBuilder;
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.SplitButtons
@using System.Text.Json
@using System.Text.Json.Serialization

@inject MailingService MailingService;
@inject NavigationManager NavManager
@inject IJSRuntime JS

<div class="page-container">
    <!-- Static detail fields-->
    <div class="fixed-header">
        <SfRadioButton 
            Label="Groepen" 
            Name="source" 
            Value="groups" 
            TChecked="string" 
            @onchange="onSourceChange" 
            @bind-Checked="SourceChecked" />
        <SfRadioButton 
            Label="Personen" 
            Name="source" 
            Value="persons" 
            TChecked="string" 
            @onchange="onSourceChange" 
            @bind-Checked="SourceChecked" />

        <div class="spacer-small"></div>
        <SfTextBox Placeholder="Lijstnaam" FloatLabelType="FloatLabelType.Always" Width="300px" @bind-Value="SelectedRecipientsList.ListName" />

        @if (SourceChecked == "groups")
        {
            <h5>Groepen</h5>
        }
        else
        {
            <h5>Personen</h5>
        }

        <SfQueryBuilder TValue="RuleModel" @ref="queryBuilder" Width="80%" MaxGroupCount="0">
            <QueryBuilderEvents TValue="RuleModel" Changed="OnQueryChanged" />
            <QueryBuilderColumns>
                <QueryBuilderColumn Field="Festival"
                                    Label="Groep is ingeschreven voor ..."
                                    Type="Syncfusion.Blazor.QueryBuilder.ColumnType.String"
                                    Operators="@(new List<OperatorsModel> { new OperatorsModel { Value = "in", Text = "Bevat" } } )">
                    <QueryBuilderTemplates>
                        <ValueTemplate>
                            @{
                                // context is provided door QueryBuilder templates; haal huidige selectie (veilig casten)
                                var selected = context.Value as string[] ?? Array.Empty<string>();
                            }
                            <SfMultiSelect TItem="string"
                                            TValue="string[]"
                                            DataSource="@FestivalValues"
                                            Value="@selected"
                                            Placeholder="Selecteer festivals">
                                <MultiSelectEvents TValue="string[]" TItem="string" ValueChange="@(( MultiSelectChangeEventArgs<string [ ]> e ) => ChangeValue( e, context ))" />
                            </SfMultiSelect>
                        </ValueTemplate>
                    </QueryBuilderTemplates>
                </QueryBuilderColumn>

                <QueryBuilderColumn 
                    Field="IsPaid" 
                    Label="Groep heeft betaald" 
                    Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Boolean" 
                    Operators="EqualOnlyOperator" />

                <QueryBuilderColumn 
                    Field="IsCanceled" 
                    Label="Groep is afgehaakt" 
                    Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Boolean" 
                    Operators="EqualOnlyOperator" />

                <QueryBuilderColumn 
                    Field="Dressingroom" 
                    Label="Groep wil kleedkamer" 
                    Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Boolean" 
                    Operators="EqualOnlyOperator" />

                <QueryBuilderColumn 
                    Field="Jury" 
                    Label="Groep wil beoordeling" 
                    Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Boolean" 
                    Operators="EqualOnlyOperator" />

                <QueryBuilderColumn 
                    Field="Singers" 
                    Label="Aantal zangers" 
                    Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Number" 
                    Operators="NumberOperator" />

                <QueryBuilderColumn Field="Role"
                                    Label="Persoon met de rol..."
                                    Type="Syncfusion.Blazor.QueryBuilder.ColumnType.String"
                                    Operators="@(new List<OperatorsModel> { new OperatorsModel { Value = "in", Text = "Bevat" } } )">
                    <QueryBuilderTemplates>
                        <ValueTemplate>
                            @{
                                var selected = context.Value as string[] ?? Array.Empty<string>();
                            }
                            <SfMultiSelect TItem="string"
                                            TValue="string[]"
                                            DataSource="@PersonRoles"
                                            Value="@selected"
                                            Placeholder="Selecteer rollen">
                                <MultiSelectEvents TValue="string[]" TItem="string" ValueChange="@(( MultiSelectChangeEventArgs<string [ ]> e ) => ChangeValue( e, context ))" />
                            </SfMultiSelect>
                        </ValueTemplate>
                    </QueryBuilderTemplates>
                </QueryBuilderColumn>

                <QueryBuilderColumn 
                    Field="Infomailing" 
                    Label="Persoon wil Infomailing" 
                    Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Boolean" 
                    Operators="EqualOnlyOperator" />

                <QueryBuilderColumn Field="Volunteer"
                                    Label="Persoon is vrijwilliger voor festival..."
                                    Type="Syncfusion.Blazor.QueryBuilder.ColumnType.String"
                                    Operators="@(new List<OperatorsModel> { new OperatorsModel { Value = "in", Text = "Bevat" } } )">
                    <QueryBuilderTemplates>
                        <ValueTemplate>
                            @{
                                var selected = context.Value as string[] ?? Array.Empty<string>();
                            }
                            <SfMultiSelect TItem="string"
                                            TValue="string[]"
                                            DataSource="@FestivalValues"
                                            Value="@selected"
                                            Placeholder="Selecteer festivals (vrijwilliger)">
                                <MultiSelectEvents TValue="string[]" TItem="string" ValueChange="@(( MultiSelectChangeEventArgs<string [ ]> e ) => ChangeValue( e, context ))" />
                            </SfMultiSelect>
                        </ValueTemplate>
                    </QueryBuilderTemplates>
                </QueryBuilderColumn>
        </QueryBuilderColumns>
    </SfQueryBuilder>

        <!-- Toolbar -->
        <div style="overflow-x:auto; padding-left: 2px; padding-right: 2px">
            <SfToolbar Width="870px">
                <ToolbarItems>
                    <ToolbarItem Type="ItemType.Button">
                        <Template>
                            <button class="custom-toolbar-btn"
                                    @onclick="Save"
                                    title="Bewaar de gebruiker">
                                <img src="icons/button-save.svg" class="icon" alt="SAVE" />
                            </button>
                        </Template>
                    </ToolbarItem>
                    <ToolbarItem Type="ItemType.Button">
                        <Template>
                            <button class="custom-toolbar-btn" @onclick="AddNew" title="Voeg een nieuw gebruiker toe">
                                <img src="icons/button-add.svg" class="icon" alt="ADD" />
                            </button>
                        </Template>
                    </ToolbarItem>
                    <ToolbarItem Type="ItemType.Button">
                        <Template>
                            <button class="custom-toolbar-btn" @onclick="Delete" title="verwijder de geselecteerde gebruiker">
                                <img src="icons/button-del.svg" class="icon" alt="DELETE" />
                            </button>
                        </Template>
                    </ToolbarItem>
                    <ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
                        <Template>
                            <span class="toolbar-count">@FileName: @VisibleRowCount</span>
                        </Template>
                    </ToolbarItem>
                    <ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
                        <Template>
                            <SfTextBox Placeholder="Zoek" Input="OnInput"></SfTextBox>
                        </Template>
                    </ToolbarItem>
                </ToolbarItems>
            </SfToolbar>
        </div>
    </div>

    <div class="spacer-small"></div>

    <!-- Scrollable area for main datagrid -->
    <div class="scrollable-content">
        <div style="overflow-x:auto; padding-left: 2px; padding-right: 2px;">
            <SfGrid @ref="GridRef"
                    TValue="RecipientListModel"
                    Width="870"
                    DataSource="@FilteredRecipients"
                    EnableStickyHeader="true"
                    AllowResizing="true"
                    Height="260px"
                    AllowSorting="true"
                    AllowMultiSorting="true"
                    AllowSelection="true">
                <GridEvents TValue="RecipientListModel" DataBound="OnGridDataBound" RowSelected="OnRowSelected" />
                <GridEditSettings AllowAdding="true" NewRowPosition="NewRowPosition.Top"></GridEditSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(RecipientListModel.ListId)" IsPrimaryKey="true" Visible="false" />
                    <GridColumn Field="@nameof(RecipientListModel.ListName)" HeaderText="Lijst" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="350px" />
                    <GridColumn Field="@nameof(RecipientListModel.ListSourceUI)" HeaderText="Bron" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="100px" />
                    <GridColumn Field="@nameof(RecipientListModel.ListCreated)" HeaderText="Gemaakt" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="120px" />
                    <GridColumn Field="@nameof(RecipientListModel.ListChanged)" HeaderText="Gewijzigd" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="120px" />
                </GridColumns>
            </SfGrid>
        </div>
    </div>
</div>

@code 
{
    private bool _initialLoadDone = false;
    private bool FestivalSelected = false;
    //private bool IsLoading = false;
    private bool RoleSelected = false;
    private bool rulesPending;
    private string? pendingRulesJson;
    private EditContext? editContext;
    private int VisibleRowCount = 0;
    private List<RecipientListFilterModel> RecipientsFilterList = [];
    private List<RecipientListModel> RecipientsList = [];
    private List<RecipientListModel> FilteredRecipients =>
    RecipientsList
        .Where( r => SourceChecked == "groups"
            ? r.ListSourceUI == "Groepen"
            : r.ListSourceUI == "Personen" )
        .ToList();
    private List<string> FestivalValues { get; set; } = new();
    private List<string> RoleValues { get; set; } = new();
    private List<OperatorsModel> EqualOnlyOperator  = new List<OperatorsModel>
    {
        new OperatorsModel { Value = "equal", Text = "Is gelijk aan" }
    };
    private List<OperatorsModel> NumberOperator = new List<OperatorsModel>()
    {
        new OperatorsModel { Value="equal", Text = "Gelijk aan" },
        new OperatorsModel { Value="notequal", Text = "Niet gelijk aan" },
        new OperatorsModel { Value="greaterthan", Text = "Groter dan" },
        new OperatorsModel { Value="greaterthanorequal", Text = "Groter of gelijk aan" },
        new OperatorsModel { Value="lessthan", Text = "Kleiner dan" },
        new OperatorsModel { Value="lessthanorequal", Text = "Kleiner of gelijk aan" },
    };
    private RecipientListModel? SelectedRecipientsList =new();
    private SfGrid<RecipientListFilterModel>? GridRefReceipts;
    private SfGrid<RecipientListModel>? GridRef;
    private SfQueryBuilder<RuleModel> queryBuilder;
    private SfToast ToastObj;
    private List<string> PersonRoles = new() { "contactpersoon1", "contactpersoon2", "dirigent", "muzikant", "penningmeester", "zanger" };
    private static readonly string[] InFields = { "Festival", "Role", "Volunteer" };
    private string FileName = "Mailing lijsten";
    private string GeneratedSql = string.Empty;
    private string SourceChecked { get; set; } = "groups";
    private string[] YesNoValues = new string[] { "Ja", "Nee" };
    private string GeneratedJson = string.Empty;
    private string OldJson = string.Empty;
    private string[] LastSelectedFestivals = Array.Empty<string>(); // For autoselect the Festivals for Volunteers

    protected override async Task OnInitializedAsync()
    {
        //Get all recipientlists
        RecipientsList = await MailingService.GetRecipientListsAsync();
        SelectedRecipientsList = RecipientsList.FirstOrDefault();
        editContext = new EditContext( SelectedRecipientsList );

        // Get Festival values
        FestivalValues = await MailingService.GetFestivalListAsync();

        if ( SelectedRecipientsList != null )
        {
            if ( string.IsNullOrWhiteSpace( SelectedRecipientsList.ListQuery ) && !string.IsNullOrWhiteSpace( SelectedRecipientsList.ListFilter ) )
            {
                SelectedRecipientsList.ListQuery = QueryBuilderJsonConverter.OldToNew( SelectedRecipientsList.ListFilter );
            }

            LoadRulesIntoQueryBuilder( SelectedRecipientsList.ListQuery );
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnGridDataBound()
    {
        if ( !_initialLoadDone && RecipientsList?.Any() == true )
        {
            _initialLoadDone = true;
            await UpdateVisibleRowCountAsync();

            // Select first row in the SfGrid
            await GridRef.SelectRowAsync( 0 );

            // filll QueryBuilder with query data from selected row
            await SelectRecipientListAsync( RecipientsList [ 0 ] );
        }
    }

    private async Task OnRowSelected( RowSelectEventArgs<RecipientListModel> args )
    {
        await SelectRecipientListAsync( args.Data );
    }

    private async Task SelectRecipientListAsync( RecipientListModel recipient )
    {
        if ( recipient == null )
            return;

        SelectedRecipientsList = recipient;
        editContext = new EditContext( SelectedRecipientsList );

        SourceChecked = SelectedRecipientsList.ListSource switch
        {
            MailingService.RecipientListSource.Groups => "groups",
            MailingService.RecipientListSource.Persons => "persons",
            _ => string.Empty
        };

        if ( queryBuilder != null )
        {
            string json = SelectedRecipientsList.ListQuery;

            // Alleen converteren als er geen nieuwe JSON is
            if ( string.IsNullOrWhiteSpace( json ) && !string.IsNullOrWhiteSpace( SelectedRecipientsList.ListFilter ) )
            {
                json = QueryBuilderJsonConverter.OldToNew( SelectedRecipientsList.ListFilter );
                SelectedRecipientsList.ListQuery = json;
            }

            // Zet de regels in de QueryBuilder
            await LoadRulesAsync( json );

            // Fix alle "in"-velden die null zijn
            FixInFields( queryBuilder.GetRules()?.Rules );

            // Eventueel: subscribeer op nieuwe regels zodat sanity check automatisch blijft gelden
            //queryBuilder.RuleAdded += ( sender, args ) => FixInFields( new [ ] { args.Rule } );
        }

        //await InvokeAsync( StateHasChanged );
    }

    #region FixInfields
    private void FixInFields( RuleModel rule )
    {
        if ( rule == null )
            return;

        if ( InFields.Contains( rule.Field ) && rule.Operator == "in" && rule.Value == null )
            rule.Value = Array.Empty<string>();

        if ( rule.Rules != null && rule.Rules.Any() )
            FixInFields( rule.Rules );
    }

    private void FixInFields( IEnumerable<RuleModel> rules )
    {
        if ( rules == null )
            return;
        foreach ( var r in rules )
            FixInFields( r );
    }
    #endregion

    private void LoadRulesIntoQueryBuilder( string? json )
    {
        if ( queryBuilder == null )
            return;

        if ( string.IsNullOrWhiteSpace( json ) )
        {
            queryBuilder.Reset();
            return;
        }

        var rules = QueryBuilderJsonConverter.ToRuleModels(json);
        queryBuilder.SetRules( rules );
        // Force AND condition en fix alle "in"-velden
        ForceAndCondition( rules );
        FixInFields( rules );
    }

    #region ForceAndCondition
    private void ForceAndCondition( RuleModel rule )
    {
        if ( rule == null )
            return;

        if ( rule.Rules != null && rule.Rules.Any() )
        {
            rule.Condition = "and";
            // recurse into children
            ForceAndCondition( rule.Rules );
        }
        else
        {
            rule.Condition = null;
        }
    }

    private void ForceAndCondition( IEnumerable<RuleModel> rules )
    {
        if ( rules == null )
            return;
        foreach ( var r in rules )
        {
            ForceAndCondition( r );
        }
    }
    #endregion

    private static RuleModel BuildRuleFromJsonElement( JsonElement elem )
    {
        var rule = new RuleModel();

        // Strings / eenvoudige velden
        if ( elem.TryGetProperty( "Field", out var pField ) && pField.ValueKind == JsonValueKind.String )
            rule.Field = pField.GetString();
        if ( elem.TryGetProperty( "Label", out var pLabel ) && pLabel.ValueKind == JsonValueKind.String )
            rule.Label = pLabel.GetString();
        if ( elem.TryGetProperty( "Operator", out var pOperator ) )
            rule.Operator = pOperator.ValueKind == JsonValueKind.String ? pOperator.GetString() : pOperator.ToString();
        if ( elem.TryGetProperty( "Type", out var pType ) && pType.ValueKind == JsonValueKind.String )
            rule.Type = pType.GetString();
        if ( elem.TryGetProperty( "RuleId", out var pRuleId ) && pRuleId.ValueKind == JsonValueKind.String )
            rule.RuleId = pRuleId.GetString();

        // Booleans
        if ( elem.TryGetProperty( "IsLocked", out var pIsLocked ) && pIsLocked.ValueKind != JsonValueKind.Null )
        {
            if ( pIsLocked.ValueKind == JsonValueKind.True )
                rule.IsLocked = true;
            else if ( pIsLocked.ValueKind == JsonValueKind.False )
                rule.IsLocked = false;
        }
        if ( elem.TryGetProperty( "Not", out var pNot ) && pNot.ValueKind != JsonValueKind.Null )
        {
            if ( pNot.ValueKind == JsonValueKind.True )
                rule.Not = true;
            else if ( pNot.ValueKind == JsonValueKind.False )
                rule.Not = false;
        }
        if ( elem.TryGetProperty( "Condition", out var pCond ) && pCond.ValueKind == JsonValueKind.String )
            rule.Condition = pCond.GetString();

        // Value: kan Array of Single Value zijn
        if ( elem.TryGetProperty( "Value", out var pValue ) )
        {
            // For convenience treat Operator as string now
            var op = rule.Operator?.ToString();

            if ( pValue.ValueKind == JsonValueKind.Array )
            {
                var items = pValue.EnumerateArray()
                          .Select(e => ConvertJsonElement(e, rule.Type))
                          .ToList();

                if ( string.Equals( op, "in", StringComparison.OrdinalIgnoreCase ) )
                {
                    rule.Value = rule.Type?.ToLower() switch
                    {
                        "string" => items.Select( v => v?.ToString() ?? string.Empty ).ToArray(),
                        "boolean" => items.Select( v => Convert.ToBoolean( v ) ).ToArray(),
                        "number" or "int" or "double" => items.Select( v => Convert.ToDouble( v ) ).ToArray(),
                        _ => items.ToArray()
                    };
                }
                else
                {
                    rule.Value = items.ToArray();
                }
            }
            else
            {
                // single Value
                var single = ConvertJsonElement(pValue, rule.Type);

                if ( string.Equals( op, "in", StringComparison.OrdinalIgnoreCase ) )
                {
                    // force array for 'in'
                    if ( single == null )
                        rule.Value = Array.Empty<string>();
                    else if ( single is string s )
                        rule.Value = new string [ ] { s };
                    else if ( single is bool b )
                        rule.Value = new bool [ ] { b };
                    else if ( single is double d )
                        rule.Value = new double [ ] { d };
                    else
                        rule.Value = new object [ ] { single };
                }
                else
                {
                    rule.Value = single;
                }
            }
        }

        // Recursief: child rules (Rules)
        if ( elem.TryGetProperty( "Rules", out var pRules ) && pRules.ValueKind == JsonValueKind.Array )
        {
            var list = new List<RuleModel>();
            foreach ( var child in pRules.EnumerateArray() )
                list.Add( BuildRuleFromJsonElement( child ) );
            rule.Rules = list;
        }

        return rule;
    }

    private async Task LoadRulesAsync( string? json )
    {
        if ( queryBuilder is null )
            return;

        if ( string.IsNullOrWhiteSpace( json ) )
        {
            queryBuilder.Reset();
            return;
        }

        try
        {
            using var doc = JsonDocument.Parse(json);
            var rootElem = doc.RootElement;

            var rootRule = BuildRuleFromJsonElement(rootElem);

            // Force AND en fix children
            ForceAndCondition( rootRule );

            if ( rootRule.Rules != null && rootRule.Rules.Any() )
                queryBuilder.SetRules( rootRule.Rules );
            else
                queryBuilder.SetRules( new List<RuleModel> { rootRule } );


            return;
        }
        catch
        {
            queryBuilder.Reset();
        }

        await InvokeAsync( StateHasChanged );
    }

    private static readonly HashSet<string> BooleanFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "IsCanceled", "IsPaid", "Dressingroom", "Jury", "Infomailing"
    };

    private static object? ConvertJsonElement( JsonElement element, string? type )
    {
        if ( element.ValueKind == JsonValueKind.Null || element.ValueKind == JsonValueKind.Undefined )
            return null;

        return type?.ToLower() switch
        {
            "boolean" => element.GetBoolean(),
            "number" or "double" or "int" => element.TryGetDouble( out var d ) ? d : 0,
            "string" => element.GetString(),
            _ => element.ToString() // fallback
        };
    }

    private static object? ConvertJsonElementToClr( JsonElement elem, string? fieldName )
    {
        switch ( elem.ValueKind )
        {
            case JsonValueKind.True:
            case JsonValueKind.False:
                return elem.GetBoolean();

            case JsonValueKind.Number:
                // If the Field is a boolean Field (older data might save 0/1) => convert to bool
                if ( !string.IsNullOrEmpty( fieldName ) && BooleanFields.Contains( fieldName ) )
                {
                    int n = 0;
                    if ( elem.TryGetInt32( out n ) )
                        return n != 0;
                    if ( elem.TryGetInt64( out var l ) )
                        return l != 0L;
                }

                // Otherwise return integer
                if ( elem.TryGetInt32( out var i ) )
                    return i;
                if ( elem.TryGetInt64( out var l2 ) )
                    return l2;
                if ( elem.TryGetDouble( out var d ) )
                    return d;
                return elem.GetRawText();

            case JsonValueKind.String:
                var s = elem.GetString() ?? string.Empty;
                // if string contains comma and Operator was 'in' earlier, we may want an array,
                // but decide later from RuleModel.Operator. For now return string.
                // Some callers expect arrays, but FixRuleValues will also run on the parent to convert if needed.
                // Convert "0"/"1" to bool for boolean fields
                if ( !string.IsNullOrEmpty( fieldName ) && BooleanFields.Contains( fieldName ) )
                {
                    if ( s == "0" )
                        return false;
                    if ( s == "1" )
                        return true;
                    if ( bool.TryParse( s, out var bv ) )
                        return bv;
                }
                return s;

            case JsonValueKind.Array:
                // convert all array items to strings (most common for 'in')
                var items = elem.EnumerateArray()
                .Select(x => x.ValueKind == JsonValueKind.String ? x.GetString() ?? string.Empty : x.ToString())
                .Where(x => x != null)
                .ToArray();
                return items;

            default:
                return elem.GetRawText();
        }
    }

    protected override async Task OnAfterRenderAsync( bool firstRender )
    {
        if ( firstRender )
        {
            await UpdateVisibleRowCountAsync();
        }
    }

    private async Task UpdateVisibleRowCountAsync()
    {
        if ( GridRef is not null )
        {
            var records = await GridRef.GetCurrentViewRecordsAsync();
            //await Task.Delay( 50 );
            VisibleRowCount = records?.Count ?? 0;
            //StateHasChanged();
        }
    }

    public async Task OnInput( InputEventArgs args )
    {
        await GridRef.SearchAsync( args.Value );

        await Task.Delay( 50 );
        await UpdateVisibleRowCountAsync();
    }

    private async Task Save()
    {
        if ( SelectedRecipientsList is null )
            return;

        var rules = queryBuilder.GetRules();

        // Force AND
        ForceAndCondition( rules );

        SelectedRecipientsList.ListQuery = JsonSerializer.Serialize( rules, new JsonSerializerOptions
        {
            WriteIndented = true,
            DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingDefault
        } );

        if ( SelectedRecipientsList.ListFilter == null )
            SelectedRecipientsList.ListFilter = "[]";

        // if (SelectedRecipientsList != null && queryBuilder != null)
        // {
        //     // Convert naar oud JSON formaat
        //     SelectedRecipientsList.ListFilter = QueryBuilderJsonConverter.NewToOld(queryBuilder);

        //     // Save via je service
        //     //await MailingService.SaveRecipientListAsync(SelectedRecipientsList);
        // }

        if ( SelectedRecipientsList.ListId != 0 )
        {
            await MailingService.UpdateRecipientQueryAsync( SelectedRecipientsList );
            await Task.Delay( 150 );
            RecipientsList = await MailingService.GetRecipientListsAsync();
            await Task.Delay( 50 );
            await GridRef.Refresh();
        }
        else
        {
            // Save the new List and get the new List Id
            var savedId = await MailingService.AddRecipientQueryAsync(SelectedRecipientsList);

            // Refresh the list
            RecipientsList = await MailingService.GetRecipientListsAsync();
            await Task.Delay( 50 );
            await GridRef.Refresh();

            // Search the modified record
            var index = RecipientsList.FindIndex(s => s.ListId == savedId);
            if ( index >= 0 )
            {
                SelectedRecipientsList = RecipientsList [ index ];
                await GridRef.SelectRowAsync( index );
            }
        }
    }

    private async Task AddNew()
    {
        var newRecipientsList = new RecipientListModel
        {
            ListId = 0,
            ListName = ""
        };

        await GridRef.AddRecordAsync( newRecipientsList, 0 );
        await GridRef.SelectRowAsync( 0 );

        SelectedRecipientsList = newRecipientsList;
        editContext = new EditContext( SelectedRecipientsList );
        StateHasChanged();
    }

    private async Task Delete()
    {
        if ( SelectedRecipientsList.ListId == 0 )
            return;

        await MailingService.DeleteRecipientQueryAsync( SelectedRecipientsList.ListId );

        // Refresh the list
        await Task.Delay( 150 );
        RecipientsList = await MailingService.GetRecipientListsAsync();
        await Task.Delay( 50 );
        await GridRef.Refresh();
    }

    private void onSourceChange( Microsoft.AspNetCore.Components.ChangeEventArgs args )
    {
        var value = args.Value?.ToString() ?? string.Empty;

        SelectedRecipientsList.ListSource = value switch
        {
            "groups" => MailingService.RecipientListSource.Groups,
            "persons" => MailingService.RecipientListSource.Persons,
            _ => MailingService.RecipientListSource.Unknown
        };

        SourceChecked = args.Value?.ToString();
    }
    
    private void OnQueryChanged(Syncfusion.Blazor.QueryBuilder.ChangeEventArgs args)
    {
            var rootRules = queryBuilder.GetRules();

            if (rootRules == null || rootRules.Rules == null || !rootRules.Rules.Any())
            {
                // Query nog niet compleet, niks doen
                GeneratedJson = "Nog geen complete query...";
                return;
            }

            foreach (var rule in rootRules.Rules)
            {
                if ((rule.Field == "Festival" || rule.Field == "Role" || rule.Field == "Volunteer")
                    && rule.Operator == "in")
                {
                    switch (rule.Value)
                    {
                        case string s:
                            // convert single string into an array
                            rule.Value = new string[] { s };
                            break;

                        case null:
                            // ensure we have an empty array instead of null
                            rule.Value = Array.Empty<string>();
                            break;
                    }
                }
            }

            try
            {
                // Serialize to JSON
                GeneratedJson = JsonSerializer.Serialize(rootRules, new JsonSerializerOptions { WriteIndented = true });
                //OldJson = QueryBuilderJsonConverter.NewToOld(queryBuilder);

            }
            catch (Exception ex)
            {
                GeneratedJson = $"Error: {ex.Message}";
            }

            //Alleen boolean gebruiken om te bepalen of festival geselecteerd is
            FestivalSelected = rootRules.Rules.Any( r => r.Field == "Festival" && r.Value is string [ ] arr && arr.Length > 0 );

    }

    private void ChangeValue( MultiSelectChangeEventArgs<string [ ]> args, RuleModel rule )
    {
        // Zorg dat de rule.Value exact de array bevat die door de MultiSelect wordt geleverd
        rule.Value = args.Value ?? Array.Empty<string>();
        // (optioneel) forceer UI update
        StateHasChanged();
    }

    private async Task GenerateMailList()
    {
        var rules = queryBuilder.GetRules();

        string queryType = "GetFullPersonsList";

        // Bepaal welke query te gebruiken
        if ( rules.Rules.Any( r => r.Field == "Role" ) )
            queryType = "GetPersonsWithRoleList";
        if ( rules.Rules.Any( r => r.Field == "Festival" ) )
            queryType = "GetPersonsWithRoleList";

        
    }
}