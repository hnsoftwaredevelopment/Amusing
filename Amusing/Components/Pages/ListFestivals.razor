@page "/List-Festivals"
@using Amusing.Models
@using Amusing.Services
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations

<h3>Overzicht @FileName</h3>
@if ( IsLoading )
{
    <div class="text-center p-2">
        <SfSpinner CssClass="e-spin-center" />
        <p>@FileName gegevens worden geladen...</p>
    </div>
}
else
{
    <div class="spacer-large"></div>
    <div style="overflow-x:auto; min-width: 800px; padding-right: 10px; margin-top: 10px;">
	    <SfGrid 
            @ref="GridRef" 
            TValue="FestivalModel"
            DataSource="@Festivals" 
            AllowExcelExport="true"  Width="100%"
            AllowResizing="true"
            AllowPdfExport="true"
            AllowMultiSorting="true" 
            AllowSorting="true" 
            AllowTextWrap="true" >

            <GridEvents TValue="FestivalModel"
                        DataBound="OnGridDataBound" />

            <GridSortSettings>
                <GridSortColumns>
                    <GridSortColumn Field="Festival" Direction="SortDirection.Descending"></GridSortColumn>
                </GridSortColumns>
            </GridSortSettings>

            <SfToolbar>
                <ToolbarItems>
                    <ToolbarItem Type="ItemType.Button">
                        <Template>
                            <button class="custom-toolbar-btn" @onclick="ExportToExcel" title="Exporteer naar een Excel bestand">
                                <img src="icons/excel.svg" class="icon" alt="Excel" />
                            </button>
                        </Template>
                    </ToolbarItem>

                    <ToolbarItem Type="ItemType.Button">
                        <Template>
                            <button class="custom-toolbar-btn" @onclick="ExportToCsv" title="Exporteer naar een CSV bestand">
                                <img src="icons/csv.svg" class="icon" alt="CSV" />
                            </button>
                        </Template>
                    </ToolbarItem>

                    <ToolbarItem Type="ItemType.Button">
                        <Template>
                            <button class="custom-toolbar-btn" @onclick="ExportToPdf" title="Maak een PDF bestand">
                                <img src="icons/pdf.svg" class="icon" alt="PDF" />
                            </button>
                        </Template>
                    </ToolbarItem>


                    <ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
                        <Template>
                            <span class="toolbar-count">@FileName: @VisibleRowCount</span>
                        </Template>
                    </ToolbarItem>

                    <ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
                        <Template>
                            <SfTextBox Placeholder="Zoek" Input="OnInput"></SfTextBox>
                        </Template>
                    </ToolbarItem>
                </ToolbarItems>
            </SfToolbar>

            <GridColumns>
                <GridColumn Field="Festival" HeaderText="Festival" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="40px"/>
                <GridColumn Field="FestivaldatumExport" HeaderText="Datum" Format="dd MMMM yyyy" Type="ColumnType.Date" Width="70px"/>
                <GridColumn Field="Gepubliceerd" HeaderText="Gepubliceerd" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="70px"/>
            </GridColumns>

        </SfGrid>
    </div>
}
