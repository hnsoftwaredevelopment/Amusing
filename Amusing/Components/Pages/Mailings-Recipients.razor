    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;

        RecipientsList = await MailingService.GetRecipientListsAsync();

        SelectedRecipientsList = RecipientsList.FirstOrDefault();
        editContext = new EditContext( SelectedRecipientsList );

        FestivalValues = await MailingService.GetFestivalListAsync();

        // Safety: fix all "in" fields so Value is always a string[]
        var rules = queryBuilder?.GetRules()?.Rules;
        if (rules != null)
        {
            foreach (var rule in rules.Where(r =>
                InFields.Contains(r.Field) && r.Operator == "in"))
            {
                rule.Value ??= Array.Empty<string>();
            }
        }

        IsLoading = false;
    }

    private async Task OnGridDataBound()
    {
        if ( !_initialLoadDone && RecipientsList?.Any() == true )
        {
            _initialLoadDone = true;
            await UpdateVisibleRowCountAsync();
            await GridRef.SelectRowAsync( 0 );
        }
    }

    private async Task OnRowSelected( RowSelectEventArgs<RecipientListModel> args )
    {
        SelectedRecipientsList = args.Data;
        editContext = new EditContext( SelectedRecipientsList );

        SourceChecked = SelectedRecipientsList.ListSource switch
        {
            MailingService.RecipientListSource.Groups => "groups",
            MailingService.RecipientListSource.Persons => "persons",
            _ => string.Empty
        };

        if ( queryBuilder != null )
        {
            if ( !string.IsNullOrEmpty( SelectedRecipientsList.ListQuery ) )
            {
                try
                {
                    // Deserialiseer root RuleModel
                    var rootRule = JsonSerializer.Deserialize<RuleModel>(SelectedRecipientsList.ListQuery);
                    if ( rootRule != null )
                    {
                        // Force AND op alle regels
                        ForceAndCondition( rootRule );

                        // Pak child rules als die bestaan, anders rootRule zelf
                        if ( rootRule.Rules != null && rootRule.Rules.Any() )
                            queryBuilder.SetRules( rootRule.Rules );
                        else
                            queryBuilder.SetRules( new List<RuleModel> { rootRule } );
                    }
                    else
                    {
                        queryBuilder.Reset();
                    }
                }
                catch
                {
                    queryBuilder.Reset();
                }
            }
            else
            {
                // Nog geen ListQuery → leegmaken
                queryBuilder.Reset();
            }
        }

        await InvokeAsync( StateHasChanged );
    }

    /// <summary>
    /// Loads a RuleModel from JSON into the QueryBuilder.
    /// If JSON is null/invalid, resets QueryBuilder.
    /// </summary>
    public static void LoadRulesFromJson( SfQueryBuilder<RuleModel> queryBuilder, string json )
    {
        if ( queryBuilder == null )
        {
            // Niks doen, kan geen regels zetten
            return;
        }

        if ( string.IsNullOrEmpty( json ) )
        {
            queryBuilder.Reset();
            return;
        }

        try
        {
            // Always deserialize to a single RuleModel
            var rootRule = JsonSerializer.Deserialize<RuleModel>(json);

            if ( rootRule != null )
            {
                // Force AND bij laden
                ForceAndCondition( rootRule );

                if ( rootRule.Rules != null && rootRule.Rules.Any() )
                    queryBuilder.SetRules( rootRule.Rules );
                else
                    queryBuilder.SetRules( new List<RuleModel> { rootRule } );
            }
            else
            {
                queryBuilder.Reset();
            }
        }
        catch
        {
            queryBuilder.Reset();
        }
    }

    private async Task LoadRulesAsync( string? json )
    {
        if ( queryBuilder is null )
            return;

        if ( string.IsNullOrWhiteSpace( json ) )
        {
            queryBuilder.Reset();
            return;
        }

        try
        {
            var rulesList = JsonSerializer.Deserialize<List<RuleModel>>(json);

            if ( rulesList != null )
            {
                queryBuilder.SetRules( rulesList );
                return;
            }
            else
            {
                queryBuilder.Reset();
            }
        }
        catch
        {
            queryBuilder.Reset();
        }

        await InvokeAsync( StateHasChanged );
    }

    protected override async Task OnAfterRenderAsync( bool firstRender )
    {
        if ( firstRender )
        {
            await UpdateVisibleRowCountAsync();
        }
    }

    private async Task UpdateVisibleRowCountAsync()
    {
        if ( GridRef is not null )
        {
            var records = await GridRef.GetCurrentViewRecordsAsync();
            await Task.Delay( 150 );
            VisibleRowCount = records?.Count ?? 0;
            StateHasChanged();
        }
    }

    public async Task OnInput( InputEventArgs args )
