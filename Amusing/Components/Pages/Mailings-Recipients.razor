@page "/Recipients"
@using Amusing.Models
@using Amusing.Services
@using Amusing.Helpers
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@using System.ComponentModel.DataAnnotations
@using Syncfusion.Blazor.Notifications
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.QueryBuilder
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.SplitButtons
@using System.Dynamic
@using System.Text.Json
@using System.Text.Json.Serialization

@inherits MailingsRecipientsBase

@if ( IsLoading )
{
    <div class="text-center p-2">
        <SfSpinner CssClass="e-spin-center" />
        <p>@PageName worden geladen...</p>
    </div>
}
else
{
    <div class="page-container">
        <!-- Static detail fields-->
        <div class="fixed-header">
            <SfRadioButton Label="Groepen" Name="source" Value="groups" TChecked="string" @onchange="OnSourceChange" @bind-Checked="SourceChecked"></SfRadioButton>
            <SfRadioButton Label="Personen" Name="source" Value="persons" TChecked="string" @onchange="OnSourceChange" @bind-Checked="SourceChecked"></SfRadioButton>

            <div class="spacer-small"></div>
            <SfTextBox Placeholder="Lijstnaam" FloatLabelType="FloatLabelType.Always" Width="300px" @bind-Value="SelectedRecipientsList.ListName" />


            @if (SourceChecked == "groups")
            {
                <h5>Groepen</h5>
                @if ( !FestivalSelected && HasActiveRules )
                {
                    <div class="alert alert-warning" role="alert">
                        <strong>Let op:</strong> de gekozen filterregels geven pas een betrouwbare lijst
                        wanneer eerst één of meerdere festivals zijn geselecteerd.
                    </div>
                }
            }
            else
            {
                <h5>Personen</h5>
            }
            <SfQueryBuilder TValue="RuleModel" @ref="personsQueryBuilder" Width="80%" MaxGroupCount="0">
                <QueryBuilderEvents TValue="RuleModel" Changed="OnOueryChanged" />
                <QueryBuilderColumns>
                    <QueryBuilderColumn Field="Festival"
                                        Label="Groep is ingeschreven voor ..."
                                        Type="Syncfusion.Blazor.QueryBuilder.ColumnType.String"
                                        Operators="@(new List<OperatorsModel> { new OperatorsModel { Value = "in", Text = "Bevat" } } )">
                        <QueryBuilderTemplates>
                            <ValueTemplate>
                                @{
                                    var selected = context.Value as string[] ?? Array.Empty<string>();
                                }
                                <SfMultiSelect TItem="string"
                                                TValue="string[]"
                                                DataSource="@FestivalValues"
                                                Value="@selected"
                                                Placeholder="Selecteer festivals">
                                    <MultiSelectEvents TValue="string[]" TItem="string" ValueChange="@(( MultiSelectChangeEventArgs<string [ ]> e ) => ChangeValue( e, context ))" />
                                </SfMultiSelect>
                            </ValueTemplate>
                        </QueryBuilderTemplates>
                    </QueryBuilderColumn>

                    <QueryBuilderColumn 
                        Field="IsPaid"
                        Label="Groep heeft betaald" 
                        Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Boolean"
                        Operators="EqualOnlyOperator" />

                    <QueryBuilderColumn 
                        Field="IsSubscribed"
                        Label="Groep is ingeschreven"
                        Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Boolean"
                        Operators="EqualOnlyOperator" />

                    <QueryBuilderColumn Field="IsConfirmed"
                        Label="Groep heeft bevestigd"
                        Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Boolean"
                        Operators="EqualOnlyOperator" />

                    <QueryBuilderColumn Field="IsCanceled" 
                        Label="Groep is afgehaakt" 
                        Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Boolean" 
                        Operators="EqualOnlyOperator" />

                    <QueryBuilderColumn 
                        Field="Dressingroom" 
                        Label="Groep wil kleedkamer" 
                        Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Boolean"
                        Operators="EqualOnlyOperator" />

                    <QueryBuilderColumn 
                        Field="Jury" 
                        Label="Groep wil beoordeling" 
                        Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Boolean" 
                        Operators="EqualOnlyOperator" />

                    <QueryBuilderColumn 
                        Field="Singers" 
                        Label="Aantal zangers" 
                        Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Number" 
                        Operators="NumberOperator" />

                    <QueryBuilderColumn Field="Role"
                        Label="Persoon met de rol..."
                        Type="Syncfusion.Blazor.QueryBuilder.ColumnType.String"
                        Operators="@(new List<OperatorsModel> { new OperatorsModel { Value = "in", Text = "Bevat" } } )">
                            <QueryBuilderTemplates>
                                <ValueTemplate>
                                    @{
                                        var selected = context.Value as string[] ?? Array.Empty<string>();
                                    }
                                    <SfMultiSelect TItem="string"
                                    TValue="string[]"
                                    DataSource="@PersonRoles"
                                    Value="@selected"
                                    Placeholder="Selecteer rollen">
                                        <MultiSelectEvents TValue="string[]" TItem="string" ValueChange="@(( MultiSelectChangeEventArgs<string [ ]> e ) => ChangeValue( e, context ))" />
                                    </SfMultiSelect>
                                </ValueTemplate>
                            </QueryBuilderTemplates>
                        </QueryBuilderColumn>

                    <QueryBuilderColumn 
                        Field="Infomailing" 
                        Label="Persoon wil Infomailing" 
                        Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Boolean" 
                        Operators="EqualOnlyOperator" />

                    <QueryBuilderColumn Field="Volunteer"
                        Label="Persoon is vrijwilliger voor festival..."
                        Type="Syncfusion.Blazor.QueryBuilder.ColumnType.String"
                        Operators="@(new List<OperatorsModel> { new OperatorsModel { Value = "in", Text = "Bevat" } } )">
                            <QueryBuilderTemplates>
                                <ValueTemplate>
                                    @{
                                        var selected = context.Value as string[] ?? Array.Empty<string>();
                                    }
                                    <SfMultiSelect TItem="string"
                                    TValue="string[]"
                                    DataSource="@FestivalValues"
                                    Value="@selected"
                                    Placeholder="Selecteer festivals (vrijwilliger)">
                                        <MultiSelectEvents TValue="string[]" TItem="string" ValueChange="@(( MultiSelectChangeEventArgs<string [ ]> e ) => ChangeValue( e, context ))" />
                                    </SfMultiSelect>
                                </ValueTemplate>
                            </QueryBuilderTemplates>
                    </QueryBuilderColumn>
                </QueryBuilderColumns>
             </SfQueryBuilder>

            <!-- Toolbar -->
            <div style="overflow-x:auto; padding-left: 2px; padding-right: 2px">
                <SfToolbar Width="870px">
                    <ToolbarItems>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn"
                                        @onclick="Save"
                                        title="Bewaar de gebruiker">
                                    <img src="icons/button-save.svg" class="icon" alt="SAVE" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn" @onclick="AddNew" title="Voeg een nieuw gebruiker toe">
                                    <img src="icons/button-add.svg" class="icon" alt="ADD" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn" @onclick="Delete" title="verwijder de geselecteerde gebruiker">
                                    <img src="icons/button-del.svg" class="icon" alt="DELETE" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Separator"/>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn" @onclick="ExportToExcel" title="Exporteer naar een Excel bestand">
                                    <img src="icons/excel.svg" class="icon" alt="Excel" />
                                </button>
                            </Template>
                        </ToolbarItem>

                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn" @onclick="ExportToCsv" title="Exporteer naar een CSV bestand">
                                    <img src="icons/csv.svg" class="icon" alt="CSV" />
                                </button>
                            </Template>
                        </ToolbarItem>

                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn" @onclick="ExportToPdf" title="Maak een PDF bestand">
                                    <img src="icons/pdf.svg" class="icon" alt="PDF" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
                            <Template>
                                <span class="toolbar-count">@PageName: @VisibleRowCount</span>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
                            <Template>
                                <SfTextBox Placeholder="Zoek" Input="OnInput"></SfTextBox>
                            </Template>
                        </ToolbarItem>
                    </ToolbarItems>
                </SfToolbar>
            </div>
        </div>

        <div class="spacer-small"></div>

        <!-- Scrollable area for main datagrid -->
        <div class="scrollable-content">
            <div style="overflow-x:auto; padding-left: 2px; padding-right: 2px;">
                <SfGrid @ref="GridRef"
                        TValue="RecipientListModel"
                        Width="870"
                        DataSource="@RecipientsList"
                        EnableStickyHeader="true"
                        AllowResizing="true"
                        Height="260px"
                        AllowSorting="true"
                        AllowMultiSorting="true"
                        AllowSelection="true">
                    <GridEvents TValue="RecipientListModel" DataBound="OnGridDataBound" RowSelected="OnRowSelected" />
                    <GridEditSettings AllowAdding="true" NewRowPosition="NewRowPosition.Top"></GridEditSettings>
                    <GridColumns>
                        <GridColumn Field="@nameof(RecipientListModel.ListId)" IsPrimaryKey="true" Visible="false" />
                        <GridColumn Field="@nameof(RecipientListModel.ListName)" HeaderText="Lijst" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="350px" />
                        <GridColumn Field="@nameof(RecipientListModel.ListSourceUI)" HeaderText="Bron" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="100px" />
                        <GridColumn Field="@nameof(RecipientListModel.ListCreated)" HeaderText="Gemaakt" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="120px" />
                        <GridColumn Field="@nameof(RecipientListModel.ListChanged)" HeaderText="Gewijzigd" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="120px" />
                    </GridColumns>
                </SfGrid>
            </div>
        </div>
    </div>
    <SfToast 
        @ref="ToastObj" 
        TimeOut="3000" 
        ShowCloseButton="true" 
        NewestOnTop="true">
        <ToastPosition X="Center" Y="Top"/>
        <ToastEvents Closed="@OnToastClose"></ToastEvents>
    </SfToast>
    
    <!-- Hidden grid used only for export -->
    <SfGrid @ref="HiddenGridRef"
            TValue="ExpandoObject"
            AllowExcelExport="true"
			AllowPdfExport="true"
            DataSource="@DynamicRecipients"
            Width="800px" Height="400px">
        <GridColumns>
            @if ( DynamicRecipients.Any() )
            {
                var firstRow = (IDictionary<string, object>)DynamicRecipients.First();
                foreach ( var key in firstRow.Keys )
                {
                    <GridColumn Field="@key" HeaderText="@TranslateToDutch( key )" TextAlign="TextAlign.Left"></GridColumn>
                }
            }
        </GridColumns>
    </SfGrid>
}