    /// <summary>
    /// Forces all nested RuleSets to AND condition
    /// </summary>
    private static void ForceAndCondition( RuleModel rule )
    {
        if ( rule == null )
            return;

        rule.Condition = "and";

        if ( rule.Rules != null )
        {
            foreach ( var r in rule.Rules )
            {
                ForceAndCondition( r );
            }
        }
    }

    private void onSourceChange( Microsoft.AspNetCore.Components.ChangeEventArgs args )
    {
        var value = args.Value?.ToString() ?? string.Empty;

        SelectedRecipientsList.ListSource = value switch
        {
            "groups" => MailingService.RecipientListSource.Groups,
            "persons" => MailingService.RecipientListSource.Persons,
            _ => MailingService.RecipientListSource.Unknown
        };
    }

    private void EnsureIn( RuleModel rule, Syncfusion.Blazor.QueryBuilder.ColumnType type )
    {
        rule.Operator = "in";
        rule.Type = type.ToString(); // "Number" of "String"
    }

    List<string> InOnlyOperator = new List<string> { "in" };

    List<OperatorsModel> EqualOnlyOperator  = new List<OperatorsModel>
    {
        new OperatorsModel { Value = "equal", Text = "Is gelijk aan" }
    };

    private List<OperatorsModel> StringOperator = new List<OperatorsModel>()
    {
        new OperatorsModel { Value="equal", Text = "Gelijk aan" },
        new OperatorsModel { Value="notequal", Text = "Niet gelijk aan" },
        new OperatorsModel { Value="startswith", Text = "Begint met" },
        new OperatorsModel { Value="endswith", Text = "Eindigt met" },
        new OperatorsModel { Value="contains", Text = "Bevat" }
    };
    private List<OperatorsModel> NumberOperator = new List<OperatorsModel>()
    {
        new OperatorsModel { Value="equal", Text = "Gelijk aan" },
        new OperatorsModel { Value="notequal", Text = "Niet gelijk aan" },
        new OperatorsModel { Value="greaterthan", Text = "Groter dan" },
        new OperatorsModel { Value="greaterthanorequal", Text = "Groter of gelijk aan" },
        new OperatorsModel { Value="lessthan", Text = "Kleiner dan" },
        new OperatorsModel { Value="lessthanorequal", Text = "Kleiner of gelijk aan" },
    };

    private void OnQueryChanged(Syncfusion.Blazor.QueryBuilder.ChangeEventArgs args)
    {
        var rootRules = queryBuilder.GetRules();

        if (rootRules == null || rootRules.Rules == null || !rootRules.Rules.Any())
        {
            // Query nog niet compleet, niks doen
            GeneratedJson = "Nog geen complete query...";
            return;
        }

        foreach (var rule in rootRules.Rules)
        {
            if ((rule.Field == "Festival" || rule.Field == "Role" || rule.Field == "Volunteer")
                && rule.Operator == "in")
            {
                switch (rule.Value)
                {
                    case string s:
                        // convert single string into an array
                        rule.Value = new string[] { s };
                        break;

                    case null:
                        // ensure we have an empty array instead of null
                        rule.Value = Array.Empty<string>();
                        break;
                }
            }
        }

        try
        {
            // Serialize to JSON
            GeneratedJson = JsonSerializer.Serialize(rootRules, new JsonSerializerOptions { WriteIndented = true });
            OldJson = QueryBuilderJsonConverter.NewToOld(queryBuilder);

        }
        catch (Exception ex)
        {
            GeneratedJson = $"Error: {ex.Message}";
        }

        // Alleen boolean gebruiken om te bepalen of festival geselecteerd is
        FestivalSelected = rootRules.Rules.Any(r => r.Field == "Festival" && r.Value is string[] arr && arr.Length > 0);
    }

    private async Task GenerateMailList()
    {
        var rules = queryBuilder.GetRules();

        string queryType = "GetFullPersonsList";

        // Bepaal welke query te gebruiken
        if ( rules.Rules.Any( r => r.Field == "Role" ) )
            queryType = "GetPersonsWithRoleList";
        if ( rules.Rules.Any( r => r.Field == "Festival" ) )
            queryType = "GetPersonsWithRoleList";

        
    }
