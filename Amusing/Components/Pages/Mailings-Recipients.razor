    private void EnsureIn( RuleModel rule, Syncfusion.Blazor.QueryBuilder.ColumnType type )
    {
        rule.Operator = "in";
        rule.Type = type.ToString(); // "Number" of "String"
    }

    List<OperatorsModel> InOnlyOperator  = new List<OperatorsModel>
    {
        new OperatorsModel { Value = "in", Text = "In" }
    };

    List<OperatorsModel> EqualOnlyOperator  = new List<OperatorsModel>
    {
        new OperatorsModel { Value = "equal", Text = "Equal" }
    };

    private async Task GenerateMailList()
    {
        var rules = queryBuilder.GetRules();

        string queryType = "GetFullPersonsList";

        // Bepaal welke query te gebruiken
        if ( rules.Rules.Any( r => r.Field == "Role" ) )
            queryType = "GetPersonsWithRoleList";
        if ( rules.Rules.Any( r => r.Field == "Festival" ) )
            queryType = "GetPersonsWithRoleList";

        
    }
