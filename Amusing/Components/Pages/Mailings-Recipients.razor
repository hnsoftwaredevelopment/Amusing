    public class RuleModelConverter : JsonConverter<RuleModel>
    {
        public override RuleModel Read( ref Utf8JsonReader reader, Type typeToConvert, JsonSerializerOptions options )
        {
            var clone = JsonDocument.ParseValue(ref reader).RootElement;

            var model = JsonSerializer.Deserialize<RuleModel>(clone.GetRawText(), options);

            if ( model?.Value is JsonElement elem )
            {
                if ( elem.ValueKind == JsonValueKind.String )
                    model.Value = elem.GetString();
                else if ( elem.ValueKind == JsonValueKind.True || elem.ValueKind == JsonValueKind.False )
                    model.Value = elem.GetBoolean();
                else if ( elem.ValueKind == JsonValueKind.Array )
                {
                    var values = new List<string>();
                    foreach ( var item in elem.EnumerateArray() )
                    {
                        if ( item.ValueKind == JsonValueKind.String )
                            values.Add( item.GetString() ?? "" );
                    }
                    model.Value = values.ToArray();
                }
            }

            return model!;
        }

        public override void Write( Utf8JsonWriter writer, RuleModel value, JsonSerializerOptions options )
        {
            JsonSerializer.Serialize( writer, ( object ) value, options );
        }
    }

