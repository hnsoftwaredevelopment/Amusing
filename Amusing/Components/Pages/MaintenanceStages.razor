@page "/Maintenance-Stages"
@using Amusing.Models
@using Amusing.Services
@using Bit.BlazorUI
@using Bit.BlazorUI.Extras
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@using System.ComponentModel.DataAnnotations
@using Syncfusion.Blazor.Popups

@if (IsLoading)
{
    <div class="text-center p-2">
        <SfSpinner CssClass="e-spin-center" />
        <p>@FileName worden geladen...</p>
    </div>
}
else
{
    <div class="page-container">
        <div class="fixed-header">
            <h3>Onderhoud @FileName</h3>
            @* Detail Fields *@
            <SfDataForm Model="SelectedStage" OnValidSubmit="SaveStage" LabelPosition="FormLabelPosition.Top">
                <div class="form-floating-switch">
                    <hr />
                    <SfTextBox @bind-Value="SelectedStage.Naam" Placeholder="Podium naam" FloatLabelType="FloatLabelType.Always" Width="450px" />
                    <SfTooltip ID="CardNumberTooltip"  Target="#CardNumber" Content="Vul een waarde hoger dan 0 in om het podium te activeren" >
                        <SfNumericTextBox ID="CardNumber" @bind-Value="SelectedStage.KaartNummer" Placeholder="Kaartnummer" FloatLabelType="FloatLabelType.Always" Width="160px" />
                    </SfTooltip>
                    <SfComboBox 
                        TValue=string
                            TItem=string 
                            FloatLabelType="FloatLabelType.Always"
                            Placeholder="Binnen of buiten podium"
                            DataSource="@dataStageKind"
                            @bind-Value="@SelectedStage.Soort"
                            Width="180px" />
                    <div />
                    
                    <!-- Tooltip component: target the list item nodes that have a title attribute -->
                    <SfTooltip @ref="TooltipObj" Target=".e-list-item .name[title]"></SfTooltip>
                    
                    <SfComboBox 
                        TValue="string"
                        TItem="StageTypeModel"
                        FloatLabelType="FloatLabelType.Always"
                        Placeholder="Kies een podium type"
                        DataSource="@AvailableStageTypes"
                        @bind-Value="@SelectedStage.Type"
                        Width="450px">

                        <!-- Field mapping voor waarde en tekst -->
                        <ComboBoxFieldSettings Text="ComboBoxDisplayName" Value="Type"></ComboBoxFieldSettings>

                        <!-- Templates zodat je een tooltip kunt tonen -->
                        <ComboBoxTemplates TItem="StageTypeModel">
                            <ItemTemplate Context="stageType">
                                <div class="name" title="@stageType.ComboBoxDisplayName">
                                    @stageType.ComboBoxDisplayName
                                </div>
                            </ItemTemplate>
                        </ComboBoxTemplates>

                        <!-- Events zodat we tooltip kunnen refreshen bij open -->
                        <ComboBoxEvents TValue="string" TItem="StageTypeModel" Opened="OnOpen" OnClose="OnClose"></ComboBoxEvents>
                    </SfComboBox>
                    <hr/>
                    <Syncfusion.Blazor.Calendars.SfTimePicker TValue="TimeOnly" @bind-Value="SelectedStage.Start" Placeholder="Begintijd" Width="150px" FloatLabelType="FloatLabelType.Always" />
                    <Syncfusion.Blazor.Calendars.SfTimePicker TValue="TimeOnly" @bind-Value="SelectedStage.Eind" Placeholder="Eindtijd" Width="150px" FloatLabelType="FloatLabelType.Always" />
                    <Syncfusion.Blazor.Calendars.SfTimePicker TValue="TimeOnly" @bind-Value="SelectedStage.Van" Placeholder="Vrijwilligers vanaf" Width="150px" FloatLabelType="FloatLabelType.Always" />
                    <Syncfusion.Blazor.Calendars.SfTimePicker TValue="TimeOnly" @bind-Value="SelectedStage.Tot" Placeholder="Vrijwilligers tot" Width="150px" FloatLabelType="FloatLabelType.Always" />
                    <hr/>
                    <SfNumericTextBox TValue="int" Min="0" Max="10" @bind-Value="SelectedStage.Kwaliteit" Placeholder="Kwaliteit" Width="150px" FloatLabelType="FloatLabelType.Always" CssClass="e-ntstyle" />
                    <SfNumericTextBox TValue="int" Min="0" @bind-Value="SelectedStage.MaxZangers" Placeholder="Max. aantal zangers" Width="170px" FloatLabelType="FloatLabelType.Always" CssClass="e-ntstyle" />
                    <SfNumericTextBox TValue="int" Min="0" Max="4" @bind-Value="SelectedStage.Vrijwilligers" Placeholder="Vrijwilligers" Width="150px" FloatLabelType="FloatLabelType.Always" CssClass="e-ntstyle" />



                </div>
            </SfDataForm>
            <div class="spacer-large"/>
            <div style="overflow-x:auto; padding-left: 2px; padding-right: 2px">
                <SfToolbar Width="800px">
                    <ToolbarItems>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn"
                                        @onclick="SaveStage"
                                        title="Sla het podium op">
                                    <img src="icons/button-save.svg" class="icon" alt="SAVE" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn" @onclick="AddNewStage" title="Voeg een nieuw podium toe">
                                    <img src="icons/button-add.svg" class="icon" alt="ADD" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn @(SelectedStage?.Aktief == 1 ? "disabled" : "")"
                                        @onclick="DeleteStage"
                                        title="Verwijder geselecteerde podium"
                                        disabled="@(SelectedStage?.Aktief == 1)">
                                    <img src="icons/button-del.svg" class="icon" alt="DEL" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
                            <Template>
                                <span class="toolbar-count">@FileName: @VisibleRowCount</span>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
                            <Template>
                                <SfTextBox Placeholder="Zoek" Input="OnInput"></SfTextBox>
                            </Template>
                        </ToolbarItem>
                    </ToolbarItems>
                </SfToolbar>
            </div>
        </div>

        <div class="scrollable-content">
            @* DataGrid *@ 
            <div class="spacer-small"></div>
            <div style="overflow-x:auto; padding-left: 2px; padding-right: 2px;">
                <SfGrid @ref="GridRef"
                    TValue="StageModel"
                    DataSource="@Stages" 
                    EnableStickyHeader="true"
                    AllowResizing="true" 
                    Height="560px"
                    Width="800px" 
                    AllowSorting="true" 
                    AllowMultiSorting="true"
                    AllowSelection="true">
                    <GridEvents TValue="StageModel" DataBound="OnGridDataBound" RowSelected="OnRowSelected" />

                    <GridColumns>
                        <GridColumn Field="Naam" HeaderText="Naam" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="500px" />
                        <GridColumn Field="Type" HeaderText="Type" TextAlign="TextAlign.Center" AllowSorting=true AllowResizing="true" Width="60px" />
                        <GridColumn Field="Soort" HeaderText="Soort" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="80px" />
                        <GridColumn Field="KaartNummer" HeaderText="Kaart nummer" TextAlign="TextAlign.Right" AllowSorting=true AllowResizing="true" Width="130px" />
                    </GridColumns>
                </SfGrid>
                <div class="spacer-large"></div>
            </div>
        </div>
    </div>
}
