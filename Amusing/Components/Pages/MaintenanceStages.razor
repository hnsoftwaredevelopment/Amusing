@page "/Maintenance-Stages"
@using Amusing.Models
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Popups

@if (IsLoading)
{
    <div class="text-center p-2">
        <SfSpinner />
        <p>@FileName worden geladen...</p>
    </div>
}
else
{
    <div class="page-container">

        <!-- HEADER / EDIT SECTION -->
        <div class="fixed-header">

            <h3>Onderhoud @FileName</h3>

            <EditForm Model="@SelectedStage" OnValidSubmit="SaveStage">

                <div class="form-grid">

                    <div class="form-row-1">
                        <SfTextBox class="col-span-2"
                                   @bind-Value="StageNaam"
                                   Placeholder="Podium naam"
                                   FloatLabelType="FloatLabelType.Always" />

                        <SfNumericTextBox class="col-span-1"
                                          @bind-Value="StageKaartNummer"
                                          Placeholder="Kaartnummer"
                                          Width="150px"
                                          FloatLabelType="FloatLabelType.Always" />

                        <SfComboBox class="col-span-1"
                                    TValue="string"
                                    TItem="string"
                                    DataSource="@dataStageKind"
                                    @bind-Value="@StageSoort"
                                    Width="170px"
                                    Placeholder="Binnen of buiten podium"
                                    FloatLabelType="FloatLabelType.Always" />

                        <SfComboBox class="col-span-1"
                                    TValue="string"
                                    TItem="StageTypeModel"
                                    DataSource="@AvailableStageTypes"
                                    @bind-Value="@StageType"
                                    Width="150px"
                                    Placeholder="Kies podium type"
                                    FloatLabelType="FloatLabelType.Always"
                                    AllowFiltering="true"
                                    ShowClearButton="true">

                            <ComboBoxFieldSettings Text="ComboBoxDisplayName" Value="Type"></ComboBoxFieldSettings>
                        </SfComboBox>
                    </div>

                    <div class="form-row-2">
                        <SfTimePicker class="col-span-1" @bind-Value="StageStart" Placeholder="Start" FloatLabelType="FloatLabelType.Always" />
                        <SfTimePicker class="col-span-1" @bind-Value="StageEind" Placeholder="Eind" FloatLabelType="FloatLabelType.Always" />
                        <SfTimePicker class="col-span-1" @bind-Value="StageVan" Placeholder="Vrijw. van" FloatLabelType="FloatLabelType.Always" />
                        <SfTimePicker class="col-span-1" @bind-Value="StageTot" Placeholder="Vrijw. tot" FloatLabelType="FloatLabelType.Always" />
                    </div>

                    <div class="form-row-3">
                        <SfNumericTextBox class="col-span-1" @bind-Value="StageKwaliteit" Placeholder="Kwaliteit" FloatLabelType="FloatLabelType.Always" />
                        <SfNumericTextBox class="col-span-1" @bind-Value="StageMaxZangers" Placeholder="Max zangers" FloatLabelType="FloatLabelType.Always" />
                        <SfNumericTextBox class="col-span-2" @bind-Value="StageVrijwilligers" Placeholder="Vrijwilligers" FloatLabelType="FloatLabelType.Always" />
                    </div>
                </div>

                <!-- TOOLBAR -->
                <div class="toolbar-row">
                    <SfToolbar Width="800px">
                        <ToolbarItems>
                            <ToolbarItem Type="ItemType.Button">
                                <Template>
                                    <button class="custom-toolbar-btn" @onclick="SaveStage" title="Sla het podium op">
                                        <img src="icons/button-save.svg" class="icon" alt="SAVE" />
                                    </button>
                                </Template>
                            </ToolbarItem>

                            <ToolbarItem Type="ItemType.Button">
                                <Template>
                                    <button class="custom-toolbar-btn" @onclick="AddNewStage" title="Voeg een nieuw podium toe">
                                        <img src="icons/button-add.svg" class="icon" alt="ADD" />
                                    </button>
                                </Template>
                            </ToolbarItem>

                            <ToolbarItem Type="ItemType.Button">
                                <Template>
                                    <button class="custom-toolbar-btn @(SelectedStage?.Aktief == 1 ? "disabled" : "")" @onclick="DeleteStage" title="Verwijder geselecteerde podium" disabled="@(SelectedStage?.Aktief == 1)">
                                        <img src="icons/button-del.svg" class="icon" alt="DEL" />
                                    </button>
                                </Template>
                            </ToolbarItem>

                            <ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
                                <Template>
                                    <span class="toolbar-count">@FileName: @VisibleRowCount</span>
                                </Template>
                            </ToolbarItem>

                            <ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
                                <Template>
                                    <SfTextBox
                                        Placeholder="Zoek" 
                                        Input="OnSearchInput">
                                    </SfTextBox>
                                </Template>
                            </ToolbarItem>
                        </ToolbarItems>
                    </SfToolbar>
                </div>
            </EditForm>
        </div>

        <!-- GRID -->
        <div class="scrollable-content">

            <SfGrid @ref="GridRef" 
                    TValue="StageModel"
                    DataSource="@Stages"
                    Height="560px"
                    AllowSorting="true"
                    AllowSelection="true">

                <GridEvents TValue="StageModel"
                            RowSelected="OnRowSelected"
                            DataBound="OnGridDataBound" />

                <GridColumns>
                    <GridColumn Field="Naam" HeaderText="Naam" Width="300" />
                    <GridColumn Field="Type" HeaderText="Type" Width="80" />
                    <GridColumn Field="Soort" HeaderText="Soort" Width="120" />
                    <GridColumn Field="KaartNummer" HeaderText="Kaart" Width="100" />
                </GridColumns>

            </SfGrid>

        </div>

    </div>
}