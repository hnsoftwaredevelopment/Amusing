@page "/Maintenance-Users"
@using Amusing.Models
@using Amusing.Services
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@using System.ComponentModel.DataAnnotations
@using Syncfusion.Blazor.Notifications
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.RichTextEditor
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.SplitButtons
@using System.Text.Json

@inject UserService UserService;
@inject CustomAuthenticationService CustomAuthenticationService;

@inject NavigationManager NavManager
@inject IJSRuntime JS

@if (IsLoading)
{
    <div class="text-center p-2">
        <SfSpinner CssClass="e-spin-center" />
        <p>@FileName worden geladen...</p>
    </div>
}
else
{
    <div class="page-container">
        <!-- Static detail fields-->
        <div class="fixed-header">
            <h3>Onderhoud @FileName</h3>
            <EditForm EditContext="@editContext">

                <div class="form-grid"> 
                    <div class="form-left"> 
                        <div class="form-row" style="display:flex; align-items:flex-end; gap:8px;">
                            <SfTextBox Placeholder="Gebruikersnaam" FloatLabelType="FloatLabelType.Always" Width="120px" @bind-Value="SelectedUser.Username" />
                            <SfComboBox TValue="string" TItem="UserRoles" FloatLabelType="FloatLabelType.Always"
                                        Placeholder="Rol" DataSource="@Roles" Width="170px" @bind-Value="SelectedUser.Role" >
                                <ComboBoxFieldSettings Value="Role" Text="Role"></ComboBoxFieldSettings>
                            </SfComboBox>
                            <div> 
                            </div>
                        </div>

                        <div class="form-row" style="display:flex; align-items:flex-end; gap:8px;">
                            <SfToast @ref="ToastObj" Title="Wachtwoord gewijzigd" Content="Gewijzigde wachtwoord opgeslagen" Timeout="3000" ShowProgressBar="true" >
                                <ToastPosition X="300" Y="150"></ToastPosition>
                            </SfToast>
                            <SfTextBox Placeholder="Wachtwoord" FloatLabelType="FloatLabelType.Always" Width="200px" @bind-Value="SelectedUser.Password"/>
                            @if (SelectedUser.UserId != 0)
                            {
                                <button class="custom-toolbar-btn" @onclick="SavePassword" title="Sla het wachtwoord op">
                                    <img src="icons/button-savepassword.svg" class="icon" alt="PW" />
                                </button>
                            }
                        </div>
                    </div>
                    @if ( SelectedUser.Username == "" || SelectedUser.Role == "" || ( SelectedUser.Password == "" && SelectedUser.UserId == 0 ) )
                    {
                        <div class="form-middle">
                                <ul>
                                    @if ( SelectedUser.Username == "" )
                                    {
                                        <li class="text-danger">Gebruikersnaam mag niet leeg zijn</li>
                                    }
                                    @if ( SelectedUser.Role == "" )
                                    {
                                        <li class="text-danger">Rol mag niet leeg zijn</li>
                                    }
                                    @if ( SelectedUser.Password == "" && SelectedUser.UserId == 0 )
                                    {
                                        <li class="text-danger">Wachtwoord mag niet leeg zijn voor een nieuwe gebruiker</li>
                                    }
                                </ul>
                        </div>
                    }
                    <div class="form-right">
                        <div></div>
                    </div>
                </div>
            </EditForm>

            <div class="spacer-small"></div>

            <!-- Toolbar -->
            <div style="overflow-x:auto; padding-left: 2px; padding-right: 2px">
                <SfToolbar Width="870px">
                    <ToolbarItems>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn"
                                        @onclick="Save"
                                        title="Bewaar de gebruiker">
                                    <img src="icons/button-save.svg" class="icon" alt="SAVE" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn" @onclick="AddNew" title="Voeg een nieuw gebruiker toe">
                                    <img src="icons/button-add.svg" class="icon" alt="ADD" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn" @onclick="Delete" title="verwijder de geselecteerde gebruiker">
                                    <img src="icons/button-del.svg" class="icon" alt="DELETE" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
                            <Template>
                                <span class="toolbar-count">@FileName: @VisibleRowCount</span>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
                            <Template>
                                <SfTextBox Placeholder="Zoek" Input="OnInput"></SfTextBox>
                            </Template>
                        </ToolbarItem>
                    </ToolbarItems>
                </SfToolbar>
            </div>
        </div>

        <div class="spacer-small"></div>

        <!-- Scrollable area for main datagrid -->
        <div class="scrollable-content">
            <div style="overflow-x:auto; padding-left: 2px; padding-right: 2px;">
                <SfGrid @ref="GridRef"
                        TValue="UserModel"
                        Width="870"
                        DataSource="@Users"
                        EnableStickyHeader="true"
                        AllowResizing="true"
                        Height="260px"
                        AllowSorting="true"
                        AllowMultiSorting="true"
                        AllowSelection="true">
                    <GridEvents TValue="UserModel" DataBound="OnGridDataBound" RowSelected="OnRowSelected" />
                    <GridEditSettings AllowAdding="true" NewRowPosition="NewRowPosition.Top"></GridEditSettings>
                    <GridColumns>
                        <GridColumn Field="UserId" IsPrimaryKey="true" Visible="false" />
                        <GridColumn Field="Username" HeaderText="Gebruikersnaam" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="120px" />
                        <GridColumn Field="Role" HeaderText="Rol" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="120px" />
                        <GridColumn Field="LastLoginDate" HeaderText="Laatste inlog" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="120px" />
                    </GridColumns>
                </SfGrid>
            </div> 
        </div>
    </div>
}

@code {
    private bool _initialLoadDone = false;
    private bool IsLoading = false;
    private UserModel? SelectedUser;
    private int VisibleRowCount = 0;
    private EditContext? editContext;
    private List<UserModel> Users = [];
    private SfGrid<UserModel>? GridRef;
    private SfToast ToastObj;
    private string FileName = "Gebruikers";
    public string HashedPassword { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;

        Users = await UserService.GetAllUsersAsync();

        SelectedUser = Users.FirstOrDefault();
        editContext = new EditContext( SelectedUser );

        IsLoading = false;
    }

    private async Task OnGridDataBound()
    {
        if ( !_initialLoadDone && Users?.Any() == true )
        {
            _initialLoadDone = true;
            await UpdateVisibleRowCountAsync();
            await GridRef.SelectRowAsync( 0 );
        }
    }

    private void OnRowSelected( RowSelectEventArgs<UserModel> args )
    {
        SelectedUser = args.Data;
        editContext = new EditContext(SelectedUser);
        StateHasChanged();
    }

    private async Task UpdateVisibleRowCountAsync()
    {
        if ( GridRef is not null )
        {
            var records = await GridRef.GetCurrentViewRecordsAsync();
            await Task.Delay( 150 );
            VisibleRowCount = records?.Count ?? 0;
            StateHasChanged();
        }
    }

    public async Task OnInput( InputEventArgs args )
    {
        await GridRef.SearchAsync( args.Value );

        await Task.Delay( 50 );
        await UpdateVisibleRowCountAsync();
    }

    private async Task Save()
    {
        if ( SelectedUser is null )
            return;

        if ( SelectedUser.UserId != 0 )
        {
            await UserService.UpdateUserAsync( SelectedUser );
        }
        else
        {
            // Save the new Person and get the new Person Id
            SelectedUser.Password = CustomAuthenticationService.ComputeMd5Hash( SelectedUser.Password ); 

            var savedId = await UserService.AddUserAsync(SelectedUser);

            // Refresh the list
            Users = await UserService.GetAllUsersAsync();
            await Task.Delay( 50 );
            await GridRef.Refresh();
            await UpdateVisibleRowCountAsync();


            // Search the modified record
            var index = Users.FindIndex(s => s.UserId == savedId);
            if ( index >= 0 )
            {
                SelectedUser = Users [ index ];
                await GridRef.SelectRowAsync( index );
            }

            if (SelectedUser.Password != "")
            {

            }
        }
    }

    private async Task AddNew()
    {
        var newUser = new UserModel
        {
            UserId = 0,
            Username = "",
            Password = "",
            Role =  ""
        };

        await GridRef.AddRecordAsync( newUser, 0 );
        await GridRef.SelectRowAsync( 0 );

        SelectedUser = newUser;
        editContext = new EditContext(SelectedUser);
        StateHasChanged();
    }

    private async Task SavePassword()
    {
        if (!string.IsNullOrWhiteSpace(SelectedUser.Password))
        {
            SelectedUser.Password = CustomAuthenticationService.ComputeMd5Hash( SelectedUser.Password );

            await UserService.UpdatePasswordAsync( SelectedUser );

            SelectedUser.Password = string.Empty;

            await ToastObj.ShowAsync();
        }
    }

    private async Task Delete()
    {
        if ( SelectedUser.UserId == 0 )
            return;

        await UserService.DeleteUserAsync( SelectedUser );

        // Refresh the list
        Users = await UserService.GetAllUsersAsync();
        await Task.Delay( 50 );
        await GridRef.Refresh();
        await UpdateVisibleRowCountAsync();
    }
    private List<UserRoles> Roles = 
    [
        new UserRoles() { Role= "admin" },
        new UserRoles() { Role= "algemeen" },
        new UserRoles() { Role= "penningmeester" },
        new UserRoles() { Role= "contactpersoon" },
        new UserRoles() { Role= "vrijwilligers" },
        new UserRoles() { Role= "pr" }
    ];

}
