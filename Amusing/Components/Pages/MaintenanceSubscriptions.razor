@page "/Maintenance-Subscriptions"
@using Amusing.Models
@using Amusing.Services
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Popups
@using System.ComponentModel.DataAnnotations

<AuthorizeView>
	<Authorized>
		<h3>Beheer Inschrijvingen per Amusing editie</h3>
		<p />
		<SfComboBox TValue="string"
					TItem="Edition"
					Placeholder="Kies een editie"
					ValueChanged="OnEditionChanged"
					DataSource="@Editions"
					Width="150px">
			<ComboBoxFieldSettings Value="ID" Text="Text"></ComboBoxFieldSettings>
		</SfComboBox>
		<p />

		@if ( SelectedEditionId != null )
		{
			<div class="col-lg-12 control-section">
				<div class="content-wrapper">
					<div class="row">
						<SfGrid @ref="GridRef"
								TItem="Registration" DataSource="@RegistrationList"
								Width="100%"
								AllowExcelExport="true" AllowPdfExport="true"
								AllowSorting="true"
								AllowMultiSorting="true">

							<SfToolbar>
								<ToolbarItems>
									<ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
										<Template>
											<span class="toolbar-count">Inschrijvingen: @VisibleRowCount</span>
										</Template>
									</ToolbarItem>

									<ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
										<Template>
											<SfTextBox Placeholder="Zoek" Input="OnInput"></SfTextBox>
										</Template>
									</ToolbarItem>
								</ToolbarItems>
							</SfToolbar>

							<GridTemplates>
								<EmptyRecordTemplate Context="data">
									<div class="emptyRecordTemplate text-center">
										<span>
											@( ( SelectedEditionId == null )
																					? "Geen festival editie geselecteerd"
																					: $"Geen inschrijvingen gevonden voor editie {SelectedEditionText}" )
										</span>
									</div>
								</EmptyRecordTemplate>
							</GridTemplates>

							<GridColumns>
								<GridColumn Field="Datum" HeaderText="Datum" TextAlign="TextAlign.Center" Type="ColumnType.Date" Format="dd-MM-yyyy" Width="90"></GridColumn>
								<GridColumn Field="Naam" HeaderText="Naam"></GridColumn>
								<GridColumn Field="Stad" HeaderText="Stad" Width="180"></GridColumn>
								<GridColumn Field="Podium" HeaderText="Podium" Width="70" TextAlign="TextAlign.Center"></GridColumn>
								<GridColumn Field="Zangers" HeaderText="Zangers" TextAlign="TextAlign.Center" Width="70"></GridColumn>
								<GridColumn HeaderText="Betaald" Width="180" TextAlign="TextAlign.Center">
									<Template Context="regObj">
									@{
										var data = (RegistrationModel)regObj;

										bool showPayButton = data.Betaald == "Nee" && data.Afgehaakt == "Nee";
										bool showReverseButton = data.Betaald == "Ja"; // altijd tonen als er betaald is
									}

									@if (showPayButton)
									{
										<button class="btn btn-blue" @onclick="() => OpenPaymentDialog(data)">Betaling</button>
									}
									else if (showReverseButton)
									{
										<button class="btn btn-red" @onclick="() => TogglePaymentAsync(data)">Gestorneerd</button>
									}
									</Template>
								</GridColumn>

								<SfDialog Width="400px"
									  IsModal="true"
									  @bind-Visible="showPaymentDialog"
									  ShowCloseIcon="true"
									  Header="Betaling registreren">

								<DialogContentTemplate>
									<div class="p-3">
										<p>Selecteer de betaaldatum:</p>
										<SfDatePicker TValue="DateTime?" 
													  @bind-Value="selectedDate" 
													  Placeholder="Kies een datum...">
										</SfDatePicker>
									</div>
								</DialogContentTemplate>

								<DialogFooterTemplate>
									<div class="flex justify-end gap-2">
										<button class="btn btn-green" @onclick="ConfirmPaymentDateAsync">Opslaan</button>
										<button class="btn btn-gray" @onclick="ClosePaymentDialog">Annuleren</button>
									</div>
								</DialogFooterTemplate>

							</SfDialog>
								<GridColumn Field="Bevestigd" HeaderText="Bevestigd" Width="80" TextAlign="TextAlign.Center"></GridColumn>
								<GridColumn Field="Kleedkamer" HeaderText="Kleedkamer" Width="100" TextAlign="TextAlign.Center"></GridColumn>
								<GridColumn Field="Binnen" HeaderText="Binnen" Width="70" TextAlign="TextAlign.Center"></GridColumn>
								<GridColumn Field="Buiten" HeaderText="Buiten" Width="70" TextAlign="TextAlign.Center"></GridColumn>
								<GridColumn HeaderText="Afgehaakt" Width="120" TextAlign="TextAlign.Center">
									<Template Context="regObj">
										@{
											var data = (RegistrationModel)regObj;
										}

										@if ( data.Afgehaakt == "Nee" )
										{
											<button class="btn btn-red" @onclick="() => ToggleDropOutAsync( data )">Haakt af</button>
										}
										else
										{
											<button class="btn btn-blue" @onclick="() => ToggleDropOutAsync( data )">Haakt aan</button>
										}
									</Template>
								</GridColumn>
							</GridColumns>
						</SfGrid>
					</div>
				</div>
			</div>
		}
	</Authorized>
	<NotAuthorized>
		<p class="text-danger">Je hebt alleen toegang tot deze pagina wanneer je bent ingelogt</p>
	</NotAuthorized>
</AuthorizeView>
