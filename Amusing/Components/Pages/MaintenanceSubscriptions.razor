@page "/Maintenance-Subscriptions"
@page "/Overview-Registrations"
@using Amusing.Models
@using Amusing.Services
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Popups
@using System.ComponentModel.DataAnnotations

<AuthorizeView>
	<Authorized>
		<div class="page-container maintenance-page">
			<div class="fixed-header maintenance-page__header">
				<h3>Beheer Inschrijvingen per Amusing editie</h3>
				<p />
				<SfComboBox TValue="string"
							TItem="Edition"
							Placeholder="Kies een editie"
							Value="@SelectedEditionId"
							ValueChanged="OnEditionChanged"
							DataSource="@Editions"
							Width="150px">
					<ComboBoxFieldSettings Value="ID" Text="Text"></ComboBoxFieldSettings>
				</SfComboBox>
			</div>

			@if ( SelectedEditionId != null )
			{
                <a class="btn btn-outline-primary" href="@($"/Maintenance-Waitlist?festival={SelectedEditionId}")">Wachtlijst beheren</a>
				<div class="scrollable-content maintenance-page__content">
					<div class="maintenance-grid-shell maintenance-grid-shell--fit">
						<SfGrid @ref="GridRef"
								TItem="Registration" DataSource="@RegistrationList"
								Width="100%" Height="100%"
								CssClass="maintenance-grid"
								EnableStickyHeader="true"
								AllowExcelExport="true" AllowPdfExport="true"
								AllowSorting="true"
								AllowMultiSorting="true">

							<GridEvents TValue="RegistrationModel" OnRecordDoubleClick="OnRegistrationDoubleClick" DataBound="UpdateVisibleRowCount" />

							<SfToolbar>
								<ToolbarItems>
<ToolbarItem Type="ItemType.Button"><Template><button type="button" class="custom-toolbar-btn" disabled="@planningExportBusy" @onclick="ExportPlanningAsync" title="Exporteer planning naar Excel"><img src="icons/excel.svg" class="icon" alt="Excel" /></button></Template></ToolbarItem>
<ToolbarItem Type="ItemType.Button"><Template><button type="button" class="custom-toolbar-btn" @onclick="ExportToCsv" title="Exporteer naar Csv"><img src="icons/csv.svg" class="icon" alt="Csv" /></button></Template></ToolbarItem>
<ToolbarItem Type="ItemType.Button"><Template><button type="button" class="custom-toolbar-btn" @onclick="ExportToPdf" title="Exporteer naar Pdf"><img src="icons/pdf.svg" class="icon" alt="Pdf" /></button></Template></ToolbarItem>

									<ToolbarItem Type="ItemType.Input" Align="ItemAlign.Left">
										<Template>
											<button class="btn btn-blue"
													@onclick="OpenAddGroupDialog"
													hidden="@(!CanAddGroup)">
												Koor toevoegen
											</button>
										</Template>
									</ToolbarItem>

									<ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
										<Template>
											<span class="toolbar-count">Inschrijvingen: @VisibleRowCount</span>
										</Template>
									</ToolbarItem>

									<ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
										<Template>
											<SfTextBox Placeholder="Zoek" Input="OnInput"></SfTextBox>
										</Template>
									</ToolbarItem>
								</ToolbarItems>
							</SfToolbar>

							<GridTemplates>
								<EmptyRecordTemplate Context="data">
									<div class="emptyRecordTemplate text-center">
										<span>
											@( ( SelectedEditionId == null )
																					? "Geen festival editie geselecteerd"
																					: $"Geen inschrijvingen gevonden voor editie {SelectedEditionText}" )
										</span>
									</div>
								</EmptyRecordTemplate>
							</GridTemplates>

							<GridColumns>
								<GridColumn Field="Datum" HeaderText="Datum" TextAlign="TextAlign.Center" Type="ColumnType.Date" Format="dd-MM-yyyy" Width="90"></GridColumn>
								<GridColumn Field="Naam" HeaderText="Naam" Width="200"></GridColumn>
								<GridColumn Field="Stad" HeaderText="Stad" Width="180"></GridColumn>
								<GridColumn Field="AvailableFrom" HeaderText="Beschikbaar van" Width="135"><Template Context="row"><button type="button" class="btn btn-link p-0" @onclick="() => availabilityDialog.OpenAsync(((RegistrationModel)row).FestivalId,((RegistrationModel)row).GroepId)">@(((RegistrationModel)row).AvailableFrom)</button></Template></GridColumn>
                                <GridColumn Field="AvailableUntil" HeaderText="Beschikbaar tot" Width="135"><Template Context="row"><button type="button" class="btn btn-link p-0" @onclick="() => availabilityDialog.OpenAsync(((RegistrationModel)row).FestivalId,((RegistrationModel)row).GroepId)">@(((RegistrationModel)row).AvailableUntil)</button></Template></GridColumn>
                                <GridColumn Field="Podium" HeaderText="Podium" Width="70" TextAlign="TextAlign.Center"></GridColumn>
								<GridColumn Field="Zangers" HeaderText="Zangers" TextAlign="TextAlign.Center" Width="70"></GridColumn>

 <GridColumn Field="Genre" HeaderText="Genre" Width="120" />
 <GridColumn Field="Waitlisted" HeaderText="Wachtlijst" Width="105"><Template Context="row"><button type="button" class="btn btn-link p-0" disabled="@(waitlistBusy || pendingWaitlistPlacement is not null)" title="@(((RegistrationModel)row).Waitlisted ? "Koor toelaten tot het festival en berichten versturen" : "Koor op de wachtlijst plaatsen")" @onclick="() => ToggleWaitlistAsync((RegistrationModel)row)">@(((RegistrationModel)row).Waitlisted ? "Ja" : "Nee")</button></Template></GridColumn>
 <GridColumn Field="TeBetalen" HeaderText="Te betalen (€)" Format="N2" Width="130" TextAlign="TextAlign.Right" />
  <GridColumn Field="Factuurdatum" HeaderText="Factuurdatum" Type="ColumnType.Date" Format="dd-MM-yyyy" Width="125"><Template Context="row"><Amusing.Components.RegistrationInvoiceDate Row="@((RegistrationModel)row)" /></Template></GridColumn>
 <GridColumn Field="BetaaldBedrag" HeaderText="Betaald" Format="N2" TextAlign="TextAlign.Right" Width="110"><Template Context="row"><button type="button" class="btn btn-link p-0 @(((RegistrationModel)row).AfwijkendBetaaldBedrag?"text-danger fw-semibold":"")" title="Betaaldatum en bedrag wijzigen" @onclick="() => EditRegistrationAsync((RegistrationModel)row,RegistrationEditAction.Payment)">@(((RegistrationModel)row).BetaaldTekst)</button></Template></GridColumn>
 <GridColumn Field="Betaaldatum" HeaderText="Betaaldatum" Type="ColumnType.Date" Format="dd-MM-yyyy" Width="125" />
 <GridColumn Field="Bevestigingsdatum" HeaderText="Bevestigd" Width="100"><Template Context="row"><button class="btn btn-link p-0" @onclick="() => EditRegistrationAsync((RegistrationModel)row,RegistrationEditAction.Confirmation)">@(((RegistrationModel)row).BevestigdTekst)</button></Template></GridColumn>
 <GridColumn Field="AcapellaBattle" HeaderText="AcapellaBattle" Width="120" />

 <GridColumn Field="Binnen" HeaderText="Binnen" Width="70" TextAlign="TextAlign.Center" />
 <GridColumn Field="Buiten" HeaderText="Buiten" Width="70" TextAlign="TextAlign.Center" />
 <GridColumn Field="Afhaakdatum" HeaderText="Afgehaakt" Width="110"><Template Context="row"><button class="btn btn-link p-0" @onclick="() => EditRegistrationAsync((RegistrationModel)row,RegistrationEditAction.Cancellation)">@(((RegistrationModel)row).AfgehaaktTekst)</button></Template></GridColumn>
 <GridColumn HeaderText="Wijzigen" Width="100"><Template Context="row"><button type="button" class="btn btn-outline-primary btn-sm" title="Inschrijving wijzigen" @onclick="() => EditRegistrationAsync((RegistrationModel)row)"><span class="fa-solid fa-pen" aria-hidden="true"></span><span class="visually-hidden">Inschrijving wijzigen</span></button></Template></GridColumn>

							</GridColumns>
						</SfGrid>
					</div>
				</div>
			}
		</div>
	<SfDialog Width="500px"
									  IsModal="true"
									  @bind-Visible="showAddGroupDialog"
									  ShowCloseIcon="true"
									  Header="Koor toevoegen">
								<DialogTemplates>
									<Content>
										<div class="p-3">
											@if (IsCurrentEditionSelected)
											{
												<SfComboBox TValue="uint?"
															TItem="AvailableGroupModel"
															DataSource="@AvailableGroups"
															@bind-Value="selectedAvailableGroupId"
															Placeholder="Selecteer een koor"
															Width="100%">
													<ComboBoxFieldSettings Value="ZanggroepId" Text="Naam"></ComboBoxFieldSettings>
													<ComboBoxTemplates TItem="AvailableGroupModel">
														<ItemTemplate Context="group">
															<div>
																<strong>@group.Naam</strong><br />
																<span>@group.Standplaats</span>
															</div>
														</ItemTemplate>
													</ComboBoxTemplates>
												</SfComboBox>

												<div class="mt-3"></div>

												<SfNumericTextBox TValue="int?"
																  @bind-Value="selectedAantalDeelnemers"
																  Placeholder="Aantal deelnemers"
																  Width="100%"
																  Min="1"
																  FloatLabelType="FloatLabelType.Always" />

												<div class="mt-3"></div>

												<SfComboBox TValue="string"
															TItem="StageTypeModel"
															DataSource="@AvailableStageTypes"
															@bind-Value="selectedPodiumsoort"
															Placeholder="Selecteer podiumsoort"
															Width="100%">
													<ComboBoxFieldSettings Value="Type" Text="Type"></ComboBoxFieldSettings>
													<ComboBoxTemplates TItem="StageTypeModel">
														<ItemTemplate Context="stageType">
															<div>
																<strong>@stageType.Type</strong><br />
																<span>@stageType.Omschrijving</span>
															</div>
														</ItemTemplate>
													</ComboBoxTemplates>
												</SfComboBox>
											}
											else
											{
												<p>Nieuwe koren kunnen alleen aan de huidige editie worden toegevoegd.</p>
											}
										</div>
									</Content>

									<FooterTemplate>
										<div class="flex justify-end gap-2">
											<button class="btn btn-green"
													@onclick="ConfirmAddGroupAsync"
													disabled="@(!CanConfirmAddGroup)">
												Toevoegen
											</button>
											<button class="btn btn-gray" @onclick="CloseAddGroupDialog">
												Annuleren
											</button>
										</div>
									</FooterTemplate>
								</DialogTemplates>
							</SfDialog>


</Authorized>
	<NotAuthorized>
		<p class="text-danger">Je hebt alleen toegang tot deze pagina wanneer je bent ingelogt</p>
	</NotAuthorized>
</AuthorizeView>

<Amusing.Components.RegistrationAvailabilityDialog @ref="availabilityDialog" Saved="LoadRegistrationsAsync" />
<SfDialog Visible="@(pendingWaitlistPlacement is not null)" IsModal="true" Width="450px" CloseOnEscape="false" ShowCloseIcon="false" Header="Uiterste betaaldatum bij plaatsing">
 <DialogTemplates><Content>
  <p>De inschrijving is gesloten. Kies de uiterste betaaldatum voor @pendingWaitlistPlacement?.Naam.</p>
  <label for="placement-due">Uiterste betaaldatum</label>
  <InputDate id="placement-due" class="form-control" @bind-Value="waitlistDue" min="@WaitlistColumn.Today.ToString("yyyy-MM-dd")" disabled="@waitlistBusy" />
  <div class="mt-3"><button type="button" class="btn btn-primary" disabled="@waitlistBusy" @onclick="ConfirmWaitlistPlacementAsync">Plaatsen en berichten versturen</button>
  <button type="button" class="btn btn-secondary" disabled="@waitlistBusy" @onclick="() => pendingWaitlistPlacement=null">Annuleren</button></div>
 </Content></DialogTemplates>
</SfDialog>
<Amusing.Components.RegistrationEditDialog @ref="registrationEditDialog" Saved="LoadRegistrationsAsync" />
@code {
 private Amusing.Components.RegistrationAvailabilityDialog availabilityDialog = default!;
 private Amusing.Components.RegistrationEditDialog registrationEditDialog = default!;
 private Task EditRegistrationAsync(RegistrationModel row,RegistrationEditAction action=RegistrationEditAction.Details)=>registrationEditDialog.OpenAsync(row.FestivalId,row.GroepId,action);
}

