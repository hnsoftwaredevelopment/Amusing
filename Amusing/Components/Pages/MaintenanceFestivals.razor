@page "/Maintenance-Festivals"
@using Amusing.Models
@using Amusing.Services
@using Bit.BlazorUI
@using Bit.BlazorUI.Extras
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.DataForm
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@using System.ComponentModel.DataAnnotations


@if (IsLoading)
{
    <div class="text-center p-2">
        <SfSpinner CssClass="e-spin-center" />
        <p>@FileName worden geladen...</p>
    </div>
}
else
{
    <div class="page-container">
        <div class="fixed-header">
            <h3>Onderhoud Amusing editie: @(SelectedFestival?.Festival ?? "geen editie beschibaar")</h3>
                @* Detail Fields *@
                <SfDataForm Model="SelectedFestival" OnValidSubmit="SaveFestival" LabelPosition="FormLabelPosition.Top">
                <div class="form-floating-switch">
                    <hr />
                    <Syncfusion.Blazor.Calendars.SfDatePicker TValue="DateOnly" @bind-Value="SelectedFestivalDatum" Placeholder="Festival datum" Format="dd-MM-yyyy" FloatLabelType="FloatLabelType.Always" Width="150px" WeekNumber="true" />
                    <Syncfusion.Blazor.Calendars.SfDatePicker TValue="DateOnly" @bind-Value="SelectedFestivalStartInschrijving" Placeholder="Start inschrijving" Format="dd-MM-yyyy" FloatLabelType="FloatLabelType.Always" Width="150px" WeekNumber="true" />
                    <Syncfusion.Blazor.Calendars.SfDatePicker TValue="DateOnly" @bind-Value="SelectedFestivalEindeInschrijving" Placeholder="Einde inschrijving" Format="dd-MM-yyyy" FloatLabelType="FloatLabelType.Always" Width="150px" WeekNumber="true" />
                    <hr />
                    <SfCheckBox @bind-Checked="WaitlistChecked">Wachtlijst</SfCheckBox>
                    <SfCheckBox @bind-Checked="PublicateChecked">Publiceer planning</SfCheckBox>
                    <hr />
                    <div>
                        <SfNumericTextBox TValue="int" Min="0" Max="90" @bind-Value="SelectedFestivalMinutenTussenOptredens" Placeholder="Min. tussen optredens" Width="250px" FloatLabelType="FloatLabelType.Always" CssClass="e-ntstyle"/>
                        <SfNumericTextBox TValue="int" Min="0" Max="90" @bind-Value="SelectedFestivalMaximumMinutenTussenOptredens" Placeholder="Max. min. tussen optredens" Width="270px" FloatLabelType="FloatLabelType.Always" CssClass="e-ntstyle" />
                        <SfNumericTextBox TValue="int" Min="0" Max="24" @bind-Value="SelectedFestivalMaximumUrenVrijwilligers" Placeholder="Max. uren vrijwilligers" Width="220px" FloatLabelType="FloatLabelType.Always" CssClass="e-ntstyle" />
                        <SfNumericTextBox TValue="decimal" ValidateDecimalOnType=true Decimals=2 Format="c2" Min="0" @bind-Value="SelectedFestivalBoeteOnderbrekingOptredens" Placeholder="Boete onderbreking optredens" Width="290px" FloatLabelType="FloatLabelType.Always" CssClass="e-ntstyle" />
                    </div>
                    <hr />
                    <div>
                        <Syncfusion.Blazor.Calendars.SfTimePicker TValue="TimeOnly" @bind-Value="SelectedFestivalStartVrijwilligersTaken" Placeholder="Start vrijwilligers taken" Width="200px" FloatLabelType="FloatLabelType.Always" />
                        <Syncfusion.Blazor.Calendars.SfTimePicker TValue="TimeOnly" @bind-Value="SelectedFestivalEindeVrijwilligersTaken" Placeholder="Einde vrijwilligers taken" Width="200px" FloatLabelType="FloatLabelType.Always" />
                        <Syncfusion.Blazor.Calendars.SfTimePicker TValue="TimeOnly" @bind-Value="SelectedFestivalStartVrijwilligersPauze" Placeholder="Start vrijwilligers Pauze" Width="200px" FloatLabelType="FloatLabelType.Always" />
                        <Syncfusion.Blazor.Calendars.SfTimePicker TValue="TimeOnly" @bind-Value="SelectedFestivalEindeVrijwilligersPauze" Placeholder="Einde vrijwilligers Pauze" Width="200px" FloatLabelType="FloatLabelType.Always" />
                        <Syncfusion.Blazor.Calendars.SfTimePicker TValue="TimeOnly" @bind-Value="SelectedFestivalEindeVasteVrijwilligersTaken" Placeholder="Einde vaste vrijwilligers taken" Width="230px" FloatLabelType="FloatLabelType.Always" />
                    </div>
                    <hr />
                </div>
            </SfDataForm>
        </div>

        <div class="scrollable-content">
        @* DataGrid *@ 
        <div class="spacer-medium"></div>
        <div style="overflow-x:auto; padding-left: 2px; padding-right: 2px">
            <SfToolbar Width="550px">
                <ToolbarItems>
                    <ToolbarItem Type="ItemType.Button">
                        <Template>
                            <button class="custom-toolbar-btn"
                                    @onclick="SaveFestival"
                                    title="Sla het podiumtype als nieuwe, of ge-(in)activeerde versie">
                                <img src="icons/button-save.svg" class="icon" alt="SAVE" />
                            </button>
                        </Template>
                    </ToolbarItem>
                    <ToolbarItem Type="ItemType.Button">
                        <Template>
                            <button class="custom-toolbar-btn" @onclick="AddNewFestival" title="Voeg een nieuw podium type toe">
                                <img src="icons/button-add.svg" class="icon" alt="ADD" />
                            </button>
                        </Template>
                    </ToolbarItem>
                    <ToolbarItem Type="ItemType.Button">
                        <Template>
                            <button class="custom-toolbar-btn @(SelectedFestival?.Aktief == 1 ? "disabled" : "")"
                                    @onclick="DeleteFestival"
                                    title="Verwijder geselecteerde podium type (versie)"
                                    disabled="@(SelectedFestival?.Aktief == 1)">
                                <img src="icons/button-del.svg" class="icon" alt="DEL" />
                            </button>
                        </Template>
                    </ToolbarItem>
                    <ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
                        <Template>
                            <span class="toolbar-count">@FileName: @VisibleRowCount</span>
                        </Template>
                    </ToolbarItem>

                    <ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
                        <Template>
                            <SfTextBox Placeholder="Zoek" Input="OnInput"></SfTextBox>
                        </Template>
                    </ToolbarItem>
                </ToolbarItems>
            </SfToolbar>
    
                <SfGrid @ref="GridRef"
                    TValue="FestivalModel"
                    DataSource="@Festivals" EnableStickyHeader="true"
                    AllowResizing="true" Width="550px"
                    AllowSelection="true" >
                <GridEvents TValue="FestivalModel" DataBound="OnGridDataBound" RowSelected="OnRowSelected" />


                <GridColumns>
                    <GridColumn Field="Festival" HeaderText="Editie" TextAlign="TextAlign.Center" AllowSorting=true AllowResizing="true" Width="60px" />
                    <GridColumn Field="Festivaldatum" HeaderText="Datum" TextAlign="TextAlign.Right" AllowSorting=true AllowResizing="true" Width="80px"/>
                    <GridColumn Field="StartInschrijving" HeaderText="Start inschrijving" TextAlign="TextAlign.Right" AllowSorting=true AllowResizing="true" Width="130px" />
                    <GridColumn Field="EindeInschrijving" HeaderText="Einde inschrijving" TextAlign="TextAlign.Right" AllowSorting=true AllowResizing="true" Width="130px" />
                    <GridColumn Field="Aktief" HeaderText="Aktief" TextAlign="TextAlign.Center" Width="140px">
                        <Template>
                            @{
                                var festival = (context as FestivalModel);
                                    var activeState = SelectedFestivalActive == 1 ? "Gebruikt" : "Niet gebruikt";
                                    var activeStateColor = SelectedFestivalActive == 1 ? "e-success" : "e-danger";
                                <div class="template_checkbox">
                                    <SfChip id="chip">
                                        <ChipItems>
                                            <ChipItem Text="@activeState" CssClass="@($"{activeStateColor} custom-chip")" Width="120px" />
                                        </ChipItems>
                                    </SfChip>
                                </div>
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>          
            </SfGrid>
            <div class="spacer-large"></div>
            </div>
        </div>
    </div>
}
