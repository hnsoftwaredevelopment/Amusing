@page "/Maintenance-Users"
@using Amusing.Models
@using Amusing.Services
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@using System.ComponentModel.DataAnnotations
@using Syncfusion.Blazor.Notifications
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.RichTextEditor
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.SplitButtons
@using System.Text.Json

@inject NavigationManager NavManager
@inject IJSRuntime JS

@if (IsLoading)
{
    <div class="text-center p-2">
        <SfSpinner CssClass="e-spin-center" />
        <p>@FileName worden geladen...</p>
    </div>
}
else
{
    <div class="page-container maintenance-page">
        <!-- Static detail fields-->
        <div class="fixed-header maintenance-page__header">
            <h3>Onderhoud @FileName</h3>
            <EditForm EditContext="@editContext">

                <div class="form-grid"> 
                    <div class="form-left"> 
                        <div class="form-row" style="display:flex; align-items:flex-end; gap:8px;">
                            <SfTextBox Placeholder="Gebruikersnaam" FloatLabelType="FloatLabelType.Always" Width="120px" @bind-Value="UserUsername" />
                            <SfComboBox TValue="string" TItem="UserRoles" FloatLabelType="FloatLabelType.Always"
                                        Placeholder="Rol" DataSource="@Roles" Width="170px" @bind-Value="UserRole" >
                                <ComboBoxFieldSettings Value="Role" Text="Role"></ComboBoxFieldSettings>
                            </SfComboBox>
                            <div> 
                            </div>
                        </div>

                        <div class="form-row" style="display:flex; align-items:flex-end; gap:8px;">
                            <SfToast @ref="ToastObj" Title="Wachtwoord gewijzigd" Content="Gewijzigde wachtwoord opgeslagen" Timeout="3000" ShowProgressBar="true" >
                                <ToastPosition X="300" Y="150"></ToastPosition>
                            </SfToast>
                            <SfTextBox Placeholder="Wachtwoord" FloatLabelType="FloatLabelType.Always" Width="200px" @bind-Value="UserPassword"/>
                            @if (UserId != 0)
                            {
                                <button class="custom-toolbar-btn" @onclick="SavePassword" title="Sla het wachtwoord op">
                                    <img src="icons/button-savepassword.svg" class="icon" alt="PW" />
                                </button>
                            }
                        </div>
                    </div>
                    @if ( UserUsername == "" || UserRole == "" || ( UserPassword == "" && UserId == 0 ) )
                    {
                        <div class="form-middle">
                                <ul>
                                    @if ( UserUsername == "" )
                                    {
                                        <li class="text-danger">Gebruikersnaam mag niet leeg zijn</li>
                                    }
                                    @if ( UserRole == "" )
                                    {
                                        <li class="text-danger">Rol mag niet leeg zijn</li>
                                    }
                                    @if ( UserPassword == "" && UserId == 0 )
                                    {
                                        <li class="text-danger">Wachtwoord mag niet leeg zijn voor een nieuwe gebruiker</li>
                                    }
                                </ul>
                        </div>
                    }
                    <div class="form-right">
                        <div></div>
                    </div>
                </div>
            </EditForm>

            <div class="spacer-small"></div>

            <!-- Toolbar -->
            <div class="maintenance-toolbar-shell">
                <SfToolbar Width="870px">
                    <ToolbarItems>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn"
                                        @onclick="Save"
                                        title="Bewaar de gebruiker">
                                    <img src="icons/button-save.svg" class="icon" alt="SAVE" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn" @onclick="AddNew" title="Voeg een nieuw gebruiker toe">
                                    <img src="icons/button-add.svg" class="icon" alt="ADD" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn" @onclick="Delete" title="verwijder de geselecteerde gebruiker">
                                    <img src="icons/button-del.svg" class="icon" alt="DELETE" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
                            <Template>
                                <span class="toolbar-count">@FileName: @VisibleRowCount</span>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
                            <Template>
                                <SfTextBox Placeholder="Zoek" Input="OnInput"></SfTextBox>
                            </Template>
                        </ToolbarItem>
                    </ToolbarItems>
                </SfToolbar>
            </div>
        </div>

        <div class="spacer-small"></div>

        <!-- Scrollable area for main datagrid -->
        <div class="scrollable-content maintenance-page__content">
            <div class="maintenance-grid-shell maintenance-grid-shell--fit">
                <SfGrid @ref="GridRef"
                        TValue="UserModel"
                        Width="870"
                        DataSource="@Users"
                        EnableStickyHeader="true"
                        CssClass="maintenance-grid"
                        AllowResizing="true"
                        Height="100%"
                        AllowSorting="true"
                        AllowMultiSorting="true"
                        AllowSelection="true">
                    <GridEvents TValue="UserModel" DataBound="OnGridDataBound" RowSelected="OnRowSelected" />
                    <GridEditSettings AllowAdding="true" NewRowPosition="NewRowPosition.Top"></GridEditSettings>
                    <GridColumns>
                        <GridColumn Field="UserId" IsPrimaryKey="true" Visible="false" />
                        <GridColumn Field="Username" HeaderText="Gebruikersnaam" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="120px" />
                        <GridColumn Field="Role" HeaderText="Rol" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="120px" />
                        <GridColumn Field="LastLoginDate" HeaderText="Laatste inlog" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="120px" />
                    </GridColumns>
                </SfGrid>
            </div> 
        </div>
    </div>
}
