@page "/Overview-EmailAddresses"
@using Amusing.Models
@using Amusing.Services
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations

@inherits OverviewEmailAddresses;

<AuthorizeView>
	<Authorized>
		<h3>E-mail adressen</h3>
		<p/>
		<p>Onderstaande excel files kun je downloaden. Ga discreet om met deze informatie!</p>
		<p />
		<p>De lijsten kunnen worden opgemaakt voor Nederlandse, Duitse, of Overige zang groepen</p>
		<p>Kies eerst het gewenste land van herkomst</p>
		<div class="grid-layout">
			<SfComboBox
				TValue="string" 
				TItem="Countries"
				Placeholder="Selecteer een land"
				ValueChanged="OnCountryChanged"
				DataSource="@CountryList"
				Width="250px">

				<ComboBoxTemplates TItem="Countries">
					<ItemTemplate Context="country">
						<div>
							<img class="countryImage" src="icons/@((country as Countries).Code).svg" alt="country" />
							<div class="countryName"> @((country as Countries).Name) </div>
						</div>
					</ItemTemplate>
				</ComboBoxTemplates>

				<ComboBoxFieldSettings Text="Name" Value="Code" />
			</SfComboBox>
		</div>
		@if( SelectedCountry != null)
		{
		@* Niewsbrief *@
		<h2 class="mt-5">Niewsbrief mailinglijst</h2>
		<p/>
		@if ( SelectedCountry != null && NewsletterEmailAddressesListVisibleRowCount > 0 )
		{
			<table class="table">
				<thead>
					<th style="width: 400px">Omschrijving</th>
					<th style="width: 50px">Aantal</th>
					<th style="width: 60px">Excel</th>
					<th style="width: 60px">CSV</th>
					<th style="width: 60px">PDF</th>
					<th/>
				</thead>
				<tbody>
					<tr>
						@{ var filetypeNewsletter = "newsletter"; }
						<td class="two-row-cel">
							<div class="first-row">Email adressen voor nieuwsbrief</div>
							<div class="second-row">Iedereen die mail wil ontvangen</div>
						</td>
						<td class="row-count">@NewsletterEmailAddressesListVisibleRowCount</td>
						@if ( NewsletterEmailAddressesListVisibleRowCount > 0 )
						{
							<td>
								<button @onclick="() => ExportToExcel( filetypeNewsletter )" title="Exporteer naar een Excel bestand">
									<img src="/icons/excel.svg" width="25" class="icon" alt="Excel" />
								</button>
							</td>

							<td>
								<button @onclick="() => ExportToCsv( filetypeNewsletter )" title="Exporteer naar een CSV bestand">
									<img src="icons/csv.svg" width="25" class="icon" alt="CSV" />
								</button>
							</td>

							<td>
								<button @onclick="() => ExportToPdf( filetypeNewsletter )" title="Exporteer naar een PDF bestand">
									<img src="icons/pdf.svg" width="25" class="icon" alt="PDF" />
								</button>
							</td>
						}
					</tr>
				</tbody>
			</table>
		}

		@* The datagrid should never been shown, only available for easy export *@
		<SfGrid @ref="NewsletterEmailAddressesGridRef"
				@key="FilteredNewsletterEmailAddressesList"
				DataSource="@FilteredNewsletterEmailAddressesList" AllowExcelExport="true" AllowPdfExport="true"
				Width="100%" 
				style="display: none;">

			<GridColumns>
				<GridColumn Field="Groep" HeaderText="Groep" />
				<GridColumn Field="Naam" HeaderText="Naam" />
				<GridColumn Field="Email" HeaderText="Email" />
				<GridColumn Field="Land" HeaderText="Land" />
			</GridColumns>
		</SfGrid>
		@* Contactpersonen *@
		<h2 class="mt-5">Contactpersonen mailinglijst</h2>
		<p>Alleen mailadressen van contactpersonen staan in deze lijsten, ongeacht of ze wel of niet mail willen ontvangen</p>
		<p><b>Gebruik deze niet voor nieuwsbrieven!</b></p>
		<table class="table">
			<thead>
			<th style="width: 400px">Omschrijving</th>
			<th style="width: 50px">Aantal</th>
			<th style="width: 60px">Excel</th>
			<th style="width: 60px">CSV</th>
			<th style="width: 60px">PDF</th>
			<th/>
		</thead>
			<tbody>
				@* All known groups *@
				<tr>
					@{
						var filetypeKnownGroups = "allknown";
					}
					<td class="two-row-cel">
						<div class="first-row">Alle bekende groepen</div>
						<div class="second-row">Ongeacht compleet profiel of ingeschreven</div>
					</td>
					<td class="row-count">@AllKnownEmailAddressesListVisibleRowCount</td>
					@if( AllKnownEmailAddressesListVisibleRowCount > 0)
					{
						<td>
							<button @onclick="() => ExportToExcel( filetypeKnownGroups )" title="Exporteer naar een Excel bestand">
								<img src="/icons/excel.svg" width="25" class="icon" alt="Excel" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToCsv( filetypeKnownGroups )" title="Exporteer naar een CSV bestand">
								<img src="icons/csv.svg" width="25" class="icon" alt="CSV" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToPdf( filetypeKnownGroups )" title="Exporteer naar een PDF bestand">
								<img src="icons/pdf.svg" width="25" class="icon" alt="PDF" />
							</button>
						</td>
					}
				</tr>

				@* Added since last festival but not registered *@
				<tr>
					@{
						var filetypeNewlyAdded = "newlyadded";
					}

					<td class="two-row-cel">
						<div class="first-row">Toegevoegd sinds het laatste festival maar nog steeds niet ingeschreven</div>
						<div class="second-row">Groepen toegevoegd in de afgelopen maand zijn weggelaten</div>
					</td>
					<td class="row-count">@NewlyAddedEmailAddressesListVisibleRowCount</td>
					@if ( NewlyAddedEmailAddressesListVisibleRowCount > 0 )
					{
						<td>
							<button @onclick="() => ExportToExcel( filetypeNewlyAdded )" title="Exporteer naar een Excel bestand">
								<img src="/icons/excel.svg" width="25" class="icon" alt="Excel" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToCsv( filetypeNewlyAdded )" title="Exporteer naar een CSV bestand">
								<img src="icons/csv.svg" width="25" class="icon" alt="CSV" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToPdf( filetypeNewlyAdded )" title="Exporteer naar een PDF bestand">
								<img src="icons/pdf.svg" width="25" class="icon" alt="PDF" />
							</button>
						</td>
					}
				</tr>

				@* Old reistrations but not registered for upcomming festival *@
				<tr>
					@{
						var filetypeKnownNotRegistered = "knownnotregistered";
					}

					<td class="two-row-cel">
						<div class="first-row">Oud deelnemers</div>
						<div class="second-row">nog niet ingeschreven voor het komende festival</div>
					</td>
					<td class="row-count">@OldEmailAddressesListVisibleRowCount</td>
					@if ( OldEmailAddressesListVisibleRowCount > 0 )
					{
						<td>
							<button @onclick="() => ExportToExcel( filetypeKnownNotRegistered )" title="Exporteer naar een Excel bestand">
								<img src="/icons/excel.svg" width="25" class="icon" alt="Excel" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToCsv( filetypeKnownNotRegistered )" title="Exporteer naar een CSV bestand">
								<img src="icons/csv.svg" width="25" class="icon" alt="CSV" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToPdf( filetypeKnownNotRegistered )" title="Exporteer naar een PDF bestand">
								<img src="icons/pdf.svg" width="25" class="icon" alt="PDF" />
							</button>
						</td>
					}
				</tr>

				@* Groups registered for last festival *@
				<tr>
					@{
						var filetypeRegisteredPrevious = "registeredprevious";
					}

					<td class="two-row-cel">
						<div class="first-row">Groepen ingeschreven voor het vorige festiva</div>
						<div class="second-row">Uitgezonderd wachtlijst</div>
					</td>
					<td class="row-count">@PreviousEmailAddressesListVisibleRowCount</td>
					@if ( PreviousEmailAddressesListVisibleRowCount > 0 )
					{
						<td>
							<button @onclick="() => ExportToExcel( filetypeRegisteredPrevious )" title="Exporteer naar een Excel bestand">
								<img src="/icons/excel.svg" width="25" class="icon" alt="Excel" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToCsv( filetypeRegisteredPrevious )" title="Exporteer naar een CSV bestand">
								<img src="icons/csv.svg" width="25" class="icon" alt="CSV" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToPdf( filetypeRegisteredPrevious )" title="Exporteer naar een PDF bestand">
								<img src="icons/pdf.svg" width="25" class="icon" alt="PDF" />
							</button>
						</td>
					}
				</tr>

				@* Groups registered for upcomming festival *@
				<tr>
					@{
						var filetypeRegisteredUpcomming = "registeredupcomming";
					}

					<td class="two-row-cel">
						<div class="first-row">Groepen ingeschreven voor het komende festival</div>
						<div class="second-row">Uitgezonderd wachtlijst</div>
					</td>
					<td class="row-count">@UpcommingEmailAddressesListVisibleRowCount</td>
					@if ( UpcommingEmailAddressesListVisibleRowCount > 0) 
					{
						<td>
							<button @onclick="() => ExportToExcel( filetypeRegisteredUpcomming )" title="Exporteer naar een Excel bestand">
								<img src="/icons/excel.svg" width="25" class="icon" alt="Excel" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToCsv( filetypeRegisteredUpcomming )" title="Exporteer naar een CSV bestand">
								<img src="icons/csv.svg" width="25" class="icon" alt="CSV" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToPdf( filetypeRegisteredUpcomming )" title="Exporteer naar een PDF bestand">
								<img src="icons/pdf.svg" width="25" class="icon" alt="PDF" />
							</button>
						</td>
					}
				</tr>

				@* Queue for upcomming festival *@
				<tr>
					@{
						var filetypeQueueUpcomming = "queueupcomming";
					}

					<td class="one-row-cel">Wachtlijst voor het komende festival</td>
					<td class="row-count">@QueueUpcommingEmailAddressesListVisibleRowCount</td>
					@if ( QueueUpcommingEmailAddressesListVisibleRowCount > 0 )
					{
						<td>
							<button @onclick="() => ExportToExcel( filetypeQueueUpcomming )" title="Exporteer naar een Excel bestand">
								<img src="/icons/excel.svg" width="25" class="icon" alt="Excel" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToCsv( filetypeQueueUpcomming )" title="Exporteer naar een CSV bestand">
								<img src="icons/csv.svg" width="25" class="icon" alt="CSV" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToPdf( filetypeQueueUpcomming )" title="Exporteer naar een PDF bestand">
								<img src="icons/pdf.svg" width="25" class="icon" alt="PDF" />
							</button>
						</td>
					}
				</tr>

				@* Incomplete profiles *@
				<tr>
					@{
						var filetypeIncomplete = "incomplete";
					}
					<td class="two-row-cel">
						<div class="first-row">Incomplete profielen.</div>
						<div class="second-row">Groep is aangemaakt, maar nog niet ingelogd en ingeschreven</div>
					</td>
					<td class="row-count">@IncompleteEmailAddressesListVisibleRowCount</td>
					@if ( IncompleteEmailAddressesListVisibleRowCount > 0 )
					{
						<td>
							<button @onclick="() => ExportToExcel( filetypeIncomplete )" title="Exporteer naar een Excel bestand">
								<img src="/icons/excel.svg" width="25" class="icon" alt="Excel" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToCsv( filetypeIncomplete )" title="Exporteer naar een CSV bestand">
								<img src="icons/csv.svg" width="25" class="icon" alt="CSV" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToPdf( filetypeIncomplete )" title="Exporteer naar een PDF bestand">
								<img src="icons/pdf.svg" width="25" class="icon" alt="PDF" />
							</button>
						</td>
					}
				</tr>
			</tbody>
		</table>

		@* The datagrids should never been shown, only available for easy export *@
		@* All Known Groups *@
		<SfGrid @ref="AllKnownEmailAddressesGridRef"
				@key="FilteredAllKnownEmailAddressesList"
				DataSource="@FilteredAllKnownEmailAddressesList" AllowExcelExport="true" AllowPdfExport="true"
				Width="100%"
				style="display: none;">

			<GridColumns>
				<GridColumn Field="Groep" HeaderText="Groep" />
				<GridColumn Field="Naam" HeaderText="Naam" />
				<GridColumn Field="Email" HeaderText="Email" />
				<GridColumn Field="Land" HeaderText="Land" />
			</GridColumns>
		</SfGrid>

		@* Newly Added groups *@
		<SfGrid @ref="NewlyAddedEmailAddressesGridRef"
				@key="FilteredNewlyAddedEmailAddressesList"
				DataSource="@FilteredNewlyAddedEmailAddressesList" AllowExcelExport="true" AllowPdfExport="true"
				Width="100%"
				style="display: none;">

			<GridColumns>
				<GridColumn Field="Groep" HeaderText="Groep" />
				<GridColumn Field="Naam" HeaderText="Naam" />
				<GridColumn Field="Email" HeaderText="Email" />
				<GridColumn Field="Land" HeaderText="Land" />
			</GridColumns>
		</SfGrid>

		@* Old reistrations but not registered groups *@
		<SfGrid @ref="OldEmailAddressesGridRef"
				@key="FilteredOldEmailAddressesList"
				DataSource="@FilteredOldEmailAddressesList" AllowExcelExport="true" AllowPdfExport="true"
				Width="100%"
				style="display: none;">

			<GridColumns>
				<GridColumn Field="Groep" HeaderText="Groep" />
				<GridColumn Field="Naam" HeaderText="Naam" />
				<GridColumn Field="Email" HeaderText="Email" />
				<GridColumn Field="Land" HeaderText="Land" />
			</GridColumns>
		</SfGrid>

		@*  Groups registered for last festival *@
		<SfGrid @ref="PreviousEmailAddressesGridRef"
				@key="FilteredPreviousEmailAddressesList"
				DataSource="@FilteredPreviousEmailAddressesList" AllowExcelExport="true" AllowPdfExport="true"
				Width="100%"
				style="display: none;">

			<GridColumns>
				<GridColumn Field="Groep" HeaderText="Groep" />
				<GridColumn Field="Naam" HeaderText="Naam" />
				<GridColumn Field="Email" HeaderText="Email" />
				<GridColumn Field="Land" HeaderText="Land" />
			</GridColumns>
		</SfGrid>

		@*  Groups registered for upcomming festival *@
		<SfGrid @ref="UpcommingEmailAddressesGridRef"
				@key="FilteredUpcommingEmailAddressesList"
				DataSource="@FilteredUpcommingEmailAddressesList" AllowExcelExport="true" AllowPdfExport="true"
				Width="100%"
				style="display: none;">

			<GridColumns>
				<GridColumn Field="Groep" HeaderText="Groep" />
				<GridColumn Field="Naam" HeaderText="Naam" />
				<GridColumn Field="Email" HeaderText="Email" />
				<GridColumn Field="Land" HeaderText="Land" />
			</GridColumns>
		</SfGrid>

		@*  Queue for upcomming festival *@
		<SfGrid @ref="QueueUpcommingEmailAddressesGridRef"
				@key="FilteredQueueUpcommingEmailAddressesList"
				DataSource="@FilteredQueueUpcommingEmailAddressesList" AllowExcelExport="true" AllowPdfExport="true"
				Width="100%"
				style="display: none;">

			<GridColumns>
				<GridColumn Field="Groep" HeaderText="Groep" />
				<GridColumn Field="Naam" HeaderText="Naam" />
				<GridColumn Field="Email" HeaderText="Email" />
				<GridColumn Field="Land" HeaderText="Land" />
			</GridColumns>
		</SfGrid>

		@* Incomplete profiles groups*@
		<SfGrid @ref="IncompleteEmailAddressesGridRef"
				@key="FilteredIncompleteEmailAddressesList"
				DataSource="@FilteredIncompleteEmailAddressesList" AllowExcelExport="true" AllowPdfExport="true"
				Width="100%"
				style="display: none;">

			<GridColumns>
				<GridColumn Field="Groep" HeaderText="Groep" />
				<GridColumn Field="Naam" HeaderText="Naam" />
				<GridColumn Field="Email" HeaderText="Email" />
				<GridColumn Field="Ontbreekt" HeaderText="Ontbreekt" />
				<GridColumn Field="Land" HeaderText="Land" />
			</GridColumns>
		</SfGrid>
	}
	</Authorized>
	<NotAuthorized>
		<p class="text-danger">Je hebt alleen toegang tot deze pagina wanneer je bent ingelogt</p>
	</NotAuthorized>
</AuthorizeView>