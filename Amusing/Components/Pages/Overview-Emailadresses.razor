				@* Groups registered for upcomming festival *@
				<tr>
					@{
						var filetypeRegisteredUpcomming = "registeredupcomming";
					}

					<td class="two-row-cel">
						<div class="first-row">Groepen ingeschreven voor het komende festival</div>
						<div class="second-row">Uitgezonderd wachtlijst</div>
					</td>
					<td class="row-count">@UpcommingEmailAddressesListVisibleRowCount</td>
					@if ( UpcommingEmailAddressesListVisibleRowCount > 0) 
					{
						<td>
							<button @onclick="() => ExportToExcel( filetypeRegisteredUpcomming )" title="Exporteer naar een Excel bestand">
								<img src="/icons/excel.svg" width="25" class="icon" alt="Excel" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToCsv( filetypeRegisteredUpcomming )" title="Exporteer naar een CSV bestand">
								<img src="icons/csv.svg" width="25" class="icon" alt="CSV" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToPdf( filetypeRegisteredUpcomming )" title="Exporteer naar een PDF bestand">
								<img src="icons/pdf.svg" width="25" class="icon" alt="PDF" />
							</button>
						</td>
					}
				</tr>

				@* Queue for upcomming festival *@
				<tr>
					@{
						var filetypeQueueUpcomming = "queueupcomming";
					}

					<td class="one-row-cel">Wachtlijst voor het komende festival</td>
					<td class="row-count">@QueueUpcommingEmailAddressesListVisibleRowCount</td>
					@if ( QueueUpcommingEmailAddressesListVisibleRowCount > 0 )
					{
						<td>
							<button @onclick="() => ExportToExcel( filetypeQueueUpcomming )" title="Exporteer naar een Excel bestand">
								<img src="/icons/excel.svg" width="25" class="icon" alt="Excel" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToCsv( filetypeQueueUpcomming )" title="Exporteer naar een CSV bestand">
								<img src="icons/csv.svg" width="25" class="icon" alt="CSV" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToPdf( filetypeQueueUpcomming )" title="Exporteer naar een PDF bestand">
								<img src="icons/pdf.svg" width="25" class="icon" alt="PDF" />
							</button>
						</td>
					}
				</tr>

				@* Incomplete profiles *@
				<tr>
					@{
						var filetypeIncomplete = "incomplete";
					}
					<td class="two-row-cel">
						<div class="first-row">Incomplete profielen.</div>
						<div class="second-row">Groep is aangemaakt, maar nog niet ingelogd en ingeschreven</div>
					</td>
					<td class="row-count">@IncompleteEmailAddressesListVisibleRowCount</td>
					@if ( IncompleteEmailAddressesListVisibleRowCount > 0 )
					{
						<td>
							<button @onclick="() => ExportToExcel( filetypeIncomplete )" title="Exporteer naar een Excel bestand">
								<img src="/icons/excel.svg" width="25" class="icon" alt="Excel" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToCsv( filetypeIncomplete )" title="Exporteer naar een CSV bestand">
								<img src="icons/csv.svg" width="25" class="icon" alt="CSV" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToPdf( filetypeIncomplete )" title="Exporteer naar een PDF bestand">
								<img src="icons/pdf.svg" width="25" class="icon" alt="PDF" />
							</button>
						</td>
					}
				</tr>
			</tbody>
		</table>

		@* The datagrids should never been shown, only available for easy export *@
		@* All Known Groups *@
		<SfGrid @ref="AllKnownEmailAddressesGridRef"
				@key="FilteredAllKnownEmailAddressesList"
				DataSource="@FilteredAllKnownEmailAddressesList" AllowExcelExport="true" AllowPdfExport="true"
				Width="100%"
				style="display: none;">

			<GridColumns>
				<GridColumn Field="Groep" HeaderText="Groep" />
				<GridColumn Field="Naam" HeaderText="Naam" />
				<GridColumn Field="Email" HeaderText="Email" />
				<GridColumn Field="Land" HeaderText="Land" />
			</GridColumns>
		</SfGrid>

		@* Newly Added groups *@
		<SfGrid @ref="NewlyAddedEmailAddressesGridRef"
				@key="FilteredNewlyAddedEmailAddressesList"
				DataSource="@FilteredNewlyAddedEmailAddressesList" AllowExcelExport="true" AllowPdfExport="true"
				Width="100%"
				style="display: none;">

			<GridColumns>
				<GridColumn Field="Groep" HeaderText="Groep" />
				<GridColumn Field="Naam" HeaderText="Naam" />
				<GridColumn Field="Email" HeaderText="Email" />
				<GridColumn Field="Land" HeaderText="Land" />
			</GridColumns>
		</SfGrid>

		@* Old reistrations but not registered groups *@
		<SfGrid @ref="OldEmailAddressesGridRef"
				@key="FilteredOldEmailAddressesList"
				DataSource="@FilteredOldEmailAddressesList" AllowExcelExport="true" AllowPdfExport="true"
				Width="100%"
				style="display: none;">

			<GridColumns>
				<GridColumn Field="Groep" HeaderText="Groep" />
				<GridColumn Field="Naam" HeaderText="Naam" />
				<GridColumn Field="Email" HeaderText="Email" />
				<GridColumn Field="Land" HeaderText="Land" />
			</GridColumns>
		</SfGrid>

		@*  Groups registered for last festival *@
		<SfGrid @ref="PreviousEmailAddressesGridRef"
				@key="FilteredPreviousEmailAddressesList"
				DataSource="@FilteredPreviousEmailAddressesList" AllowExcelExport="true" AllowPdfExport="true"
				Width="100%"
				style="display: none;">

			<GridColumns>
				<GridColumn Field="Groep" HeaderText="Groep" />
				<GridColumn Field="Naam" HeaderText="Naam" />
				<GridColumn Field="Email" HeaderText="Email" />
