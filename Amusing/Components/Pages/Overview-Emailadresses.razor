	private string GetFileName (string fileType)
	{
		string filename = "unknown";

		switch ( fileType )
		{
			case "newsletter":
				filename = "Nieuwsbrief mail adressen";
				break;
			case "allknown":
				filename = "Bekende groepen";
				break;
			case "newlyadded":
				filename = "Toegevoegd niet geregistreerd";
				break;
			case "knownnotregistered":
				filename = "Bestaand niet aangemeld";
				break;
			case "registeredprevious": 
				filename = "Groepen vorige festival";
				break;
			case "registeredupcomming":
				filename = "Groepen komende festival";
				break;
			case "queueupcomming": 
				filename = "Wachtlijst huidige festival";
				break;
			case "incomplete":
				filename = "Incomplete profielen";
				break;
			default:
				filename = "Onbekend";
				break;
		}

		return filename;
	}
