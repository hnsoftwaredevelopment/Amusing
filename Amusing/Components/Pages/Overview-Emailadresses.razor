						<div class="first-row">Alle bekende groepen</div>
						<div class="second-row">Ongeacht compleet profiel of ingeschreven</div>
					</td>
					<td class="row-count">@AllKnownEmailAddressesListVisibleRowCount</td>
					@if( AllKnownEmailAddressesListVisibleRowCount > 0)
					{
						<td>
							<button @onclick="() => ExportToExcel( filetypeKnownGroups )" title="Exporteer naar een Excel bestand">
								<img src="/icons/excel.svg" width="25" class="icon" alt="Excel" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToCsv( filetypeKnownGroups )" title="Exporteer naar een CSV bestand">
								<img src="icons/csv.svg" width="25" class="icon" alt="CSV" />
							</button>
						</td>

						<td>
							<button @onclick="() => ExportToPdf( filetypeKnownGroups )" title="Exporteer naar een PDF bestand">
								<img src="icons/pdf.svg" width="25" class="icon" alt="PDF" />
							</button>
						</td>
