		@*  Groups registered for upcomming festival *@
		<SfGrid @ref="UpcommingEmailAddressesGridRef"
				@key="FilteredUpcommingEmailAddressesList"
				DataSource="@FilteredUpcommingEmailAddressesList" AllowExcelExport="true" AllowPdfExport="true"
				Width="100%"
				style="display: none;">

			<GridColumns>
				<GridColumn Field="Groep" HeaderText="Groep" />
				<GridColumn Field="Naam" HeaderText="Naam" />
				<GridColumn Field="Email" HeaderText="Email" />
				<GridColumn Field="Land" HeaderText="Land" />
			</GridColumns>
		</SfGrid>

		@*  Queue for upcomming festival *@
		<SfGrid @ref="QueueUpcommingEmailAddressesGridRef"
				@key="FilteredQueueUpcommingEmailAddressesList"
				DataSource="@FilteredQueueUpcommingEmailAddressesList" AllowExcelExport="true" AllowPdfExport="true"
				Width="100%"
