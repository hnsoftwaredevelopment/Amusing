@page "/VolunteerTasks"
@using Amusing.Models
@using Amusing.Services
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@inject EditionService EditionService
@inject VolunteerService VolunteerService

<style>
	.grid-layout {
		display: grid;
		grid-template-columns: 1fr auto; /* Linker kolom: flexibel, Rechter kolom: auto breedte */
		align-items: center; /* Verticaal uitlijnen */
		gap: 1rem;
	}
</style>

<AuthorizeView>
	<Authorized>
		<h3>Vrijwilligerstaken</h3>
		<p />
		<div class="grid-layout">
		<SfComboBox TValue="string"
					TItem="Edition"
					Placeholder="Kies een editie"
					ValueChanged="OnEditionChanged"
					DataSource="@Editions"
					Width="150px">
			<ComboBoxFieldSettings Value="ID" Text="Text"></ComboBoxFieldSettings>
		</SfComboBox>
@if ( SelectedEditionId != null && AllVolunteerList.Count > 0 )
{
		<Syncfusion.Blazor.Buttons.SfButton>Download</Syncfusion.Blazor.Buttons.SfButton>
}
		</div>
		<p />

		@if ( SelectedEditionId != null && AllVolunteerList.Count > 0 )
		{
			@* Podiumdienst *@
			<h2>Podiumdienst</h2>
			<div class="col-lg-12 control-section">
				<div class="content-wrapper">
					<div class="row">
						<SfGrid @ref="StageGridRef" 
							@key="FilteredStageVolunteerList"
								DataSource="@FilteredStageVolunteerList"
								Width="100%"
								AllowPaging="true"
								AllowSorting="true"
								AllowMultiSorting="true">
								<GridPageSettings PageSize="50" PageSizes="@(new string[] { "10","20","30","40","50","All" })"/>
							<SfToolbar>
								<ToolbarItems>
									<ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
										<Template>
											<SfTextBox Placeholder="Zoek" Input="OnInputStage"></SfTextBox>
										</Template>
									</ToolbarItem>
								</ToolbarItems>
							</SfToolbar>
							<GridColumns>
								<GridColumn Field="Datum" HeaderText="Datum" TextAlign="TextAlign.Center" Type="ColumnType.Date" Format="dd-MM-yyyy" Width="90"/>
								<GridColumn Field="Naam" HeaderText="Naam"/>
								<GridColumn Field="Van" HeaderText="Van" Width="70"/>
								<GridColumn Field="Tot" HeaderText="Tot" Width="70"/>
								<GridColumn Field="Uren" HeaderText="Uren" Width="70" TextAlign="TextAlign.Right"/>
								<GridColumn Field="Lunch" HeaderText="Lunch" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Vegetarisch" HeaderText="Vegetarisch" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Bijeenkomst" HeaderText="Bijeenkomst" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Ervaring" HeaderText="Ervaring" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Podiumdienst" HeaderText="Podiumdienst" Width="0"/>
							</GridColumns>
						</SfGrid>
					</div>
				</div>
			</div>
			<p />

			@* Overige taken *@
			<h2>Overige taken</h2>
			<div class="col-lg-12 control-section">
				<div class="content-wrapper">
					<div class="row">
						<SfGrid @ref="OtherGridRef"
							@key="FilteredOtherVolunteerList"
								DataSource="@FilteredOtherVolunteerList"
								Width="100%"
								AllowPaging="true"
								AllowSorting="true"
								AllowMultiSorting="true">
							<GridPageSettings PageSize="50" PageSizes="@(new string [ ] { "10", "20", "30", "40", "50", "All" })" />
							<SfToolbar>
								<ToolbarItems>
									<ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
										<Template>
											<SfTextBox Placeholder="Zoek" Input="OnInputOther"></SfTextBox>
										</Template>
									</ToolbarItem>
								</ToolbarItems>
							</SfToolbar>
							<GridColumns>
								<GridColumn Field="Datum" HeaderText="Datum" TextAlign="TextAlign.Center" Type="ColumnType.Date" Format="dd-MM-yyyy" Width="90"/>
								<GridColumn Field="Naam" HeaderText="Naam"/>
								<GridColumn Field="Van" HeaderText="Van" Width="70"/>
								<GridColumn Field="Tot" HeaderText="Tot" Width="70"/>
								<GridColumn Field="Uren" HeaderText="Uren" Width="70" TextAlign="TextAlign.Right"/>
								<GridColumn Field="Lunch" HeaderText="Lunch" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Vegetarisch" HeaderText="Vegetarisch" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Bijeenkomst" HeaderText="Bijeenkomst" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Ervaring" HeaderText="Ervaring" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Overige" HeaderText="Overige" Width="0"/>
							</GridColumns>
						</SfGrid>
					</div>
				</div>
			</div>
			<p />

			@* Afgehaakt *@
			<h2>Afgehaakt</h2>
			<div class="col-lg-12 control-section">
				<div class="content-wrapper">
					<div class="row">
						<SfGrid @ref="DroppedOutGridRef"
							@key="FilteredDroppedOutVolunteerList"
								DataSource="@FilteredDroppedOutVolunteerList"
								Width="100%"
								AllowPaging="true"
								AllowSorting="true"
								AllowMultiSorting="true">
							<GridPageSettings PageSize="50" PageSizes="@(new string [ ] { "10", "20", "30", "40", "50", "All" })" />
							<SfToolbar>
								<ToolbarItems>
									<ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
										<Template>
											<SfTextBox Placeholder="Zoek" Input="OnInputDroppedOut"></SfTextBox>
										</Template>
									</ToolbarItem>
								</ToolbarItems>
							</SfToolbar>
							<GridColumns>
								<GridColumn Field="Datum" HeaderText="Datum" TextAlign="TextAlign.Center" Type="ColumnType.Date" Format="dd-MM-yyyy" Width="90"/>
								<GridColumn Field="Naam" HeaderText="Naam"/>
								<GridColumn Field="Van" HeaderText="Van" Width="70"/>
								<GridColumn Field="Tot" HeaderText="Tot" Width="70"/>
								<GridColumn Field="Uren" HeaderText="Uren" Width="70" TextAlign="TextAlign.Right"/>
								<GridColumn Field="Lunch" HeaderText="Lunch" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Vegetarisch" HeaderText="Vegetarisch" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Bijeenkomst" HeaderText="Bijeenkomst" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Ervaring" HeaderText="Ervaring" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Afgehaakt" HeaderText="Overige" Width="0"/>
							</GridColumns>
						</SfGrid>
					</div>
				</div>
			</div>
		}
	</Authorized>
	<NotAuthorized>
		<p class="text-danger">Je hebt alleen toegang tot deze pagina wanneer je bent ingelogt</p>
	</NotAuthorized>
</AuthorizeView>

@code 
{
	// Declarations
	private SfGrid<Volunteer> StageGridRef;
	private SfGrid<Volunteer> OtherGridRef;
	private SfGrid<Volunteer> DroppedOutGridRef;
	private List<Edition> Editions = new();
	private List<Volunteer> AllVolunteerList = new();
	private List<Volunteer> FilteredStageVolunteerList = new();
	private List<Volunteer> FilteredOtherVolunteerList = new();
	private List<Volunteer> FilteredDroppedOutVolunteerList = new();
	private string? SelectedEditionId;
	private bool IsInitialized; // used to be sure all Refs are initialized

	// Editions list
	protected override async Task OnInitializedAsync()
	{
		Editions = await EditionService.GetEditionsAsync();

		if ( Editions.Any() )
		{
			// Auto select the current festival edition
			SelectedEditionId = Editions
				.OrderByDescending( e => int.Parse( e.Text ) )
				.First().ID;

			// Get the volunteers for the selected edition
			AllVolunteerList = await VolunteerService.GetVolunteersByFestivalIdAsync( Convert.ToUInt32( SelectedEditionId ) );
			ApplyVolunteerFilters();
		}
	}

	// Whenever the selected edition changes the datagrid has to be updated
	private async Task OnEditionChanged( string selectedId )
	{
		SelectedEditionId = selectedId;
		await LoadVolunteersAsync();
		ApplyVolunteerFilters();
		StateHasChanged(); // Force UI rerender to initializeall Refs

		if ( IsInitialized )
		{
			await StageGridRef.Refresh();
			await OtherGridRef.Refresh();
			await DroppedOutGridRef.Refresh();
		}
	}

	// Volunteers
	private async Task LoadVolunteersAsync()
	{
		if ( Convert.ToUInt32( SelectedEditionId ) != 0 )
		{
			AllVolunteerList = await VolunteerService.GetVolunteersByFestivalIdAsync( Convert.ToUInt32( SelectedEditionId ) );
		}
	}

	// Search
	public void OnInputStage( InputEventArgs args )
	{
		this.StageGridRef.SearchAsync( args.Value );
	}

	public void OnInputOther( InputEventArgs args )
	{
		this.OtherGridRef.SearchAsync( args.Value );
	}

	public void OnInputDroppedOut( InputEventArgs args )
	{
		this.DroppedOutGridRef.SearchAsync( args.Value );
	}

	// Make sure all Refs are initialized
	protected override async Task OnAfterRenderAsync( bool firstRender )
	{
		if ( firstRender )
		{
			IsInitialized = true;
		}
	}

	// Apply filtering for the Datasurces of the DataGrids
	private void ApplyVolunteerFilters()
	{
		FilteredStageVolunteerList = AllVolunteerList.Where( v => v.Afgehaakt == "nee" && v.Podiumdienst == "ja" ).ToList();
		FilteredOtherVolunteerList = AllVolunteerList.Where( v => v.Afgehaakt == "nee" && v.Podiumdienst == "nee" ).ToList();
		FilteredDroppedOutVolunteerList = AllVolunteerList.Where( v => v.Afgehaakt == "ja" ).ToList();
	}
}
