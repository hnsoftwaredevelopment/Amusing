@page "/"
@using Amusing.Models
@using Amusing.Services
@using Syncfusion.Blazor.Charts
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations

@inject LoggingService LoggingService;

<PageTitle>Beheer</PageTitle>

<h1>Beheer Amusing-Hengelo</h1>

<AuthorizeView>
    <Authorized>
        @if ( _isLoading )
        {
            <div class="text-center p-2">
                <SfSpinner CssClass="e-spin-center" />
                <p>@FileName worden geladen...</p>
            </div>
        }
        else
        {
            <p class="text-xl-center">Welkom op de beheer pagina van Amusing Hengelo</p>
            <div class="page-container">
                <div class="page-content-left">

                    <SfComboBox TValue="string"
                                TItem="Edition"
                                @bind-Value="SelectedEditionId"
                                Placeholder="Kies een editie"
                                DataSource="@Editions"
                                Width="150px">
                        <ComboBoxFieldSettings Value="ID" Text="Text"></ComboBoxFieldSettings>
                    </SfComboBox>

                    @if ( _hasData )
                    {
                        <SfTab OverflowMode="OverflowMode.Scrollable" Width="600px">

                            <TabItems>

                                <!-- TOTALEN -->
                                <TabItem>
                                    <ChildContent>
                                        <TabHeader Text="Totalen" />
                                    </ChildContent>
                                    <ContentTemplate>
                                        <SfGrid TItem="DashboardStatisticsTotal"
                                                DataSource="_totals"
                                                AllowResizing="true"
                                                AllowReordering="true">
                                            <GridColumns>
                                                <GridColumn Field="Total" HeaderText="Inschrijvingen" Width="100" />
                                                <GridColumn Field="InQueue" HeaderText="In Wacht" Width="80" />
                                                <GridColumn Field="Paid" HeaderText="Betaald" Width="80" />
                                                <GridColumn Field="DroppedOut" HeaderText="Afgehaakt" Width="100" />
                                            </GridColumns>
                                        </SfGrid>
                                    </ContentTemplate>
                                </TabItem>

                                <!-- GENRE -->
                                <TabItem>
                                    <ChildContent>
                                        <TabHeader Text="Genre" />
                                    </ChildContent>
                                    <ContentTemplate>
                                        <SfGrid TItem="DashboardStatisticsGenre"
                                                DataSource="_genre"
                                                AllowResizing="true"
                                                AllowReordering="true"
                                                Height="300px">
                                            <GridColumns>
                                                <GridColumn Field="Genre" HeaderText="Genre" Width="auto" />
                                                <GridColumn Field="Total" HeaderText="Inschrijvingen" Width="100" />
                                                <GridColumn Field="InQueue" HeaderText="In Wacht" Width="80" />
                                                <GridColumn Field="Paid" HeaderText="Betaald" Width="80" />
                                                <GridColumn Field="DroppedOut" HeaderText="Afgehaakt" Width="100" />
                                            </GridColumns>
                                        </SfGrid>
                                    </ContentTemplate>
                                </TabItem>

                                <!-- COUNTRY -->
                                <TabItem>
                                    <ChildContent>
                                        <TabHeader Text="Country" />
                                    </ChildContent>
                                    <ContentTemplate>
                                        <SfGrid TItem="DashboardStatisticsCountry"
                                                DataSource="_country"
                                                AllowResizing="true"
                                                AllowReordering="true">
                                            <GridColumns>
                                                <GridColumn Field="Country" HeaderText="Country" Width="auto" />
                                                <GridColumn Field="Total" HeaderText="Inschrijvingen" Width="100" />
                                                <GridColumn Field="InQueue" HeaderText="In Wacht" Width="80" />
                                                <GridColumn Field="Paid" HeaderText="Betaald" Width="80" />
                                                <GridColumn Field="DroppedOut" HeaderText="Afgehaakt" Width="100" />
                                            </GridColumns>
                                        </SfGrid>
                                    </ContentTemplate>
                                </TabItem>

                                <!-- PODIUMTYPE -->
                                <TabItem>
                                    <ChildContent>
                                        <TabHeader Text="Podiumtype" />
                                    </ChildContent>
                                    <ContentTemplate>
                                        <SfGrid TItem="DashboardStatisticsStage"
                                                DataSource="_stage"
                                                AllowResizing="true"
                                                AllowReordering="true">
                                            <GridColumns>
                                                <GridColumn Field="Stagetype" HeaderText="Podium" Width="auto" />
                                                <GridColumn Field="Total" HeaderText="Inschrijvingen" Width="100" />
                                                <GridColumn Field="InQueue" HeaderText="In Wacht" Width="80" />
                                                <GridColumn Field="Paid" HeaderText="Betaald" Width="80" />
                                                <GridColumn Field="DroppedOut" HeaderText="Afgehaakt" Width="100" />
                                            </GridColumns>
                                        </SfGrid>
                                    </ContentTemplate>
                                </TabItem>

                                <!-- PIVOT -->
                                <TabItem>
                                    <ChildContent>
                                        <TabHeader Text="Zangersverdeling" />
                                    </ChildContent>
                                    <ContentTemplate>
                                        <SfGrid TItem="DashboardSubscriptionsPivot"
                                                DataSource="_pivot"
                                                AllowResizing="true"
                                                AllowReordering="true">
                                            <GridColumns>
                                                <GridColumn Field="DeelnemersCategorie" HeaderText="Categorie" Width="auto" />

                                                @foreach ( var col in _pivotColumns )
                                                {
                                                    <GridColumn Field="@col" HeaderText="@col" Width="60" TextAlign="TextAlign.Center" />
                                                }
                                            </GridColumns>
                                        </SfGrid>
                                    </ContentTemplate>
                                </TabItem>

                            </TabItems>
                        </SfTab>
                    }
                    else
                    {
                        <p>Voor de geselecteerde editie zijn nog geen statistieken beschikbaar</p>
                    }
                </div>

                <div class="page-content-right">

                    <SfComboBox TValue="int"
                                TItem="int"
                                @bind-Value="SelectedYears"
                                DataSource="@Years"
                                Placeholder="Aantal jaren"
                                Width="150px">
                    </SfComboBox>

                    <SfChart Title="Inschrijvingen per maand" Height="350px">
                        <ChartEvents OnAxisLabelRender="OnXAxisLabelRender"></ChartEvents>

                        <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Double"
                                            Interval="1"
                                            LabelIntersectAction="LabelIntersectAction.Rotate45"
                                            LabelPlacement="LabelPlacement.BetweenTicks"
                                            EdgeLabelPlacement="EdgeLabelPlacement.Shift"
                                            LabelStyle="@(new ChartAxisLabelStyle { Size = "12px" })">
                        </ChartPrimaryXAxis>

                        <ChartPrimaryYAxis LabelFormat="{value}"
                                           Interval="20"
                                           Minimum="0"
                                           Maximum="@YAxisMax">
                        </ChartPrimaryYAxis>

                        @foreach ( var (festivalGroup, index) in _graph
                                            .GroupBy( x => x.Festival )
                                            .OrderByDescending( g => int.Parse( g.Key ) )
                                            .Select( ( grp, idx ) => (grp, idx) ) )   // Pair with index
                        {
                            // Bepaal het hoogste jaar
                            var isMostRecent = int.Parse(festivalGroup.Key) == _graph.Max(x => int.Parse(x.Festival));

                            // Gebruik standaard kleur, behalve als het de meest recente is
                            var color = isMostRecent ? "red" : _seriesColors[Math.Min(index, _seriesColors.Length - 1)];

                            // Lijnbreedte iets dikker voor meest recente
                            var width = isMostRecent ? 3 : 1.5;

                            <ChartSeries DataSource="festivalGroup.OrderBy( x => x.MonthOrder )"
                                         XName="MonthOrder"
                                         YName="Number"
                                         Name="@festivalGroup.Key"
                                         Fill="@color"
                                         Width="@width"
                                         Type="ChartSeriesType.Spline">
                                <ChartMarker Visible="true" Width="5" Height="5"></ChartMarker>
                            </ChartSeries>
                        }
                    </SfChart>
                </div>

                <!-- Log footer -->
                <div class="log-footer">
                    <SfToolbar>
                        <ToolbarItems>
                            <ToolbarItem Type="ItemType.Input"
                                         Align="Syncfusion.Blazor.Navigations.ItemAlign.Right"
                                         Width="120px">
                                <Template>
                                    <SfTextBox @ref="@searchBox"
                                               Created="@AddSearchIcon"
                                               Placeholder="Zoek in de lijst"
                                               Input="OnInput" />
                                </Template>
                            </ToolbarItem>
                        </ToolbarItems>
                    </SfToolbar>

                    <SfGrid @ref="_gridLog"
                            TItem="LogModel"
                            DataSource="_loggingList"
                            AllowSorting="true"
                            EnableVirtualization="true"
                            AllowResizing="true"
                            Height="180px">
                        <GridSearchSettings IgnoreAccent="true" />
                        <GridColumns>
                            <GridColumn Field="LogDateOnly" HeaderText="Datum" Width="100" />
                            <GridColumn Field="LogTimeOnly" HeaderText="Tijdstip" Width="80" />
                            <GridColumn Field="LogArea" HeaderText="Onderdeel" Width="170" />
                            <GridColumn Field="LogAction" HeaderText="Actie" Width="170" />
                            <GridColumn Field="LogReport" HeaderText="Resultaat" />
                        </GridColumns>
                    </SfGrid>
                </div>

            </div>
        }
    </Authorized>

    <NotAuthorized>
        <p class="text-danger">Let op, je bent nog niet ingelogd</p>
    </NotAuthorized>
</AuthorizeView>