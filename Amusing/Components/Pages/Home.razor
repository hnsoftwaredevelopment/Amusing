@page "/"
@using Amusing.Models
@using Amusing.Services
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations

@inject LoggingService LoggingService;

<PageTitle>Beheer</PageTitle>

<h1>Beheer Amusing-Hengelo</h1>

<AuthorizeView>
	<Authorized>
		@if (_isLoading)
		{
			<div class="text-center p-2">
				<SfSpinner CssClass="e-spin-center" />
				<p>@FileName worden geladen...</p>
			</div>
		}
		else
		{
			<div class="page-container">
				<div class="page-content">
					<p class="text-xl-center">Welkom op de beheer pagina van Amusing Hengelo</p>
					<p class="text-break"/>
					<SfComboBox 
						TValue="string"
						TItem="Edition"
						@bind-Value="SelectedEditionId"
						Placeholder="Kies een editie"
						DataSource="@Editions"
						Width="150px">
						<ComboBoxFieldSettings Value="ID" Text="Text"></ComboBoxFieldSettings>
					</SfComboBox>
					<p />

					@if ( _hasData )
					{
						<SfTab OverflowMode="OverflowMode.Scrollable" Width="600px">
							<TabItems>
								<TabItem>
									<ChildContent>
										<TabHeader Text="Totalen" />
									</ChildContent>
									<ContentTemplate>
										<div>
											<SfGrid TItem="DashboardStatisticsTotal" DataSource="_totals" AllowResizing="true" AllowReordering="true">
												<GridColumns>
													<GridColumn Field="Total"		HeaderText="Inschrijvingen"		Width="100"/>
													<GridColumn Field="InQueue"		HeaderText="In Wacht"	Width="80"/>
													<GridColumn Field="Paid"		HeaderText="Betaald"	Width="80"/>
													<GridColumn Field="DroppedOut"	HeaderText="Afgehaakt"	Width="100"/>
												</GridColumns>
											</SfGrid>
										</div>
									</ContentTemplate>
								</TabItem>

								<TabItem>
									<ChildContent>
										<TabHeader Text="Genre" />
									</ChildContent>
									<ContentTemplate>
										<div>
											<SfGrid TItem="DashboardStatisticsGenre" DataSource="_genre" AllowResizing="true" AllowReordering="true" Height="300px">
												<GridColumns>
													<GridColumn Field="Genre"		HeaderText="Genre"		Width="auto" />
													<GridColumn Field="Total"		HeaderText="Inschrijvingen" Width="100" />
													<GridColumn Field="InQueue"		HeaderText="In Wacht"	Width="80" />
													<GridColumn Field="Paid"		HeaderText="Betaald"	Width="80" />
													<GridColumn Field="DroppedOut"	HeaderText="Afgehaakt"	Width="100" />
												</GridColumns>
											</SfGrid>
										</div>
									</ContentTemplate>
								</TabItem>

								<TabItem>
									<ChildContent>
										<TabHeader Text="Country" />
									</ChildContent>
									<ContentTemplate>
										<div>
											<SfGrid TItem="DashboardStatisticsCountry" DataSource="_country" AllowResizing="true" AllowReordering="true">
												<GridColumns>
													<GridColumn Field="Country" HeaderText="Country" Width="auto" />
													<GridColumn Field="Total" HeaderText="Inschrijvingen" Width="100" />
													<GridColumn Field="InQueue" HeaderText="In Wacht" Width="80" />
													<GridColumn Field="Paid" HeaderText="Betaald" Width="80" />
													<GridColumn Field="DroppedOut" HeaderText="Afgehaakt" Width="100" />
												</GridColumns>
											</SfGrid>
										</div>
									</ContentTemplate>
								</TabItem>

								<TabItem>
									<ChildContent>
										<TabHeader Text="Podiumtype" />
									</ChildContent>
									<ContentTemplate>
										<div>
											<SfGrid TItem="DashboardStatisticsStage" DataSource="_stage" AllowResizing="true" AllowReordering="true">
												<GridColumns>
													<GridColumn Field="Stagetype" HeaderText="Podium" Width="auto" />
													<GridColumn Field="Total" HeaderText="Inschrijvingen" Width="100" />
													<GridColumn Field="InQueue" HeaderText="In Wacht" Width="80" />
													<GridColumn Field="Paid" HeaderText="Betaald" Width="80" />
													<GridColumn Field="DroppedOut" HeaderText="Afgehaakt" Width="100" />
												</GridColumns>
											</SfGrid>
										</div>
									</ContentTemplate>
								</TabItem>

								<TabItem>
									<ChildContent>
										<TabHeader Text="Zangersverdeling" />
									</ChildContent>
									<ContentTemplate>
										<div>
											<SfGrid TItem="DashboardSubscriptionsPivot" DataSource="_pivot" AllowResizing="true" AllowReordering="true">
												<GridColumns>

													<GridColumn Field="DeelnemersCategorie" HeaderText="Aantal" Width="auto" />

													@foreach ( var col in _pivotColumns )
													{
														<GridColumn Field="@col" HeaderText="@col" Width="60" TextAlign="TextAlign.Center" />
													}

												</GridColumns>
											</SfGrid>
										</div>
									</ContentTemplate>
								</TabItem>
							</TabItems>
						</SfTab>
					}
					else
					{
						<p>Voor de geselecteerde editie zijn nog geen statistieken beschikbaar</p>
					}
				</div>

				<div class="log-footer">
					<SfToolbar>
						<ToolbarItems>
							<ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right" Width="120px">
								<Template>
									<SfTextBox @ref="@searchBox" Created="@AddSearchIcon" Placeholder="Zoek in de lijst" Input="OnInput"></SfTextBox>
								</Template>
							</ToolbarItem>
						</ToolbarItems>
					</SfToolbar>

					<SfGrid @ref="_gridLog"
							TItem="LogModel"
							DataSource="_loggingList"
							AllowSorting="true" EnableVirtualization="true"
							AllowResizing="true"
							Height="180px">
						<GridSearchSettings IgnoreAccent="true" />
						<GridColumns>
							<GridColumn Field="LogDateOnly" HeaderText="Datum" Width="100" />
							<GridColumn Field="LogTimeOnly" HeaderText="Tijdstip" Width="80" />
							<GridColumn Field="LogArea" HeaderText="Onderdeel" Width="170" />
							<GridColumn Field="LogAction" HeaderText="Aktie" Width="170" />
							<GridColumn Field="LogReport" HeaderText="Resultaat" />
						</GridColumns>
					</SfGrid>
				</div>
			</div>
		}
	</Authorized>
	<NotAuthorized>
		<p class="text-danger">Let op, je bent nog niet ingelogd</p>
	</NotAuthorized>
</AuthorizeView>
