@page "/Overview-VolunteerTasks"
@using Amusing.Models
@using Amusing.Services
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@using System.Text
@using System.Drawing
@using Syncfusion.XlsIO
@inject EditionService EditionService
@inject VolunteerService VolunteerService
@inject IJSRuntime JS
@inherits OverviewVolunteers

<AuthorizeView>
	<Authorized>
		<h3>Vrijwilligerstaken</h3>
		<p />
		<div class="grid-layout">
		<SfComboBox TValue="string"
					TItem="Edition"
					Placeholder="Kies een editie"
					ValueChanged="OnEditionChanged"
					DataSource="@Editions"
					Width="150px">
			<ComboBoxFieldSettings Value="ID" Text="Text"></ComboBoxFieldSettings>
		</SfComboBox>

		@if ( SelectedEditionId != null && AllVolunteerList.Count > 0 )
		{
				<button @onclick="ExportToExcel" title="Exporteer alle vrijwilligers naar een Excel bestand">
					<img src="/icons/excel.svg" width="25" class="icon" alt="Excel" />
                </button>

				<button @onclick="ExportToCsv" title="Exporteer alle vrijwilligers naar een CSV bestand">
					<img src="icons/csv.svg" width="25" class="icon" alt="CSV" />
				</button>

				<button @onclick="ExportToPdf" title="Maak een PDF bestand met alle vrijwilligers">
					<img src="icons/pdf.svg" width="25" class="icon" alt="PDF" />
				</button>
			}
		</div>
		<p />

		@* This DataGrid should always be invisible, it is only used to be able to export all vulunteers *@ 
		<div class="col-lg-12 control-section">
			<div class="content-wrapper">
				<div class="row">
					<SfGrid @ref="GridRef"
							@key="AllVolunteerList"
							DataSource="@AllVolunteerList" AllowExcelExport="true" AllowPdfExport="true"
								Width="100%" style="display: none;">

						<GridColumns>
							<GridColumn Field="Datum" HeaderText="Datum" TextAlign="TextAlign.Center" Type="ColumnType.Date" Format="dd-MM-yyyy" Width="90" />
							<GridColumn Field="Naam" HeaderText="Naam" />
							<GridColumn Field="Van" HeaderText="Van" Width="70" />
							<GridColumn Field="Tot" HeaderText="Tot" Width="70" />
							<GridColumn Field="Uren" HeaderText="Uren" Width="70" TextAlign="TextAlign.Right" />
							<GridColumn Field="Lunch" HeaderText="Lunch" Width="80" TextAlign="TextAlign.Center" />
							<GridColumn Field="Vegetarisch" HeaderText="Vegetarisch" Width="80" TextAlign="TextAlign.Center" />
							<GridColumn Field="Bijeenkomst" HeaderText="Bijeenkomst" Width="80" TextAlign="TextAlign.Center" />
							<GridColumn Field="Ervaring" HeaderText="Ervaring" Width="80" TextAlign="TextAlign.Center" />
                            <GridColumn Field="Podiumdienst" HeaderText="Podiumdienst" Width="70" />
                            <GridColumn Field="Overige" HeaderText="Overige" Width="70" />
                            <GridColumn Field="Afgehaakt" HeaderText="Afgehaakt" Width="70" />
                        </GridColumns>
					</SfGrid>
				</div>
			</div>
		</div>

		@if ( SelectedEditionId != null && AllVolunteerList.Count > 0 )
		{
			@* Podiumdienst *@
			<h2>Podiumdienst</h2>
			<div class="col-lg-12 control-section">
				<div class="content-wrapper">
					<div class="row">
						<SfGrid @ref="StageGridRef" 
							@key="FilteredStageVolunteerList"
								DataSource="@FilteredStageVolunteerList"
								Width="100%"
								AllowSorting="true"
								AllowMultiSorting="true">

							<SfToolbar>
								<ToolbarItems>
									<ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
										<Template>
											<span class="toolbar-count">Vrijwilligers: @VisibleRowCountStage</span>
										</Template>
									</ToolbarItem>

									<ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
										<Template>
											<SfTextBox Placeholder="Zoek" Input="OnInputStage"></SfTextBox>
										</Template>
									</ToolbarItem>
								</ToolbarItems>
							</SfToolbar>

							<GridColumns>
								<GridColumn Field="Datum" HeaderText="Datum" TextAlign="TextAlign.Center" Type="ColumnType.Date" Format="dd-MM-yyyy" Width="90"/>
								<GridColumn Field="Naam" HeaderText="Naam"/>
								<GridColumn Field="Van" HeaderText="Van" Width="70"/>
								<GridColumn Field="Tot" HeaderText="Tot" Width="70"/>
								<GridColumn Field="Uren" HeaderText="Uren" Width="70" TextAlign="TextAlign.Right"/>
								<GridColumn Field="Lunch" HeaderText="Lunch" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Vegetarisch" HeaderText="Vegetarisch" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Bijeenkomst" HeaderText="Bijeenkomst" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Ervaring" HeaderText="Ervaring" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Podiumdienst" HeaderText="Podiumdienst" Width="0"/>
							</GridColumns>
						</SfGrid>
					</div>
				</div>
			</div>
			<p />

			@* Overige taken *@
			<h2>Overige taken</h2>
			<div class="col-lg-12 control-section">
				<div class="content-wrapper">
					<div class="row">
						<SfGrid @ref="OtherGridRef"
							@key="FilteredOtherVolunteerList"
								DataSource="@FilteredOtherVolunteerList"
								Width="100%"
								AllowSorting="true"
								AllowMultiSorting="true">

							<SfToolbar>
								<ToolbarItems>
									<ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
										<Template>
											<span class="toolbar-count">Vrijwilligers: @VisibleRowCountOther</span>
										</Template>
									</ToolbarItem>

									<ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
										<Template>
											<SfTextBox Placeholder="Zoek" Input="OnInputOther"></SfTextBox>
										</Template>
									</ToolbarItem>
								</ToolbarItems>
							</SfToolbar>

							<GridColumns>
								<GridColumn Field="Datum" HeaderText="Datum" TextAlign="TextAlign.Center" Type="ColumnType.Date" Format="dd-MM-yyyy" Width="90"/>
								<GridColumn Field="Naam" HeaderText="Naam"/>
								<GridColumn Field="Van" HeaderText="Van" Width="70"/>
								<GridColumn Field="Tot" HeaderText="Tot" Width="70"/>
								<GridColumn Field="Uren" HeaderText="Uren" Width="70" TextAlign="TextAlign.Right"/>
								<GridColumn Field="Lunch" HeaderText="Lunch" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Vegetarisch" HeaderText="Vegetarisch" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Bijeenkomst" HeaderText="Bijeenkomst" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Ervaring" HeaderText="Ervaring" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Overige" HeaderText="Overige" Width="0"/>
							</GridColumns>
						</SfGrid>
					</div>
				</div>
			</div>
			<p />

			@* Afgehaakt *@
			<h2>Afgehaakt</h2>
			<div class="col-lg-12 control-section">
				<div class="content-wrapper">
					<div class="row">
						<SfGrid @ref="DroppedOutGridRef"
							@key="FilteredDroppedOutVolunteerList"
								DataSource="@FilteredDroppedOutVolunteerList"
								Width="100%"
								AllowSorting="true"
								AllowMultiSorting="true">

							<SfToolbar>
								<ToolbarItems>
									<ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
										<Template>
											<span class="toolbar-count">Vrijwilligers: @VisibleRowCountDroppedOut</span>
										</Template>
									</ToolbarItem>

									<ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
										<Template>
											<SfTextBox Placeholder="Zoek" Input="OnInputDroppedOut"></SfTextBox>
										</Template>
									</ToolbarItem>
								</ToolbarItems>
							</SfToolbar>

							<GridColumns>
								<GridColumn Field="Datum" HeaderText="Datum" TextAlign="TextAlign.Center" Type="ColumnType.Date" Format="dd-MM-yyyy" Width="90"/>
								<GridColumn Field="Naam" HeaderText="Naam"/>
								<GridColumn Field="Van" HeaderText="Van" Width="70"/>
								<GridColumn Field="Tot" HeaderText="Tot" Width="70"/>
								<GridColumn Field="Uren" HeaderText="Uren" Width="70" TextAlign="TextAlign.Right"/>
								<GridColumn Field="Lunch" HeaderText="Lunch" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Vegetarisch" HeaderText="Vegetarisch" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Bijeenkomst" HeaderText="Bijeenkomst" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Ervaring" HeaderText="Ervaring" Width="80" TextAlign="TextAlign.Center"/>
								<GridColumn Field="Afgehaakt" HeaderText="Afgehaakt" Width="0"/>
							</GridColumns>
						</SfGrid>
					</div>
				</div>
			</div>
		}
	</Authorized>
	<NotAuthorized>
		<p class="text-danger">Je hebt alleen toegang tot deze pagina wanneer je bent ingelogt</p>
	</NotAuthorized>
</AuthorizeView>