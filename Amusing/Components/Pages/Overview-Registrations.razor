@page "/Overview-Registrations"
@using Amusing.Models
@using Amusing.Services
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@using System.ComponentModel.DataAnnotations
@inject EditionService EditionService
@inject RegistrationService RegistrationService

<AuthorizeView>
	<Authorized>
		<h3>Inschrijvingen per Amusing editie</h3>
		<p />
		<SfComboBox 
			TValue="string" 
			TItem="Edition" 
			Placeholder="Kies een editie" 
			ValueChanged="OnEditionChanged"
			DataSource="@Editions" 
			Width="150px">
			<ComboBoxFieldSettings Value="ID" Text="Text"></ComboBoxFieldSettings>
		</SfComboBox>
		<p />

		@if ( SelectedEditionId != null)
		{
			<div class="col-lg-12 control-section">
				<div class="content-wrapper">
					<div class="row">
						<SfGrid 
							@ref="GridRef" 
							DataSource="@RegistrationList" 
							Width="100%" 
							AllowExcelExport="true" AllowPdfExport="true"
							AllowSorting="true"
							AllowMultiSorting="true">

							<SfToolbar>
								<ToolbarItems>
									<ToolbarItem Type="ItemType.Button">
										<Template>
											<button class="custom-toolbar-btn" @onclick="ExportToExcel" title="Exporteer naar een Excel bestand">
												<img src="icons/excel.svg" class="icon" alt="Excel"/>
											</button>
										</Template>
									</ToolbarItem>

									<ToolbarItem Type="ItemType.Button">
										<Template>
											<button class="custom-toolbar-btn" @onclick="ExportToCsv" title="Exporteer naar een CSV bestand">
												<img src="icons/csv.svg" class="icon" alt="CSV" />
											</button>
										</Template>
									</ToolbarItem>

									<ToolbarItem Type="ItemType.Button">
										<Template>
											<button class="custom-toolbar-btn" @onclick="ExportToPdf" title="Maak een PDF bestand">
												<img src="icons/pdf.svg" class="icon" alt="PDF" />
											</button>
										</Template>
									</ToolbarItem>


									<ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
										<Template>
											<span class="toolbar-count">Inschrijvingen: @VisibleRowCount</span>
										</Template>
									</ToolbarItem>

									<ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
										<Template>
											<SfTextBox Placeholder="Zoek" Input="OnInput"></SfTextBox>
										</Template>
									</ToolbarItem>
								</ToolbarItems>
							</SfToolbar>

							<GridTemplates>
								<EmptyRecordTemplate Context="data">
									<div class="emptyRecordTemplate text-center">
										<span>
											@( ( SelectedEditionId == null )
																					? "Geen festival editie geselecteerd"
																					: $"Geen inschrijvingen gevonden voor editie {SelectedEditionText}")
									</span>
									</div>
								</EmptyRecordTemplate>
							</GridTemplates>

							<GridColumns>
								<GridColumn Field="Datum" HeaderText="Datum" TextAlign="TextAlign.Center" Type="ColumnType.Date" Format="dd-MM-yyyy" Width="90"></GridColumn>
								<GridColumn Field="Naam" HeaderText="Naam"></GridColumn>
								<GridColumn Field="Stad" HeaderText="Stad" Width="180"></GridColumn>
								<GridColumn Field="Podium" HeaderText="Podium" Width="70" TextAlign="TextAlign.Center"></GridColumn>
								<GridColumn Field="Zangers" HeaderText="Zangers" TextAlign="TextAlign.Center" Width="70"></GridColumn>
								<GridColumn Field="Genre" HeaderText="Genre" Width="100"></GridColumn>
								<GridColumn Field="TeBetalen (€)" HeaderText="Te Betalen" Format="N2" Width="110" TextAlign="TextAlign.Right"></GridColumn>
								<GridColumn Field="Betaald" HeaderText="Betaald" Width="75" TextAlign="TextAlign.Center"></GridColumn>
								<GridColumn Field="Bevestigd" HeaderText="Bevestigd" Width="80" TextAlign="TextAlign.Center"></GridColumn>
								<GridColumn Field="Kleedkamer" HeaderText="Kleedkamer" Width="100" TextAlign="TextAlign.Center"></GridColumn>
								<GridColumn Field="Binnen" HeaderText="Binnen" Width="70" TextAlign="TextAlign.Center"></GridColumn>
								<GridColumn Field="Buiten" HeaderText="Buiten" Width="70" TextAlign="TextAlign.Center"></GridColumn>
							</GridColumns>
						</SfGrid>
					</div>
				</div>
			</div>
		}
	</Authorized>
	<NotAuthorized>
		<p class="text-danger">Je hebt alleen toegang tot deze pagina wanneer je bent ingelogt</p>
	</NotAuthorized>
</AuthorizeView>

@code 
{
	private SfGrid<RegistrationModel> GridRef;
	private List<Edition> Editions = new();
	private List<RegistrationModel> RegistrationList = new();
	private string? SelectedEditionId;
	private int VisibleRowCount = 0;

	private string SelectedEditionText => Editions.FirstOrDefault( e => e.ID == SelectedEditionId )?.Text ?? "Onbekende editie";

	protected override async Task OnInitializedAsync()
	{
		Editions = await EditionService.GetEditionsAsync();

		if ( Editions.Any() )
		{
			// Auto select the current festival edition
			SelectedEditionId = Editions
				.OrderByDescending( e => int.Parse( e.Text ) )
				.First().ID;

			// Get the registrations for the selected edition
			RegistrationList = await RegistrationService.GetRegistrationsByFestivalIdAsync( Convert.ToUInt32( SelectedEditionId) );
			if ( SelectedEditionId != null && RegistrationList.Count > 0 )
			{
				await UpdateVisibleRowCount();
			}
		}
	}

	// Whenever the selected edition changes the datagrid has to be updated
	private async Task OnEditionChanged( string selectedId )
	{
		if ( string.IsNullOrWhiteSpace( selectedId ) )
			return;

		SelectedEditionId = selectedId;

		await LoadRegistrationsAsync();

		if ( GridRef != null )
		{
			await GridRef.Refresh();
			VisibleRowCount = RegistrationList.Count;
		}
	}

	private async Task LoadRegistrationsAsync()
	{
		if ( Convert.ToUInt32( SelectedEditionId ) != 0 )
		{
			RegistrationList = await RegistrationService.GetRegistrationsByFestivalIdAsync( Convert.ToUInt32( SelectedEditionId ) );
		}
	}

	// Manage direct search functionality
	public void OnInput( InputEventArgs args )
	{
		this.GridRef.SearchAsync( args.Value );

		// Count the Number of visible rows
		_ = Task.Run( async () =>
		{
			await Task.Delay( 200 ); // Short delay to handle fast typers
			await InvokeAsync( UpdateVisibleRowCount );
		} );
	}

	// Export functions
	private async Task ExportToExcel()
	{
		var exportProps = new ExcelExportProperties
		{
			FileName = $"Inschrijvingen {SelectedEditionText}-{DateTime.Now:yyyyMMdd}-{DateTime.Now:HHmm}.xlsx"
		};

		await GridRef!.ExportToExcelAsync( exportProps );
	}

	private async Task ExportToCsv()
	{
		var exportProps = new ExcelExportProperties
		{
			FileName = $"Inschrijvingen {SelectedEditionText}-{DateTime.Now:yyyyMMdd}-{DateTime.Now:HHmm}.csv"
		};

		await GridRef!.ExportToCsvAsync( exportProps );
	}

	private async Task ExportToPdf()
	{
		var exportProps = new PdfExportProperties
		{
			FileName = $"Inschrijvingen {SelectedEditionText}-{DateTime.Now:yyyyMMdd}-{DateTime.Now:HHmm}.pdf",
			PageOrientation = PageOrientation.Landscape,
			PageSize=PdfPageSize.A4,
			AllowHorizontalOverflow = true
		};
		await GridRef!.ExportToPdfAsync( exportProps );
	}

	// Visible row count (Number of records on screen)
	private async Task UpdateVisibleRowCount()
	{
		var data = await GridRef.GetCurrentViewRecordsAsync();
		VisibleRowCount = data?.Count ?? 0;
	}
}
