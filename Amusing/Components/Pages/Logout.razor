@page "/logout"
@using Amusing.Services
@using Amusing.Helpers
@inject CustomAuthStateProvider AuthStateProvider
@inject LoggingService LoggingService
@inject UserContextHelper UserContextHelper
@inject NavigationManager Navigation

@code
{
    protected override async Task OnInitializedAsync()
    {
        string _userName = await UserContextHelper.GetUsernameAsync();

        string _report = $"{_userName} is uitgelogd";
        string _status = "success";

        await LoggingService.WriteUserLogoutAttemptAsync( _status, _report );

        await AuthStateProvider.MarkUserAsLoggedOut();

        Navigation.NavigateTo( "/", forceLoad: true );
    }
}
