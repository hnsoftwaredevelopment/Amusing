@page "/Maintenance-Tasks"
@using Amusing.Models
@using Amusing.Services
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@using System.ComponentModel.DataAnnotations
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.RichTextEditor
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.SplitButtons
@using System.Text.Json

@if (IsLoading)
{
    <div class="text-center p-2">
        <SfSpinner CssClass="e-spin-center" />
        <p>@FileName worden geladen...</p>
    </div>
}
else
{
    <div class="page-container maintenance-page">
        <!-- Static detail fields-->
        <div class="fixed-header maintenance-page__header">
            <h3>Onderhoud @FileName</h3>
            <EditForm Model="SelectedTask">
                <div class="form-row" style="display:flex; align-items:flex-end; gap:8px;">
                    <SfTextBox Placeholder="Korte naam" FloatLabelType="FloatLabelType.Always" Width="90px" @bind-Value="TaskShortName" />
                    <SfTextBox Placeholder="Naam" FloatLabelType="FloatLabelType.Always" Width="200px" @bind-Value="TaskName" />
                    <SfNumericTextBox Placeholder="Minimumduur" FloatLabelType="FloatLabelType.Always" Width="100px" @bind-Value="TaskMinTimeSpan" Min=0 Max=600 ShowSpinButton=false />
                    <SfNumericTextBox Placeholder="Maximumduur" FloatLabelType="FloatLabelType.Always" Width="100px" @bind-Value="TaskMaxTimeSpan" Min=0 Max=600 ShowSpinButton=false />
                    <BitTooltip Text="@(IsActive ? "Deze taak is actief, klik om te deactiveren" : "Deze taak is niet actief, klik om te activeren")" HideDelay="200" ShowOnHover="true">
                        <BitToggleButton @bind-IsChecked="IsActive" OnClick="TaskActivation"
                                         Text="@(IsActive ? "Aktief" : "Niet aktief")"
                                         Styles="@(new() { Root = "height: 32px;  min-height: 32px; width: 100px; border-radius: 16px; vertical-align: bottom; --toggle-background: red; background: var(--toggle-background); border: none", Checked = "--toggle-background: green;", Text = "color: white;" })" />
                    </BitTooltip>
                </div>
                
                <hr/>
                
                <div class="container-fluid">
                    <div class="row justify-content-start">
                        <div class="col-auto">
                            <div class="tijdvak">
                                <div class="tijdvak-header">Tijdvak 1</div>
                                <div class="tijdvak-content">
                                    <Syncfusion.Blazor.Calendars.SfTimePicker TValue="TimeOnly?" Format="HH:mm" Placeholder="Van" FloatLabelType="FloatLabelType.Always" Width="90px" @bind-Value="TaskTimeBlock1From" />
                                    <Syncfusion.Blazor.Calendars.SfTimePicker TValue="TimeOnly?" Format="HH:mm" Placeholder="Tot" FloatLabelType="FloatLabelType.Always" Width="90px" @bind-Value="TaskTimeBlock1Until" />
                                    <SfNumericTextBox Placeholder="Aantal" FloatLabelType="FloatLabelType.Always" Width="90px" @bind-Value="TaskTimeBlock1Volunteers" ShowSpinButton=false />
                                </div>
                            </div>
                        </div>

                        <div class="col-auto">
                            <div class="tijdvak">
                                <div class="tijdvak-header">Tijdvak 2</div>
                                <div class="tijdvak-content">
                                    <Syncfusion.Blazor.Calendars.SfTimePicker TValue="TimeOnly?" Format="HH:mm" Placeholder="Van" FloatLabelType="FloatLabelType.Always" Width="90px" @bind-Value="TaskTimeBlock2From" />
                                    <Syncfusion.Blazor.Calendars.SfTimePicker TValue="TimeOnly?" Format="HH:mm" Placeholder="Tot" FloatLabelType="FloatLabelType.Always" Width="90px" @bind-Value="TaskTimeBlock2Until" />
                                    <SfNumericTextBox Placeholder="Aantal" FloatLabelType="FloatLabelType.Always" Width="90px" @bind-Value="TaskTimeBlock2Volunteers" ShowSpinButton=false />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr/>

                <div class="form-row">
                    <label for="rteBeschrijving">Beschrijving</label>
                    <SfRichTextEditor 
                        ID="rteBeschrijving"
                        @ref="Rte" 
                        Width="680px" SaveInterval="500"
                        Placeholder="Beschrijving"
                        Height="150px"
                        @bind-Value="@TaskDescription" />
                </div>

                <div class="spacer-medium"/>
            </EditForm>

            <!-- Toolbar -->
            <div class="maintenance-toolbar-shell">
                <SfToolbar Width="870px">
                    <ToolbarItems>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn"
                                        @onclick="Save"
                                        title="Bewaar de taak">
                                    <img src="icons/button-save.svg" class="icon" alt="SAVE" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Button">
                            <Template>
                                <button class="custom-toolbar-btn" @onclick="AddNew" title="Voeg een nieuw taak toe">
                                    <img src="icons/button-add.svg" class="icon" alt="ADD" />
                                </button>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
                            <Template>
                                <span class="toolbar-count">@FileName: @VisibleRowCount</span>
                            </Template>
                        </ToolbarItem>
                        <ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
                            <Template>
                                <SfTextBox Placeholder="Zoek" Input="OnInput"></SfTextBox>
                            </Template>
                        </ToolbarItem>
                    </ToolbarItems>
                </SfToolbar>
            </div>
        </div>

        <div class="spacer-small"></div>

        <!-- Scrollable area for main datagrid -->
        <div class="scrollable-content maintenance-page__content">
            <div class="maintenance-grid-shell maintenance-grid-shell--fit">
                <SfGrid @ref="GridRef"
                        TValue="TaskModel" 
                        Width="870"
                        DataSource="@Tasks"
                        EnableStickyHeader="true"
                        CssClass="maintenance-grid"
                        AllowResizing="true"
                        Height="100%"
                        AllowSorting="true"
                        AllowMultiSorting="true"
                        AllowSelection="true">
                    <GridEvents TValue="TaskModel" DataBound="OnGridDataBound" RowSelected="OnRowSelected" />
                    <GridEditSettings AllowAdding="true" NewRowPosition="NewRowPosition.Top"></GridEditSettings>
                    <GridColumns>
                        <GridColumn Field="TaskId" IsPrimaryKey="true" Visible="false" />
                        <GridColumn Field="ShortName" HeaderText="Korte naam" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="160px" />
                        <GridColumn Field="Name" HeaderText="Naam" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="300px" />
                        <GridColumn Field="MinTimeSpan" HeaderText="Minimumduur" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="130px" />
                        <GridColumn Field="MaxTimeSpan" HeaderText="Maximumduur" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" Width="130px" />

                        <GridColumn Field="Active" HeaderText="Status" Width="115px">
                            <Template>
                                @{
                                    var task = (TaskModel)context;
                                }
                                <BitToggleButton IsChecked="@task.IsActive"
                                                 Disabled="true"
                                                 Styles="@(new()
                                                 {
                                                     Root = "display:inline-block; vertical-align:bottom; height:32px; min-height:32px; width:100px; border-radius:16px; --toggle-background:red; background:var(--toggle-background); border:none;",
                                                     Checked = "--toggle-background:green;",
                                                     Text = "color:white;"
                                                 })"
                                             Text="@(task.IsActive ? "Actief" : "Niet actief")" />
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    </div>
    </div>
}
