@page "/Lists-Groups"
@using Amusing.Models
@using Amusing.Services
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations

@inject RegistrationService RegistrationService

<h3>Overzicht van deelname per groep per festival</h3>
<label for="FilterOutOldGroups" style="padding: 10px 10px 10px 0">Toon koren die voor @(FilterOnFestival) zijn aangemaakt maar na @(FilterOnFestival) niet meer hebben deelgenomen</label>

<SfSwitch Checked="FilterOutOldGroups" CheckedChanged="@(async ( bool val ) => await OnFilterChanged( val ))" />

@if (IsLoading)
{
    <div class="text-center p-2">
        <SfSpinner CssClass="e-spin-center" />
        <p>Gegevens worden geladen...</p>
    </div>
}
else
{
    <div>
		<label style="padding: 0 0 -20px 0; font-weight: 600">Vanaf welk jaar moet het overzicht worden</label>
        <SfSlider 
			@bind-Value="@slidervalue"
            Min="@minslider" 
            Max="@maxslider" >

            <SliderTicks 
                Placement="Placement.After" 
                LargeStep="1">
            </SliderTicks>
        </SfSlider>
    </div>

    <div class="spacer-extralarge"></div>

    <div style="overflow-x:auto; min-width: 800px; padding-right: 10px; margin-top: 10px;">
        <SfGrid @ref="GridRef" 
            DataSource="@Zanggroepen" 
			AllowExcelExport="true" 
            AllowResizing="true"
            AllowPdfExport="true"
            AllowMultiSorting=true 
            AllowSorting=true >

			<GridEvents TValue="FestivalParticipationDynamicViewModel"
                DataBound="OnGridDataBound"
                OnActionComplete="OnGridActionComplete" />
 
            <SfToolbar>
	            <ToolbarItems>
		            <ToolbarItem Type="ItemType.Button">
			            <Template>
				            <button class="custom-toolbar-btn" @onclick="ExportToExcel" title="Exporteer naar een Excel bestand">
					            <img src="icons/excel.svg" class="icon" alt="Excel"/>
				            </button>
			            </Template>
		            </ToolbarItem>

		            <ToolbarItem Type="ItemType.Button">
			            <Template>
				            <button class="custom-toolbar-btn" @onclick="ExportToCsv" title="Exporteer naar een CSV bestand">
					            <img src="icons/csv.svg" class="icon" alt="CSV" />
				            </button>
			            </Template>
		            </ToolbarItem>

		            <ToolbarItem Type="ItemType.Button">
			            <Template>
				            <button class="custom-toolbar-btn" @onclick="ExportToPdf" title="Maak een PDF bestand">
					            <img src="icons/pdf.svg" class="icon" alt="PDF" />
				            </button>
			            </Template>
		            </ToolbarItem>


		            <ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
			            <Template>
				            <span class="toolbar-count">Groepen: @VisibleRowCount</span>
			            </Template>
		            </ToolbarItem>

		            <ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
			            <Template>
				            <SfTextBox Placeholder="Zoek" Input="OnInput"></SfTextBox>
			            </Template>
		            </ToolbarItem>
	            </ToolbarItems>
            </SfToolbar>
            
            <GridColumns>
                <GridColumn Field="Naam" HeaderText="Naam" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" />
                <GridColumn Field="Stad" HeaderText="Stad" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" />
                <GridColumn Field="Aangemaakt" HeaderText="Aangemaakt" Format="dd-MM-yyyy" Width="100" TextAlign="TextAlign.Center" AllowSorting=false AllowResizing="true" />

                @foreach ( var jaar in VisibleYearCollumns )
                {
                    <GridColumn HeaderText="@jaar.ToString()" Width="80" TextAlign="TextAlign.Center" AllowSorting=false AllowResizing="true">
                        <Template Context="data">
                            @{
                                var typedData = data as FestivalParticipationDynamicViewModel;
                                var datum = typedData?.DeelnamePerJaar.TryGetValue(jaar, out var value) == true
                                        ? value
                                        : null;
                            }

                            @if ( !string.IsNullOrWhiteSpace( datum ) )
                            {
                                <span>@datum</span>
                            }
                            else
                            {
                                <span style="color: gray;"></span>
                            }
                        </Template>
                    </GridColumn>
                }
            </GridColumns>
        </SfGrid>
    </div>
}

@code {
    private int CurrentFestivalYear;
    private int maxslider;
    private int minslider;
    private string FileName = "Groepen";
    private SfGrid<FestivalParticipationDynamicViewModel> GridRef;
    private bool FilterOutOldGroups = false;
    private bool IsLoading = false;
    private int VisibleRowCount = 0;
    private List<FestivalParticipationDynamicViewModel> Zanggroepen = [];
    private List<int> YearColumns = [];

    private int FilterOnFestival;

    // For the selectable display of the Number of columns
    private int _showNumberOfYears = 10;

    private List<int> VisibleYearCollumns => YearColumns
        .TakeLast( ShowNumberOfYears == int.MaxValue ? YearColumns.Count : ShowNumberOfYears )
        .ToList();

    private int ShowNumberOfYears
    {
        get => _showNumberOfYears;
        set
        {
            if ( _showNumberOfYears != value )
            {
                _showNumberOfYears = value;
                StateHasChanged();
            }
        }
    }

    private int _slidervalue;
    private int slidervalue
    {
        get => _slidervalue;
        set
        {
            if ( _slidervalue != value )
            {
                _slidervalue = value;
                ShowNumberOfYears = maxslider - _slidervalue + 1;

                _ = LoadDataAsync();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        CurrentFestivalYear = await RegistrationService.GetCurrentFestivalYearAsync();
        maxslider = CurrentFestivalYear;
        minslider = maxslider - 15;
        slidervalue = maxslider - 10;

        FilterOnFestival = await RegistrationService.GetCurrentFestivalYearAsync() - 3; // This value should be equal to NumberOfYearsForExclusion in QueryDefinitions.GetFestivalOverviewQuery

        await LoadDataAsync();    
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        StateHasChanged();
        Zanggroepen = await RegistrationService.GetRegistrationdPerFestivalAsync(filterOutOldGroups: FilterOutOldGroups);

        YearColumns = Zanggroepen
            .SelectMany( z => z.DeelnamePerJaar.Keys )
            .Union( Enumerable.Range( minslider, maxslider - minslider + 1 ) )
            .Distinct()
            .OrderBy( y => y )
            .ToList();

        //Filter only rows with year values
        var zichtbareJaren = VisibleYearCollumns;
        Zanggroepen = Zanggroepen
            .Where( z => z.DeelnamePerJaar
                .Any( d => zichtbareJaren.Contains( d.Key ) && !string.IsNullOrWhiteSpace( d.Value ) ) )
            .ToList();

        IsLoading = false;

        if ( GridRef is not null )
        {
            await GridRef.Refresh();
        }
    }

    private async Task OnFilterChanged( bool value )
    {
        FilterOutOldGroups = value;
        await LoadDataAsync();
    }

    // Manage direct search functionality
    public async void OnInput( InputEventArgs args )
    {
        await GridRef.SearchAsync( args.Value );

        await Task.Delay( 50 );
        await UpdateVisibleRowCountAsync();
    }

    // Export functions
    private async Task ExportToExcel()
    {
        var exportProps = new ExcelExportProperties
        {
            FileName = $"{FileName}-{DateTime.Now:yyyyMMdd}-{DateTime.Now:HHmm}.xlsx"
        };

        await GridRef!.ExportToExcelAsync( exportProps );
    }

    private async Task ExportToCsv()
    {
        var exportProps = new ExcelExportProperties
        {
            FileName = $"{FileName}-{DateTime.Now:yyyyMMdd}-{DateTime.Now:HHmm}.csv"
        };

        await GridRef!.ExportToCsvAsync( exportProps );
    }

    private async Task ExportToPdf()
    {
        var exportProps = new PdfExportProperties
        {
            FileName = $"{FileName}-{DateTime.Now:yyyyMMdd}-{DateTime.Now:HHmm}.pdf",
            PageOrientation = PageOrientation.Landscape,
            PageSize=PdfPageSize.A4,
            AllowHorizontalOverflow = true
        };
        await GridRef!.ExportToPdfAsync( exportProps );
    }

    private async Task OnSliderChanged( double newValue )
    {
        slidervalue = ( int ) newValue;
        ShowNumberOfYears = maxslider - (int)newValue + 1;
        StateHasChanged();
    }

    private async Task OnGridDataBound()
    {
        await UpdateVisibleRowCountAsync();
    }

    private async Task OnGridActionComplete( ActionEventArgs<FestivalParticipationDynamicViewModel> args )
    {
        if ( args.RequestType == Syncfusion.Blazor.Grids.Action.Refresh ||
        args.RequestType == Syncfusion.Blazor.Grids.Action.Filtering ||
        args.RequestType == Syncfusion.Blazor.Grids.Action.Paging ||
        args.RequestType == Syncfusion.Blazor.Grids.Action.Sorting )
        {
            await UpdateVisibleRowCountAsync();
		}
	}

    private async Task UpdateVisibleRowCountAsync()
    {
        var records = await GridRef.GetCurrentViewRecordsAsync();
        VisibleRowCount = records?.Count ?? 0;
        StateHasChanged();
    }
}