@page "/List-StageTypes"
@using Amusing.Models
@using Amusing.Services
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations

@inherits ListStageTypes;

<h3>Podium types</h3>
@if (IsLoading)
{
    <div class="text-center p-2">
        <SfSpinner CssClass="e-spin-center" />
        <p>@FileName worden geladen...</p>
    </div>
}
else
{
    <div class="spacer-small"></div>
    <div style="overflow-x:auto; min-width: 800px; padding-right: 10px; margin-top: 10px;">
        <SfGrid @ref="GridRef"
                TValue="StageTypeModel"
                DataSource="@StageTypes"
                AllowExcelExport="true" Width="100%"
                AllowResizing="true"
                AllowMultiSorting="true"
                AllowSorting="true">

            <GridEvents TValue="StageTypeModel"
                        DataBound="OnGridDataBound" />

            <SfToolbar>
                <ToolbarItems>
                    <ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
                        <Template>
                            <span class="toolbar-count">@FileName: @VisibleRowCount</span>
                        </Template>
                    </ToolbarItem>

                    <ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
                        <Template>
                            <SfTextBox Placeholder="Zoek" Input="OnInput"></SfTextBox>
                        </Template>
                    </ToolbarItem>
                </ToolbarItems>
            </SfToolbar>

            <GridColumns>
                <GridColumn Field="Type" HeaderText="Type" TextAlign="TextAlign.Center" AllowSorting=true AllowResizing="true" Width="60px" />
                <GridColumn Field="Price" HeaderText="Prijs" TextAlign="TextAlign.Right" AllowSorting=true AllowResizing="true" Width="80px" />
                <GridColumn Field="Description" HeaderText="Omschrijving" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" />
            </GridColumns>
        </SfGrid>
    </div>
}


