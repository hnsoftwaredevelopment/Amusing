@page "/Maintenance-StageTypes"
@using Amusing.Models
@using Amusing.Services
@using Bit.BlazorUI
@using Bit.BlazorUI.Extras
@using Blazorise
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DataForm
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations

<h3>Onderhoud Podium types</h3>
@if (IsLoading)
{
    <div class="text-center p-2">
        <SfSpinner CssClass="e-spin-center" />
        <p>@FileName worden geladen...</p>
    </div>
}
else
{
    <div class="page-container maintenance-page">
        <div class="fixed-header maintenance-page__header">
            <div class="form-grid">
                <h5>Algemeen</h5>
                <div class="form-row-1">
                    <SfTextBox @bind-Value="StageTypeName" Placeholder="Type" FloatLabelType="FloatLabelType.Always" CssClass="e-ntstyle center-textbox" Enabled=@ActiveChecked class="col-span-1" />
                    <SfNumericTextBox TValue="decimal" @bind-Value="StageTypePrice" Placeholder="Prijs" Format="c2" FloatLabelType="FloatLabelType.Always" Step="5" CssClass="e-ntstyle" Enabled=@ActiveChecked class="col-span-1" />
                    <SfMultiSelect TValue="List<string>"
                                    TItem="string"
                                    Placeholder="Compatibel met"
                                    FloatLabelType="FloatLabelType.Always"
                                    @bind-Value="CompatibelTypes"
                                    DataSource="@AvailableStageTypes"
                                    Mode="VisualMode.CheckBox"
                                    CssClass="e-ntstyle"
                                    Enabled=@ActiveChecked
                                   class="col-span-1">
                    </SfMultiSelect>
                    <BitToggleButton @bind-IsChecked="ActiveChecked" Text="@(ActiveChecked ? "Aktief" : "Niet aktief")" Styles="@(new() { Root = "--toggle-background: gray; background: var(--toggle-background); border: none",
                        Checked = "--toggle-background: green;",
                                         Text = "color: white;"
                                     })" class="col-span-1" />
                </div>
                <hr />
                <h5>Instrumenten e.d</h5>
                <div class="form-row-2">
                    <SfNumericTextBox TValue="int" Min="0" Max="2" @bind-Value="StageTypePiano" Placeholder="Piano" FloatLabelType="@FloatLabelType.Auto" CssClass="e-ntstyle" Enabled=@ActiveChecked class ="col-span-1" />
                    <SfNumericTextBox TValue="int" Min="0" Max="10" @bind-Value="StageTypeLectern" Placeholder="Lessenaar" FloatLabelType="FloatLabelType.Always" CssClass="e-ntstyle" Enabled=@ActiveChecked class="col-span-1" />
                    <SfNumericTextBox TValue="int" Min="0" Max="10" @bind-Value="StageTypeMicrophones" Placeholder="Microfoons" FloatLabelType="FloatLabelType.Always" CssClass="e-ntstyle" Enabled=@ActiveChecked class="col-span-1" />
                    <SfNumericTextBox TValue="int" Min="0" Max="2" @bind-Value="StageTypeDrums" Placeholder="Drums" FloatLabelType="FloatLabelType.Always" CssClass="e-ntstyle" Enabled=@ActiveChecked class="col-span-1" />
                </div>
                <hr />
                <h5>Techniek</h5>
                <div class="form-row-4">
                    <SfNumericTextBox TValue="int" Min="0" Max="6" @bind-Value="StageTypeGuitarAmplifiers" Placeholder="Gitaar versterkers" FloatLabelType="FloatLabelType.Always" CssClass="e-ntstyle" Enabled=@ActiveChecked class="col-span-1" />
                    <SfNumericTextBox TValue="int" Min="0" Max="6" @bind-Value="StageTypeBassAmplifiers" Placeholder="Bas versterkers" FloatLabelType="FloatLabelType.Always" CssClass="e-ntstyle" Enabled=@ActiveChecked class="col-span-1" />
                    <SfNumericTextBox TValue="int" Min="0" Max="6" @bind-Value="StageTypeChoirAmplifiers" Placeholder="Koor versterking" FloatLabelType="FloatLabelType.Always" CssClass="e-ntstyle" Enabled=@ActiveChecked class="col-span-1" />
                    <SfNumericTextBox TValue="int" Min="0" Max="4" @bind-Value="StageTypeMonitors" Placeholder="Monitoren" FloatLabelType="FloatLabelType.Always" CssClass="e-ntstyle" Enabled=@ActiveChecked class="col-span-1" />
                    <SfNumericTextBox TValue="int" Min="0" Max="4" @bind-Value="StageTypeSpeakers" Placeholder="Speakers" FloatLabelType="FloatLabelType.Always" CssClass="e-ntstyle" Enabled=@ActiveChecked class="col-span-1" />
                </div>
                <div class="spacer-medium"></div>
                <div class="form-row-3">
                    <SfCheckBox @bind-Checked="ElectronicsChecked" Disabled="!ActiveChecked">Electra</SfCheckBox>
                    <SfCheckBox @bind-Checked="MixingConsoleChecked" Disabled="!ActiveChecked">Mengpaneel</SfCheckBox>
                    <SfCheckBox @bind-Checked="Mp3Checked" Disabled="!ActiveChecked">MD/MP3</SfCheckBox>
                </div>
                <hr />
            </div>
        </div>

        <div class="scrollable-content maintenance-page__content">
            <div class="spacer-medium"></div>
            <div class="maintenance-grid-shell maintenance-grid-shell--fit">
                <SfGrid @ref="GridRef"
                        TValue="StageTypeModel"
                        DataSource="@StageTypes"
                        CssClass="maintenance-grid"
                        EnableStickyHeader="true"
                        Height="100%"
                        AllowResizing="true"
                        AllowMultiSorting="true"
                        AllowSelection="true"
                        AllowSorting="true" >

                    <GridTextWrapSettings WrapMode=" WrapMode.Header"></GridTextWrapSettings>
                    <GridSelectionSettings
                        Mode="Syncfusion.Blazor.Grids.SelectionMode.Row"
                        Type="Syncfusion.Blazor.Grids.SelectionType.Single">
                    </GridSelectionSettings>

                    <GridEvents TValue="StageTypeModel" DataBound="OnGridDataBound" RowSelected="OnRowSelected" />

                    <SfToolbar>
                        <ToolbarItems>
                            <ToolbarItem Type="ItemType.Button">
                                <Template>
                                    <button class="custom-toolbar-btn" @onclick="SaveStageType" title="Sla het podiumtype als nieuwe, of ge-(in)activeerde versie">
                                        <img src="icons/button-save.svg" class="icon" alt="SAVE" />
                                    </button>
                                </Template>
                            </ToolbarItem>
                            <ToolbarItem Type="ItemType.Button">
                                <Template>
                                    <button class="custom-toolbar-btn" @onclick="AddNewStageType" title="Voeg een nieuw podium type toe">
                                        <img src="icons/button-add.svg" class="icon" alt="ADD" />
                                    </button>
                                </Template>
                            </ToolbarItem>
                            <ToolbarItem Type="ItemType.Button">
                                <Template>
                                    <button class="custom-toolbar-btn" @onclick="DeleteStageTypeClicked" title="Verwijder geselecteerde podium type (versie)">
                                        <img src="icons/button-del.svg" class="icon" alt="DEL" />
                                    </button>
                                </Template>
                            </ToolbarItem>
                            <ToolbarItem Type="ItemType.Input" Align="ItemAlign.Center">
                                <Template>
                                    <span class="toolbar-count">@FileName: @VisibleRowCount</span>
                                </Template>
                            </ToolbarItem>

                            <ToolbarItem Type="ItemType.Input" Align="Syncfusion.Blazor.Navigations.ItemAlign.Right">
                                <Template>
                                    <SfTextBox Placeholder="Zoek" Input="OnInput"></SfTextBox>
                                </Template>
                            </ToolbarItem>
                        </ToolbarItems>
                    </SfToolbar>

                    <GridColumns>
                        <GridColumn Field="Type" HeaderText="Type" TextAlign="TextAlign.Center" AllowSorting=true AllowResizing="true" Width="60px" />
                        <GridColumn Field="Description" HeaderText="Omvat" TextAlign="TextAlign.Left" AllowSorting=true AllowResizing="true" />
                        <GridColumn Field="Price" HeaderText="Prijs" Format="C2" TextAlign="TextAlign.Center" AllowSorting=true AllowResizing="true" Width="90px" />
                        <GridColumn Field="Compatibel" HeaderText="Compatibel met" TextAlign="TextAlign.Left" AllowSorting=false AllowResizing="true" Width="135px" />
                        <GridColumn Field="Active" HeaderText="Aktief" TextAlign="TextAlign.Center" Width="120px">
                            <Template>
                                @{
                                    var stage = (context as StageTypeModel);
                                    var activeState = StageTypeActive == 1 ? "Aktief" : "Niet aktief";
                                    var activeStateColor = StageTypeActive == 1 ? "e-success" : "e-danger";
                                    <div class="template_checkbox">
                                        <SfChip id="chip">
                                            <ChipItems>
                                                <ChipItem Text="@activeState" CssClass="@($"{activeStateColor} custom-chip")" Width="120px"/>
                                            </ChipItems>
                                        </SfChip>
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
                <div class="spacer-small" />
                <BitMessage Color="BitColor.Secondary" Visibility="@ShowDeletedMessage">
                    <div>Let op: wanneer je een podium type verwijdert, verwijder je alleen de laatste versie van dat type.</div>
                    <div>De regel kan dus gewoon zichtbaar blijven in de lijst, dit is dan de vorige versie.</div>
                    <div>Wil je een podium type niet meer gebruiken, zet hem dan op disabled en sla het type op.</div>
                </BitMessage>
            </div>
        </div>
    </div>
}
