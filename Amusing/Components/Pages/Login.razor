@page "/login"
@using Amusing.Services
@using Amusing.Helpers
@inject NavigationManager Navigation
@inject CustomAuthenticationService AuthService
@inject CustomAuthStateProvider AuthStateProvider
@inject IHttpContextAccessor HttpContextAccessor
@inject LoggingService LoggingService
@inject UserContextHelper UserContextHelper
@inject Blazored.SessionStorage.ISessionStorageService _sessionStorage

<h3>Login</h3>

<EditForm Model="loginModel" OnValidSubmit="HandleLogin">
    <div class="mb-3" style="max-width: 300px;">
        <InputText @bind-Value="loginModel.Username" placeholder="Gebruikersnaam" class="form-control" />
    </div>
    <div class="mb-3" style="max-width: 300px;">
        <InputText @bind-Value="loginModel.Password" placeholder="Wachtwoord" type="password" class="form-control" />
    </div>
    <button class="btn btn-primary" type="submit">Inloggen</button>
</EditForm>

@if ( !string.IsNullOrEmpty( ErrorMessage ) )
{
    <p class="text-danger">@ErrorMessage</p>
}

@code
{
    private LoginModel loginModel = new();
    private string ErrorMessage = "";

    private async Task HandleLogin()
    {
        string _report = "";
        string _status = "failed";

        var user = await AuthService.ValidateUserAsync(loginModel.Username, loginModel.Password);

        if ( user != null )
        {
            // Save in SessionStorage
            await _sessionStorage.SetItemAsync( "UserId", user.UserId );
            await _sessionStorage.SetItemAsync( "Username", user.Username );
            await _sessionStorage.SetItemAsync( "UserRole", user.Role );

            //await _sessionStorage.SetItemAsync( "loggedUser", user );
            
            // Update authentication state (claims)
            await AuthStateProvider.MarkUserAsAuthenticated( user );

            // Update helper cache for immediate access
            UserContextHelper.SetUserContext( user.UserId, user.Username );

            // Log success
            _report = $"{user.Username} is succesvol ingelogd";
            _status = "success";

            // Redirect
            Navigation.NavigateTo( $"/signin?username={user.Username}&role={user.Role}&userid={user.UserId}", true );
        }
        else
        {
            ErrorMessage = "Ongeldige gebruikersnaam of wachtwoord";
            _report = $"Toegang geweigerd voor {loginModel.Username}";
        }

        await LoggingService.WriteUserLoginAttemptAsync ( _status, _report);
    }

    private class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
