@page "/login"

@inject Amusing.Services.BeheerPasswordRecoveryService Recovery
<h3>Login</h3>
@if(PasswordStatus=="changed"){<p role="status" class="text-success">Uw wachtwoord is gewijzigd. Log in met uw nieuwe wachtwoord.</p>}

<form id="beheer-login-form" method="post" action="/signin">
    <div class="mb-3" style="max-width: 300px;">
        <input name="username" placeholder="Gebruikersnaam" aria-label="Gebruikersnaam" class="form-control"
               autocomplete="username" required maxlength="100" />
    </div>
    <div class="mb-3 login-password-field">
        <input name="password" placeholder="Wachtwoord" aria-label="Wachtwoord" type="@(IsPasswordVisible ? "text" : "password")"
               class="form-control login-password-field__input" autocomplete="current-password" required />
        <button class="login-password-field__toggle" type="button" title="@PasswordToggleTitle" aria-label="@PasswordToggleTitle"
                @onclick="() => IsPasswordVisible = !IsPasswordVisible">
            <span class="@(IsPasswordVisible ? "fa-solid fa-eye-slash" : "fa-solid fa-eye")" aria-hidden="true"></span>
        </button>
    </div>
    <button class="btn btn-primary" type="submit">Inloggen</button>
</form>

@if(Recovery.Enabled){<p><a href="/wachtwoord-vergeten" target="_top">Wachtwoord vergeten?</a></p>}

@if (Failed == "1")
{
    <p class="text-danger" role="alert">Ongeldige gebruikersnaam of wachtwoord</p>
}

@code {
    [SupplyParameterFromQuery(Name = "failed")] public string? Failed { get; set; }
    [SupplyParameterFromQuery(Name="password")] public string? PasswordStatus{get;set;}
    private bool IsPasswordVisible;
    private string PasswordToggleTitle => IsPasswordVisible ? "Wachtwoord verbergen" : "Wachtwoord tonen";
}
