@page "/login"
@using Amusing.Services
@inject NavigationManager Navigation
@inject CustomAuthenticationService AuthService
@inject CustomAuthStateProvider AuthStateProvider

<h3>Login</h3>

<EditForm Model="loginModel" OnValidSubmit="HandleLogin">
    <div class="mb-3" style="max-width: 300px;">
        <InputText @bind-Value="loginModel.Username" placeholder="Gebruikersnaam" class="form-control" />
    </div>
    <div class="mb-3" style="max-width: 300px;">
        <InputText @bind-Value="loginModel.Password" placeholder="Wachtwoord" type="password" class="form-control" />
    </div>
    <button class="btn btn-primary" type="submit">Inloggen</button>
</EditForm>

@if ( !string.IsNullOrEmpty( ErrorMessage ) )
{
    <p class="text-danger">@ErrorMessage</p>
}

@code
{
    private LoginModel loginModel = new();
    private string ErrorMessage = "";

    private async Task HandleLogin()
    {
        var user = await AuthService.ValidateUserAsync(loginModel.Username, loginModel.Password);
        if ( user != null )
        {
            await AuthStateProvider.MarkUserAsAuthenticated( user );
            //Navigation.NavigateTo( "/" );
            Navigation.NavigateTo( $"/signin?username={user.Username}&role={user.Role}&userid={user.UserId}", true );
        }
        else
        {
            ErrorMessage = "Ongeldige gebruikersnaam of wachtwoord";
        }
    }

    private class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
